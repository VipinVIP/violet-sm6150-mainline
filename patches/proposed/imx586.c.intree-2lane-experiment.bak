#include <linux/unaligned.h>

#include <linux/clk.h>
#include <linux/delay.h>
#include <linux/i2c.h>
#include <linux/gpio.h>
#include <linux/gpio/driver.h>
#include <linux/module.h>
#include <linux/pm_runtime.h>
#include <linux/regulator/consumer.h>

#include <media/v4l2-ctrls.h>
#include <media/v4l2-fwnode.h>
#include <media/v4l2-subdev.h>

/* Streaming Mode */
#define IMX586_REG_MODE_SELECT	0x3000
#define IMX586_MODE_STANDBY	0x01
#define IMX586_MODE_STREAMING	0x00

/* Lines per frame */
#define IMX586_REG_LPFR		0x0340

/* Chip ID */
#define IMX586_REG_ID		0x0016
static int use_binned;
module_param(use_binned, int, 0644);

#define IMX586_ID		0x0586

/* Exposure control */
#define IMX586_REG_EXPOSURE_CIT	0x0202
#define IMX586_EXPOSURE_MIN	8
#define IMX586_EXPOSURE_OFFSET	22
#define IMX586_EXPOSURE_STEP	1
#define IMX586_EXPOSURE_DEFAULT	0x0648

/* Analog gain control */
#define IMX586_REG_AGAIN	0x0204
#define IMX586_AGAIN_MIN	0
#define IMX586_AGAIN_MAX	978
#define IMX586_AGAIN_STEP	1
#define IMX586_AGAIN_DEFAULT	0

/* Group hold register */
#define IMX586_REG_HOLD		0x0104

/* Input clock rate */
#define IMX586_INCLK_RATE	24000000

/* CSI2 HW configuration */
#define IMX586_LINK_FREQ	891000000
#define IMX586_NUM_DATA_LANES	2

#define IMX586_REG_MIN		0x00
#define IMX586_REG_MAX		0xffff

/**
 * struct imx586_reg - imx586 sensor register
 * @address: Register address
 * @val: Register value
 */
struct imx586_reg {
	u16 address;
	u8 val;
};

/**
 * struct imx586_reg_list - imx586 sensor register list
 * @num_of_regs: Number of registers in the list
 * @regs: Pointer to register list
 */
struct imx586_reg_list {
	u32 num_of_regs;
	const struct imx586_reg *regs;
};

/**
 * struct imx586_mode - imx586 sensor mode structure
 * @width: Frame width
 * @height: Frame height
 * @code: Format code
 * @hblank: Horizontal blanking in lines
 * @vblank: Vertical blanking in lines
 * @vblank_min: Minimum vertical blanking in lines
 * @vblank_max: Maximum vertical blanking in lines
 * @pclk: Sensor pixel clock
 * @link_freq_idx: Link frequency index
 * @reg_list: Register list for sensor mode
 */
struct imx586_mode {
	u32 width;
	u32 height;
	u32 code;
	u32 hblank;
	u32 vblank;
	u32 vblank_min;
	u32 vblank_max;
	u64 pclk;
	u32 link_freq_idx;
	struct imx586_reg_list reg_list;
};

static const char * const imx586_supply_names[] = {
	"dovdd",	/* Digital I/O power */
	"avdd",		/* Analog power */
	"dvdd",		/* Digital core power */
};

/**
 * struct imx586 - imx586 sensor device structure
 * @dev: Pointer to generic device
 * @client: Pointer to i2c client
 * @sd: V4L2 sub-device
 * @pad: Media pad. Only one pad supported
 * @reset_gpio: Sensor reset gpio
 * @inclk: Sensor input clock
 * @supplies: Regulator supplies
 * @ctrl_handler: V4L2 control handler
 * @link_freq_ctrl: Pointer to link frequency control
 * @pclk_ctrl: Pointer to pixel clock control
 * @hblank_ctrl: Pointer to horizontal blanking control
 * @vblank_ctrl: Pointer to vertical blanking control
 * @exp_ctrl: Pointer to exposure control
 * @again_ctrl: Pointer to analog gain control
 * @vblank: Vertical blanking in lines
 * @cur_mode: Pointer to current selected sensor mode
 * @mutex: Mutex for serializing sensor controls
 */
struct imx586 {
	struct device *dev;
	struct i2c_client *client;
	struct v4l2_subdev sd;
	struct media_pad pad;
	struct gpio_desc *reset_gpio;
	struct gpio_desc *aux_gpio;
	struct clk *inclk;
	struct regulator_bulk_data supplies[ARRAY_SIZE(imx586_supply_names)];
	struct v4l2_ctrl_handler ctrl_handler;
	struct v4l2_ctrl *link_freq_ctrl;
	struct v4l2_ctrl *pclk_ctrl;
	struct v4l2_ctrl *hblank_ctrl;
	struct v4l2_ctrl *vblank_ctrl;
	struct {
		struct v4l2_ctrl *exp_ctrl;
		struct v4l2_ctrl *again_ctrl;
	};
	u32 vblank;
	const struct imx586_mode *cur_mode;
	struct mutex mutex;
};

static const s64 link_freq[] = {
	IMX586_LINK_FREQ,
};

