From: VipinVIP <VipinVIP@users.noreply.github.com>
Subject: [PATCH] drm/panel: novatek-nt36672e: add the NT36672A shenchao variant (Redmi Note 7 Pro)

Init sequence transcribed from the vendor panel DTS (38 DCS writes). Wired in the board
DTS (video burst + LPM mode flags).
---
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672e.c
@@ -480,6 +480,80 @@
 	.flags = 0,
 };
 
+
+/*
+ * Xiaomi Redmi Note 7 Pro (violet) -- Novatek NT36672A, "shenchao" variant.
+ * Init sequence transcribed 1:1 from violet's vendor panel DTS; the vendor
+ * encodes packets as [dt last vc ack wait_ms dlen_hi dlen_lo payload...].
+ */
+static void nt36672a_shenchao_1080x2340_60hz_init(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x23);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x07, 0x20);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x08, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x09, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x25);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x18, 0x96);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x05, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x27);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xd9, 0x10);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x24);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x82, 0x13);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x84, 0x31);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x88, 0x13);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x8a, 0x31);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x8e, 0xe4);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x8f, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x90, 0x80);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9d, 0xb0);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x26);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xa9, 0x12);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xaa, 0x10);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xae, 0x8a);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x1c, 0xfa);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x10);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x51, 0xb8);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x68, 0x06, 0x04);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x53, 0x2c);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x55, 0x00);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x29);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x11);
+	mipi_dsi_msleep(ctx, 70);
+}
+
+static const struct drm_display_mode nt36672a_shenchao_1080x2340_60hz = {
+	.clock = 183257,
+
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 90,
+	.hsync_end = 1080 + 90 + 2,
+	.htotal = 1080 + 90 + 2 + 120,
+
+	.vdisplay = 2340,
+	.vsync_start = 2340 + 13,
+	.vsync_end = 2340 + 13 + 3,
+	.vtotal = 2340 + 13 + 3 + 8,
+
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static const struct panel_desc nt36672a_shenchao_panel_desc = {
+	.display_mode = &nt36672a_shenchao_1080x2340_60hz,
+	.width_mm = 67,
+	.height_mm = 145,
+	/* vendor: burst mode, force-clock-lane-hs (continuous clock), LP commands */
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 4,
+	.panel_name = "nt36672a video mode dsi shenchao panel",
+	.init_sequence = nt36672a_shenchao_1080x2340_60hz_init,
+};
 static const struct panel_desc nt36672e_panel_desc = {
 	.display_mode = &nt36672e_1080x2408_60hz,
 	.width_mm = 74,
@@ -589,6 +663,10 @@
 		.compatible = "novatek,nt36672e",
 		.data = &nt36672e_panel_desc,
 	},
+	{
+		.compatible = "novatek,nt36672a-shenchao",
+		.data = &nt36672a_shenchao_panel_desc,
+	},
 	{ }
 };
 MODULE_DEVICE_TABLE(of, nt36672e_of_match);
