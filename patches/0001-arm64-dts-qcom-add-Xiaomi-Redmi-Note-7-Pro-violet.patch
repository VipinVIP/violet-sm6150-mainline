From: VipinVIP <VipinVIP@users.noreply.github.com>
Subject: [PATCH] arm64: dts: qcom: add Xiaomi Redmi Note 7 Pro (violet)

Board description for violet (SM6150/talos): memory map incl. ramoops, console, eMMC,
USB peripheral, GPU (Adreno 612 incl. zap shader name) and the TrustZone/xPU quirks
(aggre1_noc without clocks so no QoS programming, first four TLMM pins reserved,
scm bandwidth vote path).  Display (DSI0 + NT36672A panel, WLED backlight; AVDD/AVEE modelled as fixed always-on supplies) is wired.
---
--- a/arch/arm64/boot/dts/qcom/violet-sm6150.dts
+++ b/arch/arm64/boot/dts/qcom/violet-sm6150.dts
@@ -0,0 +1,681 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi Note 7 Pro (violet)
+ *
+ * SM6150 / Snapdragon 675 — internal MSM codename "Talos", which is the name
+ * mainline uses for this SoC (shared with QCS615).  So the SoC description is
+ * arch/arm64/boot/dts/qcom/talos.dtsi and this file only has to describe the
+ * *board*.
+ *
+ * Status (mainline 7.2.10, booted via kexec from the downstream kernel):
+ *   [x] reserved memory (ramoops console, GPU PIL region)
+ *   [x] console on uart0, eMMC, USB peripheral (high-speed only, QUSB2 PHY)
+ *   [x] GPU: Adreno 612 renders (RGMU, zap shader), needs
+ *       msm.separate_gpu_kms=1 (keeps the GPU a separate DRM device)
+ *   [~] PMIC rails: values from the vendor tables, only consumers modelled
+ *   [x] display chain: DSI PHY + NT36672A "shenchao" panel + WLED probe, DSI-1 connected
+ *       1080x2340, fb0 present; actual picture unverified (panel is physically broken)
+ *   [ ] touchscreen, USB type-C, audio, camera, sensors, modem, wifi
+ *
+ * TZ/xPU quirks that shaped this file: the first four TLMM pins and the QoS
+ * registers of aggre1_noc hang the CPU when touched (see the notes at the
+ * bottom), and Linux must not enable the TZ SHM bridge on this SoC.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+#include "talos.dtsi"
+#include "pm6150.dtsi"
+#include "pm6150l.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Note 7 Pro";
+	compatible = "xiaomi,violet", "qcom,sm6150";
+	chassis-type = "handset";
+
+	/*
+	 * The bootloader supplies and fills RAM.  Two measured facts:
+	 *  - the vendor DTB that boots has a node named exactly "memory" (NO unit
+	 *    address) with a zero/placeholder size, and ABL fills it in.
+	 *  - mainline's talos.dtsi names it "memory@80000000" and comments
+	 *    "We expect the bootloader to fill in the size" -- the u-boot convention.
+	 * ABL looks the node up by NAME, so "memory@80000000" is not found and
+	 * neither is no node at all: both make it refuse the image.  Measured:
+	 *  - zero-size memory@80000000  -> refused
+	 *  - no memory node at all      -> refused
+	 * So use the vendor's exact name and let ABL fill it.
+	 */
+	/delete-node/ memory@80000000;
+
+	memory {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0>;
+	};
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &sdhc_1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * talos.dtsi references both of these; the board has to provide them.
+	 * The standard SM6150 pair, exactly as the QCS615 EVK declares them.
+	 */
+	clocks {
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board_clk: xo-board-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+};
+
+/*
+ * violet's OWN reserved-memory map.  The QCS615 EVK puts pil_gpu_mem at
+ * 0x97715000; violet's is at 0x97115000, so the SoC node has to be overridden
+ * (a wrong address here hands the zap/GPU region over to the allocator).
+ * The remaining remoteproc regions follow in later iterations.
+ */
+&{/reserved-memory} {
+	/delete-node/ pil-gpu@97715000;
+
+	ramoops: ramoops@a1600000 {
+		compatible = "ramoops";
+		reg = <0x0 0xa1600000 0x0 0x800000>;
+		console-size = <0x400000>;
+		pmsg-size = <0x400000>;
+	};
+
+	pil_gpu_mem: pil-gpu@97115000 {
+		reg = <0x0 0x97115000 0x0 0x2000>;
+		no-map;
+	};
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * Nodes this device's bootloader patches BY NAME.
+ *
+ * Qualcomm ABL edits the boot image's DTB on every boot: it fills the memory
+ * map, records "removed" memory, writes the Android firmware metadata and the
+ * imem fields.  Violet's vendor DTB -- the one ABL actually boots -- carries all
+ * of these; mainline's soc DTS does not.  Measured: with the arm64 header fully
+ * matched, __symbols__ present and a dtbo that applies cleanly, ABL still
+ * refuses our DTB, which is why the missing vendor nodes are the prime suspect.
+ *
+ * Names, compatible strings and addresses are copied verbatim from violet's own
+ * vendor DTB (read back off the device).  Regions that mainline's talos.dtsi
+ * already declares under a different name are left alone: an extra reservation
+ * costs a little RAM and is harmless, while a missing node ABL expects is fatal.
+ * ---------------------------------------------------------------------------
+ */
+&{/reserved-memory} {
+	hyp_region@85700000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85700000 0x0 0x600000>;
+	};
+
+	xbl_aop_mem@85e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85e00000 0x0 0x140000>;
+	};
+
+	sec_apps_region@85fff000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85fff000 0x0 0x1000>;
+	};
+
+	/* ABL keeps its "removed memory" record here; 45 MB, the largest gap */
+	removed_region@86200000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x86200000 0x0 0x2d00000>;
+	};
+
+	camera_region@8ab00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8ab00000 0x0 0x500000>;
+	};
+
+	modem_region@8b000000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8b000000 0x0 0x7e00000>;
+	};
+
+	video_region@92e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x92e00000 0x0 0x500000>;
+	};
+
+	wlan_msa_mem@93300000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x93300000 0x0 0x200000>;
+	};
+
+	cdsp_region@93500000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x93500000 0x0 0x1e00000>;
+	};
+
+	adsp_region@95300000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x95300000 0x0 0x1e00000>;
+	};
+
+	ipa_fw_region@97100000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x97100000 0x0 0x10000>;
+	};
+
+	ipa_gsi_region@97110000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x97110000 0x0 0x5000>;
+	};
+
+	qseecom_region@9e400000 {
+		compatible = "shared-dma-pool";
+		no-map;
+		reg = <0x0 0x9e400000 0x0 0x1400000>;
+	};
+
+	cdsp_sec_mem@9f800000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x9f800000 0x0 0x1e00000>;
+	};
+
+	cont_splash_region@9c000000 {
+		reg = <0x0 0x9c000000 0x0 0xf00000>;
+	};
+
+	dfps_data_region@9d000000 {
+		reg = <0x0 0x9d000000 0x0 0x100000>;
+	};
+
+	disp_rdump_region@9d100000 {
+		reg = <0x0 0x9d100000 0x0 0x1000000>;
+	};
+};
+
+/*
+ * imem: mainline declares sram@14680000; violet's is qcom,msm-imem@146aa000 and
+ * the vendor DTB exposes the sub-blocks ABL and the Android bootloader use
+ * (restart reason, boot stats, KASLR offset, the PIL/dload scratch areas).
+ */
+&soc {
+	qcom_msm_imem: imem@146aa000 {
+		compatible = "qcom,msm-imem";
+		/* mainline's /soc is 2 address + 2 size cells */
+		reg = <0x0 0x146aa000 0x0 0x1000>;
+		ranges = <0x0 0x0 0x146aa000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		imem_mem_dump_table: mem_dump_table@10 {
+			compatible = "qcom,msm-imem-mem_dump_table";
+			reg = <0x10 0x8>;
+		};
+
+		imem_restart_reason: restart_reason@65c {
+			compatible = "qcom,msm-imem-restart_reason";
+			reg = <0x65c 0x4>;
+		};
+
+		imem_dload_type: dload_type@1c {
+			compatible = "qcom,msm-imem-dload-type";
+			reg = <0x1c 0x4>;
+		};
+
+		imem_boot_stats: boot_stats@6b0 {
+			compatible = "qcom,msm-imem-boot_stats";
+			reg = <0x6b0 0x20>;
+		};
+
+		imem_kaslr_offset: kaslr_offset@6d0 {
+			compatible = "qcom,msm-imem-kaslr_offset";
+			reg = <0x6d0 0xc>;
+		};
+
+		imem_pil: pil@94c {
+			compatible = "qcom,msm-imem-pil";
+			reg = <0x94c 0xc8>;
+		};
+
+		imem_diag_dload: diag_dload@c8 {
+			compatible = "qcom,msm-imem-diag-dload";
+			reg = <0xc8 0xc8>;
+		};
+	};
+};
+
+/*
+ * ABL writes the Android firmware metadata into /firmware/android on every boot
+ * (the "boot_devices", vbmeta parts and fstab).  Violet's vendor DTB has it;
+ * mainline's does not.
+ */
+&{/firmware} {
+	android {
+		compatible = "android,firmware";
+
+		boot_devices = "soc/7c4000.sdhci";
+
+		vbmeta {
+			compatible = "android,vbmeta";
+			parts = "vbmeta,boot,recovery,system,vendor,dtbo";
+		};
+
+		fstab {
+			compatible = "android,fstab";
+
+			vendor {
+				compatible = "android,vendor";
+				dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
+				type = "ext4";
+				mnt_flags = "ro,barrier=1,discard";
+				fsmgr_flags = "wait,slotselect,avb";
+				status = "disabled";
+			};
+		};
+	};
+};
+
+/* the debug UART: serial@880000, matching violet's downstream earlycon */
+&uart0 {
+	status = "okay";
+};
+
+/*
+ * eMMC.  violet's vendor DT declares no vmmc/vddio for sdhc_1 at all -- the
+ * rails are left enabled by the bootloader -- and mainline treats those supplies
+ * as optional, so the node only needs turning on.
+ */
+&sdhc_1 {
+	status = "okay";
+};
+
+/*
+ * The Adreno 612.  Everything it needs is already in talos.dtsi (gpucc core
+ * clock, RPMHPD_CX, adreno_smmu, the mobile OPP table 845..290 MHz), so the
+ * board only has to turn it on.  Firmware to have in /lib/firmware:
+ *   a612_rgmu.bin, a630_sqe.fw  (mainline names, both installed already)
+ *   the signed zap -- the single-file .mbn form mainline requests is the
+ *   ROM's a612_zap.elf (already extracted from violet's own vendor image)
+ */
+&gpu {
+	status = "okay";
+};
+
+/*
+ * mainline requires the zap firmware name to come from the DT for new targets
+ * ("the firmware is signed with a (potentially) device specific key, having the
+ * name come from gpulist was a bad idea").  request_firmware_direct() uses this
+ * string verbatim -- no qcom/ fallback probing.
+ *
+ * Install the DEVICE-SIGNED single-file zap at /lib/firmware/qcom/a612_zap.mbn:
+ * that is the ROM's a612_zap.elf (14240 B).  Do NOT use the upstream
+ * linux-firmware qcs615 blob (14256 B) -- it is signed for a sibling part and
+ * TrustZone rejects it, which is measured behaviour on this device.
+ */
+&gpu_zap_shader {
+	firmware-name = "qcom/a612_zap.mdt";
+};
+
+/*
+ * RPMh regulators live under the applications RSC, not the SPMI bus.
+ * `qcom,pmic-id` is the PMIC's SPMI USID as a letter: pm6150 -> "a", pm6150l -> "e".
+ * Child node names must be the vreg resource names from
+ * qcom-rpmh-regulator.c (RPMH_VREG("ldo1", ...) etc.).
+ * Values below are violet's, from the vendor sm6150-regulator.dtsi.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm6150-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vreg_l1a_1p2: ldo1 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1252000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2a_1p0: ldo2 {
+			regulator-min-microvolt = <1000000>;
+			regulator-max-microvolt = <1050000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3a_1p0: ldo3 {
+			regulator-min-microvolt = <1000000>;
+			regulator-max-microvolt = <1060000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l4a_0p8: ldo4 {
+			regulator-min-microvolt = <875000>;
+			regulator-max-microvolt = <975000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5a_2p5: ldo5 {
+			regulator-min-microvolt = <2500000>;
+			regulator-max-microvolt = <2970000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l6a_0p6: ldo6 {
+			regulator-min-microvolt = <600000>;
+			regulator-max-microvolt = <650000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9a_0p4: ldo9 {
+			regulator-min-microvolt = <400000>;
+			regulator-max-microvolt = <728000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l10a_1p8: ldo10 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1829000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11a_1p8: ldo11 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1890000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l12a_1p8: ldo12 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1950000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l13a_1p8: ldo13 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l14a_1p8: ldo14 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1850000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l15a_1p8: ldo15 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l16a_2p4: ldo16 {
+			regulator-min-microvolt = <2430000>;
+			regulator-max-microvolt = <2970000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l17a_3p0: ldo17 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3230000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l18a_3p0: ldo18 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l19a_2p7: ldo19 {
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm6150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vreg_s1e_1p1: smps1 {
+			regulator-min-microvolt = <1128000>;
+			regulator-max-microvolt = <1128000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_s2e_0p3: smps2 {
+			regulator-min-microvolt = <348000>;
+			regulator-max-microvolt = <648000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_s8e_1p2: smps8 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1400000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l1e_1p8: ldo1 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2e_1p3: ldo2 {
+			regulator-min-microvolt = <1304000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3e_1p2: ldo3 {
+			regulator-min-microvolt = <1232000>;
+			regulator-max-microvolt = <1260000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l4e_1p6: ldo4 {
+			regulator-min-microvolt = <1650000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5e_1p6: ldo5 {
+			regulator-min-microvolt = <1650000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l6e_1p6: ldo6 {
+			regulator-min-microvolt = <1650000>;
+			regulator-max-microvolt = <3100000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* violet overrides this one: always-on, HPM */
+		vreg_l7e_3p0: ldo7 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
+		vreg_l8e_1p8: ldo8 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9e_2p9: ldo9 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l10e_3p2: ldo10 {
+			regulator-min-microvolt = <3200000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11e_2p9: ldo11 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_bob: bob {
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+/*
+ * USB (peripheral only).  violet wires the high-speed QUSB2 PHY alone: the vendor
+ * tree sets maximum-speed = "high-speed" and disables usb_qmp_phy.  Supplies are the
+ * vendor's: vdd = pm6150 L4, vdda18 = L11, vdda33 = L17.
+ */
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l4a_0p8>;
+	vdda-pll-supply = <&vreg_l11a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l17a_3p0>;
+
+	status = "okay";
+};
+
+&usb_1 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+/*
+ * Probing aggre1_noc hangs the CPU on its first QoS register write (kexec test, run 9-10:
+ * PROBE-START 1700000.interconnect never returns).  With no clocks the driver skips QoS
+ * programming (qos_requires_clocks), which is what we want: the bootloader/downstream
+ * already configured QoS, and Linux writes to these registers are not safe on this firmware.
+ */
+&aggre1_noc {
+	/delete-property/ clocks;
+};
+
+/* TZ-protected pins found by tlmm-bisect.sh (reads hang the CPU) */
+&tlmm {
+	gpio-reserved-ranges = <0 4>;
+};
+
+
+/*
+ * TrustZone PAS (zap shader) authentication needs a DDR bandwidth vote on behalf of the
+ * crypto engine: the downstream pil-tz does scm_pas_enable_bw() before PAS_INIT_IMAGE, and
+ * without it TZ returns 0xffcfffbb (-3145797) -> -EINVAL.  Mainline models that vote as the
+ * scm node's interconnect path.
+ */
+&{/firmware/scm} {
+	interconnects = <&aggre1_noc MASTER_CRYPTO QCOM_ICC_TAG_ALWAYS
+			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+};
+
+/*
+ * Display: DPU -> DSI0 (4 lanes, video mode) -> Novatek NT36672A "shenchao" panel.
+ *
+ * The panel's AVDD/AVEE come from the PM6150L LCDB (LAB/IBB), which mainline has no
+ * driver for; they are modelled as fixed always-on supplies and rely on the bootloader
+ * / the previous kernel having left them enabled.  Backlight is the PM6150L WLED.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l4a_0p8>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "novatek,nt36672a-shenchao";
+		reg = <0>;
+
+		vddi-supply = <&vreg_l13a_1p8>;
+		avdd-supply = <&panel_avdd>;
+		avee-supply = <&panel_avee>;
+
+		reset-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+		backlight = <&pm6150l_wled>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l4a_0p8>;
+
+	status = "okay";
+};
+
+&pm6150l_wled {
+	qcom,current-limit-microamp = <25000>;
+	qcom,cabc;
+
+	status = "okay";
+};
+
+/ {
+	panel_avdd: regulator-panel-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_avdd";
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+		regulator-always-on;
+	};
+
+	panel_avee: regulator-panel-avee {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_avee";
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+		regulator-always-on;
+	};
+};
