From: VipinVIP <VipinVIP@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi/phy: 14nm: use vcca as the supply name

The 14nm DSI PHY regulator supply is the 'vcca' rail on SM6150; the old 'vdda' name does not match the binding.
---
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_14nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_14nm.c
@@ -1029,7 +1029,7 @@
 };
 
 static const struct regulator_bulk_data dsi_phy_14nm_36mA_regulators[] = {
-	{ .supply = "vdda", .init_load_uA = 36000 },
+	{ .supply = "vcca", .init_load_uA = 36000 },
 };
 
 const struct msm_dsi_phy_cfg dsi_phy_14nm_cfgs = {
