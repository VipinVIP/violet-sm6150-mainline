pinctrl: qcom: lpass-lpi: checked vote clocks; add SM6150 (AP-owned pads 18-31)

- LPI_FLAG_CHECKED_CLOCKS: manage vote clocks with clk_bulk and fail runtime resume (-EAGAIN) when
  the DSP refuses the LPASS core vote; pm_clk_resume() ignores clk enable errors and the next
  register access then stalls the AP.
- pinctrl-sm6150-lpass-lpi: pads 0-17 of the 0x62b40000 LPI TLMM belong to the SSC (AP access
  stalls the CPU); controller starts at 0x62b52000, 14 pins = vendor gpio18..31. Table from the
  sm7150-mainline driver (same LPASS); functions match the Xiaomi violet vendor DT.

--- a/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
+++ b/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
@@ -37,6 +37,8 @@
 	struct mutex lock;
 	DECLARE_BITMAP(ever_gpio, MAX_NR_GPIO);
 	const struct lpi_pinctrl_variant_data *data;
+	struct clk_bulk_data *clks;
+	int num_clks;
 };
 
 static void __iomem *lpi_gpio_reg(struct lpi_pinctrl *state,
@@ -531,13 +533,20 @@
 					     "Slew resource not provided\n");
 	}
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = of_pm_clk_add_clks(dev);
-	if (ret < 0 && ret != -ENODEV)
-		return ret;
+	if (data->flags & LPI_FLAG_CHECKED_CLOCKS) {
+		pctrl->num_clks = devm_clk_bulk_get_all(dev, &pctrl->clks);
+		if (pctrl->num_clks < 0)
+			return dev_err_probe(dev, pctrl->num_clks,
+					     "failed to get vote clocks\n");
+	} else {
+		ret = devm_pm_clk_create(dev);
+		if (ret)
+			return ret;
+
+		ret = of_pm_clk_add_clks(dev);
+		if (ret < 0 && ret != -ENODEV)
+			return ret;
+	}
 
 	pm_runtime_set_autosuspend_delay(dev, 100);
 	pm_runtime_use_autosuspend(dev);
@@ -587,6 +596,42 @@
 }
 EXPORT_SYMBOL_GPL(lpi_pinctrl_probe);
 
+static int lpi_pinctrl_clk_runtime_suspend(struct device *dev)
+{
+	struct lpi_pinctrl *pctrl = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(pctrl->num_clks, pctrl->clks);
+
+	return 0;
+}
+
+static int lpi_pinctrl_clk_runtime_resume(struct device *dev)
+{
+	struct lpi_pinctrl *pctrl = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(pctrl->num_clks, pctrl->clks);
+	if (ret) {
+		/*
+		 * Without the LPASS core vote the LPI registers are not
+		 * reachable and an access stalls the AP. Refuse it; -EAGAIN
+		 * keeps runtime PM from latching the error, so a vote that
+		 * failed because the DSP was not up yet is retried later.
+		 */
+		dev_err_ratelimited(dev, "LPASS vote failed (%d), not touching LPI registers\n",
+				    ret);
+		return -EAGAIN;
+	}
+
+	return 0;
+}
+
+const struct dev_pm_ops lpi_pinctrl_checked_clk_pm_ops = {
+	RUNTIME_PM_OPS(lpi_pinctrl_clk_runtime_suspend,
+		       lpi_pinctrl_clk_runtime_resume, NULL)
+};
+EXPORT_SYMBOL_GPL(lpi_pinctrl_checked_clk_pm_ops);
+
 void lpi_pinctrl_remove(struct platform_device *pdev)
 {
 	struct lpi_pinctrl *pctrl = platform_get_drvdata(pdev);
