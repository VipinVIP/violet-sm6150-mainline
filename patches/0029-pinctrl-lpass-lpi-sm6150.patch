+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM6150 (talos) LPASS LPI pin controller.
+ *
+ * The LPI TLMM spans 32 pads at 0x62b40000 with a 0x1000 stride, but pads
+ * 0-17 (0x62b40000-0x62b51fff) belong to the sensor subsystem (SSC): an AP
+ * access there never completes and stalls the CPU (the 2026-10-26 and
+ * 2026-10-31 wedges - gpiochip registration reads every pad). The AP owns
+ * pads 18-31, so this controller starts at 0x62b52000 and its gpio0..13 are
+ * the vendor DT's gpio18..31, exactly as the sm7150-mainline port (same LPASS)
+ * does. Functions match the vendor (Xiaomi violet, msm-4.14) DT: tx_swr_clk
+ * vendor gpio18 func2, tx_swr_data 19 func3 / 20 func2, rx_swr_clk 21 func2,
+ * rx_swr_data 22-23 func2, WCD937x reset 24 (here gpio6).
+ *
+ * The registers are reachable only while the ADSP holds the LPASS core
+ * (MACRO) vote, so the vote clock is managed with LPI_FLAG_CHECKED_CLOCKS: a
+ * refused vote fails runtime resume instead of letting an access hang.
+ *
+ * Pin/function table from the sm7150-mainline sm7150-lpass-lpi driver.
+ */
+
+#include <linux/gpio/driver.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include "pinctrl-lpass-lpi.h"
+
+enum lpass_lpi_functions {
+	LPI_MUX_audio_ref,
+	LPI_MUX_cdc_pdm_rx,
+	LPI_MUX_dmic1_clk,
+	LPI_MUX_dmic1_data,
+	LPI_MUX_dmic2_clk,
+	LPI_MUX_dmic2_data,
+	LPI_MUX_qdss_cti,
+	LPI_MUX_gp_pdm,
+	LPI_MUX_prim_mclk_a,
+	LPI_MUX_prim_mclk_b,
+	LPI_MUX_qca_sb_clk,
+	LPI_MUX_qca_sb_data,
+	LPI_MUX_qua_mi2s_data,
+	LPI_MUX_qua_mi2s_sclk,
+	LPI_MUX_qua_mi2s_ws,
+	LPI_MUX_slimbus_clk,
+	LPI_MUX_slimbus_data,
+	LPI_MUX_swr_rx_clk,
+	LPI_MUX_swr_rx_data,
+	LPI_MUX_swr_tx_clk,
+	LPI_MUX_swr_tx_data,
+	LPI_MUX_gpio,
+	LPI_MUX__,
+};
