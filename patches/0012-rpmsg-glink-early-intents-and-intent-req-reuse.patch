rpmsg: glink: install the endpoint before the reciprocal OPEN, advertise base intents early, reuse intents on RX_INTENT_REQ

Cleanup 2026-11-02: removed tx_with_rcid (never fired on #183, 0 "no open_ack" lines), the violet_intent_req_reuse knob (now unconditional, downstream behaviour) and the "dropping" debug print.

--- a/drivers/rpmsg/qcom_glink_native.c
+++ b/drivers/rpmsg/qcom_glink_native.c
@@ -173,6 +173,7 @@
 	char *name;
 	unsigned int lcid;
 	unsigned int rcid;
+	bool intents_announced;
 
 	spinlock_t intent_lock;
 	struct idr liids;
@@ -843,6 +844,7 @@
 	struct glink_core_rx_intent *intent;
 	struct glink_channel *channel;
 	unsigned long flags;
+	int iid;
 
 	spin_lock_irqsave(&glink->idr_lock, flags);
 	channel = idr_find(&glink->rcids, cid);
@@ -857,6 +859,24 @@
 		return;
 	}
 
+	/*
+	 * violet: an already advertised reusable intent that is big enough
+	 * satisfies the request; ack it without advertising a new one, as the
+	 * downstream driver does.  The sm6150 ADSP (ADSP.VT.5.2) stops
+	 * servicing the whole edge when it gets a fresh INTENT in reply to its
+	 * RX_INTENT_REQ while it already holds large enough ones.
+	 */
+	spin_lock_irqsave(&channel->intent_lock, flags);
+	idr_for_each_entry(&channel->liids, intent, iid) {
+		if (intent->size >= size && intent->reuse)
+			break;
+	}
+	spin_unlock_irqrestore(&channel->intent_lock, flags);
+	if (intent) {
+		qcom_glink_send_intent_req_ack(glink, channel, true);
+		return;
+	}
+
 	intent = qcom_glink_alloc_intent(glink, channel, size, false);
 	if (intent)
 		qcom_glink_advertise_intent(glink, channel, intent);
@@ -1316,6 +1336,9 @@
 	return ret;
 }
 
+static int qcom_glink_advertise_base_intents(struct glink_channel *channel,
+					     struct device_node *np);
+
 static struct rpmsg_endpoint *qcom_glink_create_ept(struct rpmsg_device *rpdev,
 						    rpmsg_rx_cb_t cb,
 						    void *priv,
@@ -1342,25 +1365,57 @@
 		channel = qcom_glink_create_local(glink, name);
 		if (IS_ERR(channel))
 			return NULL;
+
+		ept = &channel->ept;
+		ept->rpdev = rpdev;
+		ept->cb = cb;
+		ept->priv = priv;
+		ept->ops = &glink_endpoint_ops;
 	} else {
+		/*
+		 * violet: install the endpoint *before* the reciprocal OPEN.
+		 *
+		 * qcom_glink_create_remote() blocks for up to 5 s waiting for
+		 * the remote's OPEN_ACK.  Any data the remote sends inside that
+		 * window is copied into our intent, RX_DONE'd, and then dropped
+		 * silently, because channel->ept.cb is still NULL at that point
+		 * (see qcom_glink_rx_data, where the callback is only invoked
+		 * when ept.cb is non-NULL).
+		 * The sm6150 modem opens IPCRTR, immediately sends its single
+		 * 52-byte QRTR HELLO and then waits for an answer.  With the
+		 * callback installed too late that HELLO is lost, so the AP's
+		 * name service never sees the modem, never greets it, and the
+		 * firmware asserts 40 s later (fatal error without message).
+		 * The ADSP survives the same race only because it keeps talking.
+		 * The modem ACKs our reciprocal OPEN, so this window is exactly
+		 * the OPEN_ACK round trip.
+		 */
+		ept = &channel->ept;
+		ept->rpdev = rpdev;
+		ept->cb = cb;
+		ept->priv = priv;
+		ept->ops = &glink_endpoint_ops;
+
 		ret = qcom_glink_create_remote(glink, channel);
 		if (ret)
 			return NULL;
 	}
 
-	ept = &channel->ept;
-	ept->rpdev = rpdev;
-	ept->cb = cb;
-	ept->priv = priv;
-	ept->ops = &glink_endpoint_ops;
+	/* violet: advertise the base intents now, as downstream does when the
+	 * channel opens, rather than in announce_create() after the driver's
+	 * probe.  Clients such as q6core send their first request from probe,
+	 * the ADSP answers at once, and with no intent available it has to
+	 * send RX_INTENT_REQ - and the sm6150 ADSP (ADSP.VT.5.2) stops
+	 * servicing the whole edge right after sending one.
+	 */
+	qcom_glink_advertise_base_intents(channel, rpdev->dev.of_node);
 
 	return ept;
 }
 
