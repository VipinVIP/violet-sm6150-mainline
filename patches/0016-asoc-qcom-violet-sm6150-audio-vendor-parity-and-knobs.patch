 #define MI2S_BCLK_RATE		1536000
 
+/*
+ * violet diagnostic (audio A6).  The AFE firmware on this device answers the
+ * legacy LPASS core/HW vote request with "Unknown cmd" and times out (-110) on
+ * AFE_PARAM_ID_CLOCK_SET, which is what sm8250_snd_startup sends via
+ * Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT.  Try the newer port-scoped clock param
+ * (AFE_PARAM_ID_LPAIF_CLK_CONFIG, SET_PARAM_V2) instead, or send nothing at all
+ * to isolate the clock call from the port start.
+ *   0 = IBIT clock id  -> CLOCK_SET        (0x10290, SET_PARAM v1)  [upstream]
+ *   1 = LPAIF_BIT_CLK  -> LPAIF_CLK_CONFIG (0x10238, SET_PARAM_V2)
+ *   2 = send no clock at all
+ */
+static int violet_slave;
+module_param(violet_slave, int, 0644);
+MODULE_PARM_DESC(violet_slave, "1: AFE MI2S port is clock slave (no internal bit clock)");
+static int clk_mode;
+module_param(clk_mode, int, 0644);
+MODULE_PARM_DESC(clk_mode, "AFE MI2S clock param: 0=IBIT/CLOCK_SET, 1=LPAIF_BIT_CLK, 2=none");
+
+static int sm8250_mi2s_clk(struct snd_soc_dai *cpu_dai, int ibit_id)
+{
+	int ret;
+
+	switch (clk_mode) {
+	default:
+	case 0:
+		ret = snd_soc_dai_set_sysclk(cpu_dai, ibit_id, MI2S_BCLK_RATE,
+					     SNDRV_PCM_STREAM_PLAYBACK);
+		break;
+	case 1:
+		ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, MI2S_BCLK_RATE,
+					     SNDRV_PCM_STREAM_PLAYBACK);
+		break;
+	case 2:
+		ret = 0;
+		break;
+	}
+
+	dev_info(cpu_dai->dev, "mi2s clk: mode=%d ibit_id=%d -> %d\n",
+		 clk_mode, ibit_id, ret);
+	return ret;
+}
