+/*
+ * D1 (2026-10-30): 6G DSI CLK_STATUS is at 0x120, +4 from the legacy offset the
+ * generated dsi.xml.h names (0x11c). Confirmed by reading both registers on a
+ * stalled link: 0x120 = 0x343 - which is the documented "DYN BYTECLK and DYN
+ * PCLK missing" signature - while 0x11c = 0x23f carries only the CLK_CTRL core
+ * clock bits. Bit meanings from dsi.xml (DSI_CLK_STATUS_DSI_DYN_*).
+ */
+#define DSI_6G_CLK_STATUS		0x120
+#define DSI_6G_FIFO_STATUS		0x0c	/* likewise +4 from the xml's 0x08 */
+#define DSI_CLK_STATUS_DYN_BYTECLK	0x80
+#define DSI_CLK_STATUS_DYN_PCLK		0x400
+
+/*
+ * True when both dynamic link clocks are actually toggling. AON bits prove the
+ * register block itself is clocked, so this read is safe even when the link is
+ * dead; DYN bits are what the panel's video timing depends on.
+ */
+static bool dsi_link_clock_active(struct msm_dsi_host *msm_host)
+{
+	u32 status = dsi_read(msm_host, DSI_6G_CLK_STATUS);
+	u32 need = DSI_CLK_STATUS_DYN_BYTECLK | DSI_CLK_STATUS_DYN_PCLK;
+
+	return (status & need) == need;
+}
