+	/*
+	 * D1 (2026-10-30): verify the link clocks are actually toggling before the
+	 * DPU is handed this link.
+	 *
+	 * clk_set_rate() cannot report the failure: update_config() in clk-rcg2.c
+	 * polls CMD_UPDATE for 500us, then WARNs and returns -EBUSY, but CCF's
+	 * clk_change_rate() discards a driver's set_rate return value, so
+	 * dsi_link_clk_set_rate_6g() returns 0 even when the 6 GHz link rate never
+	 * took. The controller then runs with DYN BYTECLK/PCLK gated off
+	 * (CLK_STATUS = 0x343 measured on the failing boot), the DPU overflows the
+	 * FIFO (0xdddd1019) and the panel sits black with the backlight on until a
+	 * fresh power-on cycle - the "two power-button presses" recovery.
+	 *
+	 * Note the 6G register offset: CLK_STATUS is at 0x120 here, not the 0x11c
+	 * the generated dsi.xml.h names (that is CLK_CTRL on 6G hardware).
+	 */
+	if (!dsi_link_clock_active(msm_host)) {
+		u32 cs = dsi_read(msm_host, DSI_6G_CLK_STATUS);
+
+		pr_err("%s: link clocks stalled after enable (clk_status=%08x, fifo=%08x), reprogramming\n",
+		       __func__, cs, dsi_read(msm_host, DSI_6G_FIFO_STATUS));
+
+		cfg_hnd->ops->link_clk_disable(msm_host);
+		udelay(200);
+		ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
+		if (!ret)
+			ret = cfg_hnd->ops->link_clk_enable(msm_host);
+		if (ret || !dsi_link_clock_active(msm_host)) {
+			cs = dsi_read(msm_host, DSI_6G_CLK_STATUS);
+			pr_err("%s: link clocks still stalled after retry (clk_status=%08x, ret=%d)\n",
+			       __func__, cs, ret);
+			if (!ret)
+				ret = -EAGAIN;
+			goto fail_disable_clk;
+		}
+		pr_info("%s: link clocks recovered on retry (clk_status=%08x)\n",
+			__func__, dsi_read(msm_host, DSI_6G_CLK_STATUS));
+	}
+
