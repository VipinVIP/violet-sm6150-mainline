+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm PMIC LCD bias (LCDB) module, as found on PM6150L.
+ *
+ * The LCDB block generates the positive (LDO, via a boost) and negative (NCP)
+ * supplies of an LCD panel with a single module enable.  The output voltages
+ * are left as programmed by the bootloader; only the module enable is
+ * controlled, so both panel rails share one regulator.
+ */
+
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define LCDB_INT_RT_STS		0x10
+#define  LCDB_VREG_OK		BIT(0)
+#define LCDB_MODULE_RDY		0x45
+#define  LCDB_MODULE_RDY_BIT	BIT(7)
+#define LCDB_ENABLE_CTL1	0x46
+#define  LCDB_MODULE_EN		BIT(7)
+
+struct qcom_lcdb {
+	struct regmap *regmap;
+	u32 base;
+};
+
+static int qcom_lcdb_enable(struct regulator_dev *rdev)
+{
+	struct qcom_lcdb *lcdb = rdev_get_drvdata(rdev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_write(lcdb->regmap, lcdb->base + LCDB_ENABLE_CTL1, LCDB_MODULE_EN);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(lcdb->regmap, lcdb->base + LCDB_INT_RT_STS, val,
+				       val & LCDB_VREG_OK, 1000, 50000);
+	if (ret)
+		dev_err(rdev_get_dev(rdev), "vreg-ok not set after enable: %d\n", ret);
+
+	return ret;
+}
+
+static int qcom_lcdb_disable(struct regulator_dev *rdev)
+{
+	struct qcom_lcdb *lcdb = rdev_get_drvdata(rdev);
+
+	return regmap_write(lcdb->regmap, lcdb->base + LCDB_ENABLE_CTL1, 0);
+}
+
+static int qcom_lcdb_is_enabled(struct regulator_dev *rdev)
+{
+	struct qcom_lcdb *lcdb = rdev_get_drvdata(rdev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(lcdb->regmap, lcdb->base + LCDB_ENABLE_CTL1, &val);
+	if (ret)
+		return ret;
+
+	return !!(val & LCDB_MODULE_EN);
+}
+
+static const struct regulator_ops qcom_lcdb_ops = {
+	.enable = qcom_lcdb_enable,
+	.disable = qcom_lcdb_disable,
+	.is_enabled = qcom_lcdb_is_enabled,
+};
+
+static const struct regulator_desc qcom_lcdb_desc = {
+	.name = "lcdb",
+	.of_match = NULL,
+	.ops = &qcom_lcdb_ops,
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+};
+
+static int qcom_lcdb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config cfg = {};
+	struct regulator_dev *rdev;
+	struct qcom_lcdb *lcdb;
+	unsigned int val;
+	int ret;
+
+	lcdb = devm_kzalloc(dev, sizeof(*lcdb), GFP_KERNEL);
+	if (!lcdb)
+		return -ENOMEM;
+
+	lcdb->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!lcdb->regmap)
+		return -ENODEV;
+
+	ret = device_property_read_u32(dev, "reg", &lcdb->base);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing reg\n");
+
+	ret = regmap_read(lcdb->regmap, lcdb->base + LCDB_MODULE_RDY, &val);
+	if (ret)
+		return ret;
+	if (!(val & LCDB_MODULE_RDY_BIT))
+		return dev_err_probe(dev, -ENODEV, "LCDB module not ready\n");
+
+	cfg.dev = dev;
+	cfg.driver_data = lcdb;
+	cfg.of_node = dev->of_node;
+	cfg.init_data = of_get_regulator_init_data(dev, dev->of_node, &qcom_lcdb_desc);
+
+	rdev = devm_regulator_register(dev, &qcom_lcdb_desc, &cfg);
+	if (IS_ERR(rdev))
+		return dev_err_probe(dev, PTR_ERR(rdev), "failed to register regulator\n");
+
+	return 0;
+}
+
+static const struct of_device_id qcom_lcdb_match[] = {
+	{ .compatible = "qcom,pm6150l-lcdb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, qcom_lcdb_match);
+
+static struct platform_driver qcom_lcdb_driver = {
+	.driver = {
+		.name = "qcom-lcdb-regulator",
+		.of_match_table = qcom_lcdb_match,
+	},
+	.probe = qcom_lcdb_probe,
+};
+module_platform_driver(qcom_lcdb_driver);
+
+MODULE_DESCRIPTION("Qualcomm PMIC LCD bias (LCDB) regulator driver");
+MODULE_LICENSE("GPL");
