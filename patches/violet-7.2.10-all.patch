@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * violet (Redmi Note 7 Pro) camera.
+ *
+ * M0: CAMSS + CCI controllers.
+ * M0.5: IMX586 node on CCI bus 0. It is given compatible "sony,imx577" on purpose:
+ *       the in-tree imx412 driver then powers the rails, enables MCLK and reads the
+ *       chip ID, and its "chip id mismatch" error tells us the real ID. Replace with
+ *       the imx586 compatible once the dedicated driver exists (M1).
+ *
+ * Rails from the vendor DTB (unpacked from ~/violet-pmos/images-r9/boot-r10.img):
+ *   cam_csiphy0..2: csi-vdd-voltage <0x124f80>, mipi-csi-vdd-supply = pm6150l_l3
+ *     -> vreg_l3e_1p2 (PM6150L L3, 1.232 V)
+ *   camera_ldo       = PM6150L gpio 3, 1.2 V   (dvdd)
+ *   camera_vana0_ldo = PM6150L gpio 9, 2.8 V   (avdd, rear main)
+ *   camera_vana1_2_ldo = PM6150L gpio 4, 2.8 V (avdd, aux/front)
+ *   cam_vio = pm6150_l13 (1.8 V, dovdd)
+ * Reset of the rear main sensor = TLMM gpio 47, MCLK0 on TLMM gpio 28.
+ */
+
+#include <dt-bindings/clock/qcom,qcs615-camcc.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	camera_ldo: regulator-camera-vdig {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_ldo";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-enable-ramp-delay = <135>;
+		enable-active-high;
+		gpio = <&pm6150l_gpios 3 GPIO_ACTIVE_HIGH>;
+	};
+
+	camera_vana0_ldo: regulator-camera-vana0 {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_vana0_ldo";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-enable-ramp-delay = <233>;
+		enable-active-high;
+		gpio = <&pm6150l_gpios 9 GPIO_ACTIVE_HIGH>;
+	};
+
+	camera_vana1_2_ldo: regulator-camera-vana1-2 {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_vana1_2_ldo";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-enable-ramp-delay = <233>;
+		enable-active-high;
+		gpio = <&pm6150l_gpios 4 GPIO_ACTIVE_HIGH>;
+		regulator-always-on;
+	};
+};
+
+&camss {
+	vdd-csiphy-1p2-supply = <&vreg_l3e_1p2>;
+	vdd-csiphy-1p8-supply = <&vreg_l13a_1p8>;
+	status = "okay";
+
+	ports {
+		port@0 {
+			csiphy0_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&rear_main_ep>;
+			};
+		};
+
+		port@1 {
+			csiphy1_ep: endpoint {
+				data-lanes = <0 1>;
+				remote-endpoint = <&rear_aux_ep>;
+			};
+		};
+
+		port@2 {
+			csiphy2_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&front_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c1 {
+	status = "okay";
+
+	/* rear VCM: Dongwoon DW9800 (id 0xf2 at 0x0c, 2026-11-04); vaf = pm6150 l19, always-on */
+	rear_vcm: actuator@c {
+		compatible = "dongwoon,dw9800";
+		reg = <0x0c>;
+		vaf-supply = <&vreg_l19a_2p7>;
+	};
+
+	rear_main: camera@1a {
+		compatible = "sony,imx586";
+		reg = <0x1a>;
+
+		orientation = <1>;
+		rotation = <270>;
+		reset-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
+		camtest-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>, <&tlmm 98 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk0_default>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		avdd-supply = <&camera_vana0_ldo>;
+		dovdd-supply = <&vreg_l13a_1p8>;
+		dvdd-supply = <&camera_ldo>;
+		lens-focus = <&rear_vcm>;
+
+		port {
+			rear_main_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <574000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c0 {
+	status = "okay";
+
+	/* rear aux: Samsung S5K5E8 (chip id 0x5e80 read at 0x18 on CCI master 0, measured 2026-11-03) */
+	rear_aux: camera@18 {
+		compatible = "samsung,s5k5e8";
+		reg = <0x18>;
+		reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <24000000>;
+		avdd-supply = <&camera_vana1_2_ldo>;
+		dovdd-supply = <&vreg_l13a_1p8>;
+		dvdd-supply = <&camera_ldo>;
+		orientation = <1>;
+		rotation = <270>;
+		port {
+			rear_aux_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <336000000>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c1 {
+	/* front: OmniVision OV13855 (chip id 0xd855 read at 0x36 on CCI master 1, measured 2026-11-03) */
+	front_cam: camera@36 {
+		compatible = "ovti,ov13855";
+		reg = <0x36>;
+		reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk2_default>;
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <24000000>;
+		avdd-supply = <&camera_vana1_2_ldo>;
+		dovdd-supply = <&vreg_l13a_1p8>;
+		dvdd-supply = <&camera_ldo>;
+		orientation = <0>;
+		rotation = <90>;
+		port {
+			front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <360000000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/violet-sm6150.dts
@@ -0,0 +1,2106 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi Note 7 Pro (violet)
+ *
+ * SM6150 / Snapdragon 675 — internal MSM codename "Talos", which is the name
+ * mainline uses for this SoC (shared with QCS615).  So the SoC description is
+ * arch/arm64/boot/dts/qcom/talos.dtsi and this file only has to describe the
+ * *board*.
+ *
+ * Status (mainline 7.2.10, booted via kexec from the downstream kernel):
+ *   [x] reserved memory (ramoops console, GPU PIL region)
+ *   [x] console on uart0, eMMC, USB peripheral (high-speed only, QUSB2 PHY)
+ *   [x] GPU: Adreno 612 renders (RGMU, zap shader), needs
+ *       msm.separate_gpu_kms=1 (keeps the GPU a separate DRM device)
+ *   [~] PMIC rails: values from the vendor tables, only consumers modelled
+ *   [x] display chain: DSI PHY + NT36672A "shenchao" panel + WLED, DSI-1
+ *       connected 1080x2340, picture confirmed working (panel repaired 2026-10-25);
+ *       WLED must carry qcom,num-strings = <2> or the backlight OVP IRQ storms
+ *       at ~1150/s for as long as the panel is lit
+ *   [x] touchscreen: novatek @ i2c 0x01 (0x62 is the HW command window)
+ *   [x] GPU: Adreno 612 via freedreno (FD612), devfreq 435-845 MHz
+ *   [x] eMMC: 8-bit, non-removable, no CQE, HS200
+ *   [ ] audio (WCD9375 + AudioReach), camera, sensors, modem
+ *   [~] wifi (WCN3990 via ath10k_snoc): nodes added, needs the module +
+ *       ath10k firmware; see the notes at the end of this file
+ *   [!] known bug: a real graphical session (login) hard-locks the SoC after
+ *       ~30-40 s.  Storage, GPU runtime-PM, CPUs 5-7 and the WLED storm have
+ *       all been eliminated; the display frame-done IRQ stops being delivered.
+ *
+ * TZ/xPU quirks that shaped this file: the first four TLMM pins and the QoS
+ * registers of aggre1_noc hang the CPU when touched (see the notes at the
+ * bottom), and Linux must not enable the TZ SHM bridge on this SoC.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/iio/qcom,spmi-vadc.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/firmware/qcom,scm.h>
+#include <dt-bindings/soc/qcom,apr.h>
+#include <dt-bindings/usb/pd.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+
+#include "talos.dtsi"
+#include "pm6150.dtsi"
+#include "pm6150l.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Note 7 Pro";
+	compatible = "xiaomi,violet", "qcom,sm6150";
+	chassis-type = "handset";
+
+	/*
+	 * The bootloader supplies and fills RAM.  Two measured facts:
+	 *  - the vendor DTB that boots has a node named exactly "memory" (NO unit
+	 *    address) with a zero/placeholder size, and ABL fills it in.
+	 *  - mainline's talos.dtsi names it "memory@80000000" and comments
+	 *    "We expect the bootloader to fill in the size" -- the u-boot convention.
+	 * ABL looks the node up by NAME, so "memory@80000000" is not found and
+	 * neither is no node at all: both make it refuse the image.  Measured:
+	 *  - zero-size memory@80000000  -> refused
+	 *  - no memory node at all      -> refused
+	 * So use the vendor's exact name and let ABL fill it.
+	 */
+	/delete-node/ memory@80000000;
+
+	memory {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0>;
+	};
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &sdhc_1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * talos.dtsi references both of these; the board has to provide them.
+	 * The standard SM6150 pair, exactly as the QCS615 EVK declares them.
+	 */
+	clocks {
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board_clk: xo-board-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+};
+
+/*
+ * violet's OWN reserved-memory map.  The QCS615 EVK puts pil_gpu_mem at
+ * 0x97715000; violet's is at 0x97115000, so the SoC node has to be overridden
+ * (a wrong address here hands the zap/GPU region over to the allocator).
+ * The remaining remoteproc regions follow in later iterations.
+ */
+&{/reserved-memory} {
+	/delete-node/ pil-gpu@97715000;
+
+	ramoops: ramoops@a1600000 {
+		compatible = "ramoops";
+		reg = <0x0 0xa1600000 0x0 0x800000>;
+		/*
+		 * record-size is what makes a panic produce dmesg-ramoops-N.
+		 * Without it only console-ramoops-0 exists, so a hard reset or
+		 * a panic leaves no kernel log behind (STATUS.md, "Crash
+		 * evidence").  2 MB console + 1 MB pmsg + 1 MB record of the
+		 * 8 MB region leaves headroom.
+		 */
+		record-size = <0x100000>;
+		console-size = <0x200000>;
+		pmsg-size = <0x100000>;
+	};
+
+	pil_gpu_mem: pil-gpu@97115000 {
+		reg = <0x0 0x97115000 0x0 0x2000>;
+		no-map;
+	};
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * Nodes this device's bootloader patches BY NAME.
+ *
+ * Qualcomm ABL edits the boot image's DTB on every boot: it fills the memory
+ * map, records "removed" memory, writes the Android firmware metadata and the
+ * imem fields.  Violet's vendor DTB -- the one ABL actually boots -- carries all
+ * of these; mainline's soc DTS does not.  Measured: with the arm64 header fully
+ * matched, __symbols__ present and a dtbo that applies cleanly, ABL still
+ * refuses our DTB, which is why the missing vendor nodes are the prime suspect.
+ *
+ * Names, compatible strings and addresses are copied verbatim from violet's own
+ * vendor DTB (read back off the device).  Regions that mainline's talos.dtsi
+ * already declares under a different name are left alone: an extra reservation
+ * costs a little RAM and is harmless, while a missing node ABL expects is fatal.
+ * ---------------------------------------------------------------------------
+ */
+&{/reserved-memory} {
+	hyp_region@85700000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85700000 0x0 0x600000>;
+	};
+
+	xbl_aop_mem@85e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85e00000 0x0 0x140000>;
+	};
+
+	sec_apps_region@85fff000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85fff000 0x0 0x1000>;
+	};
+
+	/* ABL keeps its "removed memory" record here; 45 MB, the largest gap */
+	removed_region@86200000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x86200000 0x0 0x2d00000>;
+	};
+
+	camera_region@8ab00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8ab00000 0x0 0x500000>;
+	};
+
+	modem_mem: modem@8b000000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8b000000 0x0 0x7e00000>;
+	};
+
+	/*
+	 * IPA firmware / GSI carve-outs (vendor ipa_fw_region@97100000 and
+	 * ipa_gsi_region@97110000).  With "modem-init" the modem loads the GSI
+	 * firmware itself and writes here; if the kernel owns this memory the
+	 * modem corrupts it and the SoC resets ~16 s after "modem is now up".
+	 */
+	ipa_fw_mem: ipa-fw@97100000 {
+		reg = <0x0 0x97100000 0x0 0x10000>;
+		no-map;
+	};
+
+	ipa_gsi_mem: ipa-gsi@97110000 {
+		reg = <0x0 0x97110000 0x0 0x5000>;
+		no-map;
+	};
+
+	/*
+	 * rmtfs shared memory.  The modem asks the AP for files (its own
+	 * firmware tiles, calibration, the WLAN board data) through this
+	 * region via the rmtfs daemon.  The vendor allocates it DYNAMICALLY
+	 * (qcom,sharedmem-uio reg = <0 size> means "allocate"), so there is no
+	 * vendor address; the earlier "rmtfs@0" at physical address 0 was
+	 * not DRAM at all.  This one is real RAM just above ramoops, with the
+	 * usual guard pages (Fairphone 4 pattern) and the MSS_MSA VMID.
+	 */
+	rmtfs_mem: rmtfs@a1e00000 {
+		compatible = "qcom,rmtfs-mem";
+		reg = <0x0 0xa1e00000 0x0 0x280000>;
+		no-map;
+		qcom,client-id = <1>;
+		qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+	};
+
+	wlan_msa_mem: wlan_msa_mem@93300000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		/*
+		 * 2 MB, exactly the vendor's own carve-out
+		 * (dt/ref/violet-sm6150-memory.dtsi: 0x93300000 + 0x200000).
+		 *
+		 * This used to be 1 MB with a note saying pil-video@93400000
+		 * would overlap it - but that is talos' map, not violet's.
+		 * Violet puts video at 0x92e00000 and the next region after
+		 * the MSA starts at 0x93500000 (cdsp), so the full 2 MB is
+		 * free.  A truncated MSA is a wrong memory map handed to the
+		 * WLAN firmware.
+		 */
+		reg = <0x0 0x93300000 0x0 0x200000>;
+	};
+
+	/*
+	 * The ADSP/CDSP/IPA carve-outs that used to be declared here duplicated
+	 * (at different addresses) the ones talos.dtsi already defines -
+	 * rproc-cdsp@93b00000, rproc-adsp@95900000 - and the overlaps made the
+	 * kernel drop the regions.  rproc_adsp_mem@95900000 is the one
+	 * remoteproc_adsp references, so keep upstream's and drop these.
+	 */
+
+	qseecom_region@9e400000 {
+		compatible = "shared-dma-pool";
+		no-map;
+		reg = <0x0 0x9e400000 0x0 0x1400000>;
+	};
+
+	cdsp_sec_mem@9f800000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x9f800000 0x0 0x1e00000>;
+	};
+
+	cont_splash_region@9c000000 {
+		reg = <0x0 0x9c000000 0x0 0xf00000>;
+	};
+
+	dfps_data_region@9d000000 {
+		reg = <0x0 0x9d000000 0x0 0x100000>;
+	};
+
+	disp_rdump_region@9d100000 {
+		reg = <0x0 0x9d100000 0x0 0x1000000>;
+	};
+};
+
+/*
+ * imem: mainline declares sram@14680000; violet's is qcom,msm-imem@146aa000 and
+ * the vendor DTB exposes the sub-blocks ABL and the Android bootloader use
+ * (restart reason, boot stats, KASLR offset, the PIL/dload scratch areas).
+ */
+&soc {
+	qcom_msm_imem: imem@146aa000 {
+		compatible = "qcom,msm-imem";
+		/* mainline's /soc is 2 address + 2 size cells */
+		reg = <0x0 0x146aa000 0x0 0x1000>;
+		ranges = <0x0 0x0 0x146aa000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		imem_mem_dump_table: mem_dump_table@10 {
+			compatible = "qcom,msm-imem-mem_dump_table";
+			reg = <0x10 0x8>;
+		};
+
+		imem_restart_reason: restart_reason@65c {
+			compatible = "qcom,msm-imem-restart_reason";
+			reg = <0x65c 0x4>;
+		};
+
+		imem_dload_type: dload_type@1c {
+			compatible = "qcom,msm-imem-dload-type";
+			reg = <0x1c 0x4>;
+		};
+
+		imem_boot_stats: boot_stats@6b0 {
+			compatible = "qcom,msm-imem-boot_stats";
+			reg = <0x6b0 0x20>;
+		};
+
+		imem_kaslr_offset: kaslr_offset@6d0 {
+			compatible = "qcom,msm-imem-kaslr_offset";
+			reg = <0x6d0 0xc>;
+		};
+
+		imem_pil: pil@94c {
+			compatible = "qcom,msm-imem-pil";
+			reg = <0x94c 0xc8>;
+		};
+
+		imem_diag_dload: diag_dload@c8 {
+			compatible = "qcom,msm-imem-diag-dload";
+			reg = <0xc8 0xc8>;
+		};
+	};
+};
+
+/*
+ * ABL writes the Android firmware metadata into /firmware/android on every boot
+ * (the "boot_devices", vbmeta parts and fstab).  Violet's vendor DTB has it;
+ * mainline's does not.
+ */
+&{/firmware} {
+	android {
+		compatible = "android,firmware";
+
+		boot_devices = "soc/7c4000.sdhci";
+
+		vbmeta {
+			compatible = "android,vbmeta";
+			parts = "vbmeta,boot,recovery,system,vendor,dtbo";
+		};
+
+		fstab {
+			compatible = "android,fstab";
+
+			vendor {
+				compatible = "android,vendor";
+				dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
+				type = "ext4";
+				mnt_flags = "ro,barrier=1,discard";
+				fsmgr_flags = "wait,slotselect,avb";
+				status = "disabled";
+			};
+		};
+	};
+};
+
+/* the debug UART: serial@880000, matching violet's downstream earlycon */
+&uart0 {
+	status = "okay";
+};
+
+/*
+ * eMMC.  violet's vendor DT declares no vmmc/vddio for sdhc_1 at all -- the
+ * rails are left enabled by the bootloader -- and mainline treats those supplies
+ * as optional, so the node does not need them.
+ *
+ * It does need the two properties the EVK-oriented talos.dtsi leaves to the
+ * board, and their absence was not harmless: without bus-width the controller
+ * runs 1-bit, and without non-removable mmc treats the eMMC as a removable
+ * card, so a command timeout takes the rescan/re-init path instead of retrying.
+ * Under write load (a login) that produced
+ *   mmc0: Timeout waiting for hardware cmd interrupt
+ * followed by an RCU stall, a CPU pinned with IRQs off, and a system-wide hang.
+ * The vendor DT has qcom,bus-width = <8> and qcom,nonremovable.
+ */
+&sdhc_1 {
+	status = "okay";
+	bus-width = <8>;
+	non-removable;
+
+	/*
+	 * With 8-bit enabled the controller also advertised and initialised the
+	 * Command Queue Engine, and the freeze got *worse*: it arrived ~21 s
+	 * after login instead of ~60 s, with no console output at all (the
+	 * pstore dump ends at 33 s, so printk had already stopped).  CQE was
+	 * never active in the broken 1-bit configuration, so it is the new
+	 * variable - drop it for now.
+	 */
+	/delete-property/ supports-cqe;
+
+	/*
+	 * And let the bus run at its proper HS200 clock.  Do NOT cap this with
+	 * max-frequency: the mmc core still selects HS200 mode (host capability,
+	 * not DT-controlled), so capping the clock to 52 MHz leaves the
+	 * controller running HS200 *timing* at a quarter of the frequency it
+	 * requires - an out-of-spec combination that produces data errors and
+	 * command timeouts.  Observed: deaths right after adding the cap came at
+	 * 107 s / 77 s / 155 s, versus 321 s without it.
+	 */
+};
+
+/*
+ * The Adreno 612.  Everything it needs is already in talos.dtsi (gpucc core
+ * clock, RPMHPD_CX, adreno_smmu, the mobile OPP table 845..290 MHz), so the
+ * board only has to turn it on.  Firmware to have in /lib/firmware:
+ *   a612_rgmu.bin, a630_sqe.fw  (mainline names, both installed already)
+ *   the signed zap -- the single-file .mbn form mainline requests is the
+ *   ROM's a612_zap.elf (already extracted from violet's own vendor image)
+ */
+/*
+ * QCS615/SM6150 GCC GDSCs are backed by the RPMh CX rail.  Without this link a
+ * consumer of a GCC-provided GDSC can enable its local domain without the CX
+ * vote ever being held, which is why GPUCC's parents (GPLL0 and
+ * GCC_GPU_GPLL0_DIV_CLK_SRC) come up dead and gpu_cc_gx_gfx3d_clk_src reports
+ * "RCG did not turn on" at 0.234s.  Upstream added this property in commit
+ * 5ad7eb6a944e, which is newer than our 7.2.10 base.
+ */
+&gcc {
+	power-domains = <&rpmhpd RPMHPD_CX>;
+};
+
+&gpu {
+	status = "okay";
+};
+
+/*
+ * mainline requires the zap firmware name to come from the DT for new targets
+ * ("the firmware is signed with a (potentially) device specific key, having the
+ * name come from gpulist was a bad idea").  request_firmware_direct() uses this
+ * string verbatim -- no qcom/ fallback probing.
+ *
+ * Install the DEVICE-SIGNED single-file zap at /lib/firmware/qcom/a612_zap.mbn:
+ * that is the ROM's a612_zap.elf (14240 B).  Do NOT use the upstream
+ * linux-firmware qcs615 blob (14256 B) -- it is signed for a sibling part and
+ * TrustZone rejects it, which is measured behaviour on this device.
+ */
+&gpu_zap_shader {
+	firmware-name = "qcom/a612_zap.mdt";
+};
