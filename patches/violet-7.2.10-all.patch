+	LPI_MUX_audio_ref,
+	LPI_MUX_cdc_pdm_rx,
+	LPI_MUX_dmic1_clk,
+	LPI_MUX_dmic1_data,
+	LPI_MUX_dmic2_clk,
+	LPI_MUX_dmic2_data,
+	LPI_MUX_qdss_cti,
+	LPI_MUX_gp_pdm,
+	LPI_MUX_prim_mclk_a,
+	LPI_MUX_prim_mclk_b,
+	LPI_MUX_qca_sb_clk,
+	LPI_MUX_qca_sb_data,
+	LPI_MUX_qua_mi2s_data,
+	LPI_MUX_qua_mi2s_sclk,
