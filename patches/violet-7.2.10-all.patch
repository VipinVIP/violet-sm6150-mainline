+&{/firmware} {
+	android {
+		compatible = "android,firmware";
+
+		boot_devices = "soc/7c4000.sdhci";
+
+		vbmeta {
+			compatible = "android,vbmeta";
+			parts = "vbmeta,boot,recovery,system,vendor,dtbo";
+		};
