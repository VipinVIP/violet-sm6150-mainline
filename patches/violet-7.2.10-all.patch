+static int lpi_pinctrl_clk_runtime_suspend(struct device *dev)
+{
+	struct lpi_pinctrl *pctrl = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(pctrl->num_clks, pctrl->clks);
+
+	return 0;
+}
+
+static int lpi_pinctrl_clk_runtime_resume(struct device *dev)
+{
+	struct lpi_pinctrl *pctrl = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(pctrl->num_clks, pctrl->clks);
+	if (ret) {
+		/*
+		 * Without the LPASS core vote the LPI registers are not
+		 * reachable and an access stalls the AP. Refuse it; -EAGAIN
+		 * keeps runtime PM from latching the error, so a vote that
+		 * failed because the DSP was not up yet is retried later.
+		 */
+		dev_err_ratelimited(dev, "LPASS vote failed (%d), not touching LPI registers\n",
+				    ret);
+		return -EAGAIN;
+	}
+
+	return 0;
+}
