+		vddi-supply = <&vreg_l13a_1p8>;
+		avdd-supply = <&pm6150l_lcdb>;
+		avee-supply = <&pm6150l_lcdb>;
+
+		reset-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+		backlight = <&pm6150l_wled>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <1 2 3 0>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l4a_0p8>;
+
+	status = "okay";
+};
+
+&pm6150l_wled {
+	qcom,current-limit-microamp = <25000>;
+	qcom,cabc;
+
+	status = "okay";
+};
+
+&pm6150l_lsid5 {
+	/* LCD bias: the panel's AVDD/AVEE.  r10 switches it off before kexec. */
+	pm6150l_lcdb: regulator@ec00 {
+		compatible = "qcom,pm6150l-lcdb";
+		reg = <0xec00>;
+		regulator-name = "lcdb";
+	};
+};
