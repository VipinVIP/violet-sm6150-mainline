+/*
+ * USB (peripheral only).  violet wires the high-speed QUSB2 PHY alone: the vendor
+ * tree sets maximum-speed = "high-speed" and disables usb_qmp_phy.  Supplies are the
+ * vendor's: vdd = pm6150 L4, vdda18 = L11, vdda33 = L17.
+ */
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l4a_0p8>;
+	vdda-pll-supply = <&vreg_l11a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l17a_3p0>;
+
+	status = "okay";
+};
+
+&usb_1 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+/*
+ * USB-C port, SINK ONLY.  The PMIC Type-C block + PD PHY negotiate the contract with the
+ * charger (vendor qcom,default-sink-caps = 5 V/3 A, 9 V/3 A; PD PHY supply = pm6150 L17).
+ * power-role = "sink" keeps Rd on the CC pins and never sources VBUS, so no vbus-supply
+ * (the boost regulator) is described.  The connector is deliberately NOT linked to the
+ * dwc3 role switch: USB stays peripheral-only exactly as above, the Type-C port only
+ * does PD.  The 9 V entry is a request, the charger decides what it offers.
+ */
+&pm6150_typec {
+	vdd-pdphy-supply = <&vreg_l17a_3p0>;
+
+	status = "okay";
+
+	connector {
+		compatible = "usb-c-connector";
+
+		power-role = "sink";
+		data-role = "device";
+
+		op-sink-microwatt = <9000000>;
+		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+			     PDO_FIXED(9000, 3000, 0)>;
+	};
+};
+
+/*
+ * Rear flash/torch: the dual LED on PM6150L flash channels 1 and 2 (vendor ids 0 and 1:
+ * pm6150l_flash0/1, torch0/1; the violet dtbo overlay sets 900 mA per channel for flash
+ * and torch max, 100 mA torch default).  Both channels drive one LED node so the class
+ * device is a single "white:flash".  Torch is capped well below the vendor 2 x 900 mA
+ * to keep the pack and the LED cool while this is brought up.  The front flash (channel
+ * 3 + its enable GPIO) is not wired up.
+ */
+&pm6150l_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>, <2>;
+		led-max-microamp = <500000>;
+		flash-max-microamp = <1800000>;
+		flash-max-timeout-us = <1280000>;
+	};
+};
+
+/*
+ * Probing aggre1_noc hangs the CPU on its first QoS register write (kexec test, run 9-10:
+ * PROBE-START 1700000.interconnect never returns).  With no clocks the driver skips QoS
+ * programming (qos_requires_clocks), which is what we want: the bootloader/downstream
+ * already configured QoS, and Linux writes to these registers are not safe on this firmware.
+ */
+&aggre1_noc {
+	/delete-property/ clocks;
+};
+
+/* TZ-protected pins found by tlmm-bisect.sh (reads hang the CPU) */
+&tlmm {
+	gpio-reserved-ranges = <0 4>;
+
+	/*
+	 * CNSS_WLAN_EN is TLMM gpio98 on violet (vendor pinctrl
+	 * cnss_wlan_en_active / _sleep: function gpio, drive-strength 16 / 2).
+	 * The vendor cnss driver raises this before the WCN3990 boot ROM runs.
+	 * Mainline's ath10k snoc has no enable-gpio property, and without the
+	 * pin asserted the chip never powers up: every WLAN_CE interrupt count
+	 * stays zero, no firmware is requested, and no wlan0 appears - which is
+	 * exactly what we measured on 2026-10-25.  Hog it high so the chip is
+	 * enabled for the whole boot.
+	 */
+	wlan_en_hog: wlan-en-hog {
+		gpio-hog;
+		gpios = <98 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "cnss-wlan-en";
+	};
+};
+
+
+/*
+ * TrustZone PAS (zap shader) authentication needs a DDR bandwidth vote on behalf of the
+ * crypto engine: the downstream pil-tz does scm_pas_enable_bw() before PAS_INIT_IMAGE, and
+ * without it TZ returns 0xffcfffbb (-3145797) -> -EINVAL.  Mainline models that vote as the
+ * scm node's interconnect path.
+ */
+&{/firmware/scm} {
+	interconnects = <&aggre1_noc MASTER_CRYPTO QCOM_ICC_TAG_ALWAYS
+			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+};
+
+/*
+ * Display: DPU -> DSI0 (4 lanes, video mode) -> Novatek NT36672A "shenchao" panel.
+ *
+ * The panel's AVDD/AVEE come from the PM6150L LCDB (one module enable; the voltages
+ * stay as programmed by the bootloader).  Backlight is the PM6150L WLED.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	/* DSI controller analog rail is PM6150L L3 (vendor "vdda-1p2", 1.232 V); L4A is the PHY's */
+	vdda-supply = <&vreg_l3e_1p2>;
+
+	status = "okay";
+
+	panel0: panel@0 {
+		compatible = "novatek,nt36672a-shenchao";
+		reg = <0>;
+
+		vddi-supply = <&vreg_l13a_1p8>;
+		avdd-supply = <&pm6150l_lcdb>;
+		avee-supply = <&pm6150l_lcdb>;
+
+		reset-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+		backlight = <&pm6150l_wled>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <1 2 3 0>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l4a_0p8>;
+
+	status = "okay";
+};
+
+&pm6150l_wled {
+	qcom,current-limit-microamp = <25000>;
+	qcom,cabc;
+
+	/*
+	 * Mainline's WLED5 defaults are num_strings = 4 with enabled_strings
+	 * {0,1,2,3}.  violet's panel does not populate four strings, and driving
+	 * an enabled-but-open string makes the boost converter trip OVP in a
+	 * retry loop: measured 1150 wled_ovp_irq/s the whole time the panel is
+	 * lit (onset exactly at dpms On), ~2300 SPMI transactions/s on the bus
+	 * that carries every other PMIC interrupt.  Vendor DT leaves the string
+	 * count at the downstream default rather than asking for four.
+	 */
+	qcom,num-strings = <2>;
+
+	status = "okay";
+};
+
+&pm6150l_lsid5 {
+	/* LCD bias: the panel's AVDD/AVEE.  r10 switches it off before kexec. */
+	pm6150l_lcdb: regulator@ec00 {
+		compatible = "qcom,pm6150l-lcdb";
+		reg = <0xec00>;
+		regulator-name = "lcdb";
+	};
+};
+
+/*
+ * Touchscreen: Novatek NT36672A TDDI controller on QUP SE1 = i2c1 @ 0x884000.
+ * Values taken from the vendor DT node /soc/i2c@884000/novatek@62 on a working
+ * downstream boot: compatible "novatek,NVT-ts", reg 0x62, irq gpio 89,
+ * reset gpio 88.  The vendor node carries no supply properties (the rails are
+ * always-on in the vendor regulator setup), while mainline's novatek-nvt-ts
+ * requires both "vcc" and "iovcc" by name, hence the two fixed always-on
+ * regulators below.  Replace them with the real PMIC LDOs once identified;
+ * as written they only tell the driver "you are powered" and vote nothing.
+ */
+
+/* QUP wrappers are "disabled" in talos.dtsi; without these the i2c1 child below
+ * is never instantiated and no i2c adapter appears at all (the SoC file leaves the
+ * GENI wrapper off so boards opt in).  gpi_dma0 is the DMA engine i2c1's dmas point at.
+ */
+&gpi_dma0 {
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@1 {
+		/* ADDRESS 0x01, not 0x62. Oracle: the vendor driver's own header
+		 * (nvt_touch_f7b/nt36xxx.h) defines I2C_FW_Address 0x01 (the register map,
+		 * used for every data read/write including chip id) and I2C_HW_Address 0x62
+		 * (only the 2-byte hardware commands: 0x69 bootloader reset, 0xA5 idle).
+		 * Mainline reads its 0x78 parameter block at 0x62 and gets a clean NACK.
+		 * The vendor DT's reg=<0x62> is decorative: that driver hardcodes the address
+		 * per transfer and never looks at client->addr.
+		 */
+		/* A/B v2: supply rails are now forced always-on, so this isolates
+		 * the remaining difference from the working vendor kernel, which
+		 * leaves pin 88 MUX+GPIO UNCLAIMED (oracle: vendor pinctrl
+		 * debugfs) - mainline drives it as an output instead.
+		 */
+		compatible = "novatek,nt36672a-ts";
+		reg = <0x01>;
+		panel = <&panel0>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <89 IRQ_TYPE_EDGE_FALLING>;
+		/* ACTIVE_LOW on purpose: the controller is running with the RESET line HIGH
+	 * (vendor nt36xxx.c does gpio_set_value(reset_gpio, 1) on power-on), while
+	 * novatek-nvt-ts treats logical 0 as "out of reset" in nvt_ts_start().
+	 * ACTIVE_LOW therefore maps logical 0 -> physical HIGH, which is what the
+	 * hardware wants.  ACTIVE_HIGH leaves the chip held in reset.
+	 */
+		reset-gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;
+		/* Rails taken from the r10-vs-mainline regulator diff, not guessed:
+		 * on the working vendor kernel pm6150l_l11 (2.95V) is enabled and it is
+		 * the only 2.9-3.1V rail that mainline leaves off (use=0), while
+		 * pm6150_l13 (1.8V) is what the vendor's commented-out
+		 * "vcc_i2c-supply" pointed at - i.e. the touch IO rail.
+		 */
+		/* Blueprint: mainline's working NT36672A port (sdm845-xiaomi-beryllium-tianma.dts)
+		 * feeds touch VCC from the PANEL BIAS rail ("lab" there), not from a generic PMIC
+		 * LDO.  On violet the panel bias is pm6150l LCDB (the panel's own avdd/avee), so the
+		 * controller has been on the wrong rail all along.  iovcc stays on the 1.8V DSI rail
+		 * (beryllium: vreg_l14a_1p8 = the same role).
+		 */
+		vcc-supply = <&pm6150l_lcdb>;
+		iovcc-supply = <&vreg_l13a_1p8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_reset_default &touch_irq_default>;
+	};
+};
+
+/* Touch reset/irq pins: the vendor tree leaves these to the default mux, but on mainline
+ * the reset line must be an explicit output driven low, otherwise the chip can be left
+ * held in reset and never ACKs on i2c (probe fails -110 at 0x78).
+ */
+&tlmm {
+	touch_reset_default: touch-reset-default-state {
+		/* high-Z on purpose: the working kernel has this pin MUX+GPIO
+		 * UNCLAIMED and the hardware pull decides the level.  No output
+		 * property and no bias == the same electrical state.
+		 */
+		pins = "gpio88";
+		function = "gpio";
+		bias-disable;
+	};
+
+	touch_irq_default: touch-irq-default-state {
+		pins = "gpio89";
+		function = "gpio";
+		bias-pull-up;
+	};
+};
+
+/*
+ * WCN3990 WiFi (ath10k_snoc)
+ * --------------------------
+ * mainline does not use a child WCSS remoteproc on this SoC generation: the MSA
+ * is carved out of a fixed reserved region and secured by the boot firmware, and
+ * ath10k brings the WCSS up itself (qcom,msa-fixed-perm), exactly like sc7180.
+ * Address, iommu SID, CE interrupt numbers and MSA size all come from the vendor
+ * icnss@18800000 node in base-sm6150.dtsi:
+ *   iommus = <&apps_smmu 0x1640 0x1>
+ *   interrupts = GIC SPI 414..425 (CE0..CE11) - note the GIC on this SoC takes
+ *                FOUR cells per interrupt (type, number, trigger, flags); with
+ *                three the parser mis-splits and only one IRQ registers, which
+ *                shows up as "-ENXIO: IRQ index 1 not found"
+ *   qcom,wlan-msa-memory = <0x100000>, qcom,wlan-msa-fixed-region = &wlan_msa_mem
+ *   the MSA region itself is the existing wlan_msa_mem@93300000 above (1 MB)
+ * The vendor also listed four supplies (pm6150_l9 = cx-mx, pm6150l_l1 = 1.8 xo,
+ * pm6150l_l2 = 1.3 rfa, pm6150l_l10 = 3.3 ch0); mainline's pm6150* dtsi files do
+ * not model those LDOs, so they are left to the voltages the bootloader leaves on
+ * until a regulator node exists for them.
+ *
+ * Required userspace bits (the kernel has ATH10K_SNOC as a module and there is
+ * currently no /lib/modules tree for this kernel on the device):
+ *   /lib/firmware/ath10k/WCN3990/hw1.0/firmware-5.bin
+ *   /lib/firmware/ath10k/WCN3990/hw1.0/board-2.bin
+ */
+&soc {
+	wifi@18800000 {
+		compatible = "qcom,wcn3990-wifi";
+		reg = <0x0 0x18800000 0x0 0x800000>;
+		reg-names = "membase";
+
+		iommus = <&apps_smmu 0x1640 0x1>;
+
+		/*
+		 * The WCN3990 is a discrete chip on SNOC: these four rails must be
+		 * actually enabled or the chip's boot ROM never runs and everything
+		 * on the QMI side simply never happens (silently - ath10k registers
+		 * its QMI client and waits forever).  Mapping and voltages are the
+		 * vendor's: pm6150_l9 = cx-mx, pm6150l_l1 = 1.8 XO,
+		 * pm6150l_l2 = 1.3 RFA, pm6150l_l10 = 3.3 CH0.
+		 * There is no vdd-3.3-ch1 on this board.
+		 */
+		vdd-0.8-cx-mx-supply = <&vreg_l9a_0p6>;
+		vdd-1.8-xo-supply = <&vreg_l1c_1p8>;
+		vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
+		vdd-3.3-ch0-supply = <&vreg_l10c_3p3>;
+
+		interrupts = <GIC_SPI 414 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 415 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 416 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 420 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 423 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 424 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 425 IRQ_TYPE_LEVEL_HIGH 0>;
+
+		memory-region = <&wlan_msa_mem>;
+		/* no qcom,msa-fixed-perm: let ath10k assign the MSA to MSS_MSA like icnss does */
+		/* violet's own bdwlan.bin, packed into board-2.bin under this variant name */
+		qcom,calibration-variant = "xiaomi_violet";
+
+		status = "okay";
+	};
+};
+
+/*
+ * RPMh regulators for the WLAN chip
+ * ---------------------------------
+ * mainline ships "qcom,pm6150-rpmh-regulators" and "qcom,pm6150l-rpmh-regulators"
+ * (drivers/regulator/qcom-rpmh-regulator.c) but no platform had described the
+ * PM6150/PM6150L rails, so ath10k's regulator_bulk_get() fell back to dummy
+ * regulators and the rails were never enabled.  Only the four rails the WCN3990
+ * needs are described here, with the vendor's own limits (base-sm6150-regulator.dtsi):
+ *   pm6150  ldo9 : cx-mx   400000-728000 (vendor init 400 mV, icnss raises it to 640 mV)
+ *   pm6150l ldo1 : 1.8 XO  1800000-1900000
+ *   pm6150l ldo2 : 1.3 RFA 1304000-1304000
+ *   pm6150l ldo10: 3.3 CH0 3200000-3312000
+ * The cx-mx minimum is raised to 640 mV because mainline's ath10k does not read
+ * the vendor's "qcom,vdd-0.8-cx-mx-config" property, so nothing else would ever
+ * ask for that voltage.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm6150-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		/* WCD9375: cdc-vdd-ldo-rxtx + cdc-vddpx-1 (vendor L10A) */
+		vreg_l10a_1p8: ldo10 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+
+		/* WCD9375: cdc-vdd-buck (vendor L15A) */
+		vreg_l15a_1p8: ldo15 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+
+		vreg_l9a_0p6: ldo9 {
+			/* the WCN3990's boot ROM must run before ath10k powers it */
+			regulator-always-on;
+			regulator-min-microvolt = <640000>;
+			regulator-max-microvolt = <728000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm6150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vreg_l1c_1p8: ldo1 {
+			/* the WCN3990's boot ROM must run before ath10k powers it */
+			regulator-always-on;
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+
+		vreg_l2c_1p3: ldo2 {
+			/* the WCN3990's boot ROM must run before ath10k powers it */
+			regulator-always-on;
+			regulator-min-microvolt = <1304000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+
+		vreg_l10c_3p3: ldo10 {
+			/* the WCN3990's boot ROM must run before ath10k powers it */
+			regulator-always-on;
+			regulator-min-microvolt = <3200000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+		};
+	};
+};
+
+/*
+ * ADSP (the audio/Sensor DSP)
+ * --------------------------
+ * talos.dtsi describes the node but leaves it disabled.  There is no
+ * "qcs615-adsp-pas" in qcom_q6v5_pas.c, so it binds via the second compatible,
+ * "qcom,sm8150-adsp-pas" -> sm8150_adsp_resource, whose firmware name is
+ * "adsp.mdt" - i.e. the SPLIT images (adsp.mdt + adsp.bNN) rather than a
+ * squashed .mbn.  The stock modem partition ships exactly that set, so copy
+ * adsp.mdt/adsp.b* to /lib/firmware/qcom/qcs615/ on the device.
+ */
+/*
+ * ADSP memory window
+ * ------------------
+ * The stock adsp image is RELOCATABLE (its segments carry the
+ * QCOM_MDT_RELOCATABLE flag), so the kernel has to tell TZ the window to load
+ * it into via qcom_scm_pas_mem_setup().  With talos.dtsi's address
+ * (0x95900000) that call came back -22, i.e. TZ refused the range; TZ only
+ * accepts the ADSP window the device was provisioned with, which is the
+ * vendor's: 0x95300000 + 0x1e00000 (ends at 0x97100000, immediately below the
+ * GPU zap shader at 0x97115000).
+ *
+ * CDSP is therefore pulled down to 0x93b00000 + 0x1800000 (24 MB - its stock
+ * firmware is 2.6 MB and we are not bringing CDSP up), so the two carve-outs
+ * stay adjacent and non-overlapping, exactly like the vendor map
+ * (cdsp 0x93500000-0x95300000, adsp 0x95300000-0x97100000).
+ */
+&rproc_cdsp_mem {
+	reg = <0x0 0x93b00000 0x0 0x1800000>;
+};
+
+&rproc_adsp_mem {
+	reg = <0x0 0x95300000 0x0 0x1e00000>;
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/qcs615/adsp.mdt";
+	status = "okay";
+};
+
+/* ============================================================================
+ * AUDIO
+ * ----------------------------------------------------------------------------
+ * The stock ADSP firmware on this device speaks the LEGACY APR protocol: once
+ * remoteproc_adsp is up the glink edge offers "apr_audio_svc" (and apr_apps2),
+ * not AudioReach's "adsp_apps".  So this uses the q6core/q6afe/q6asm/q6adm
+ * stack, NOT q6apm, even though talos.dtsi (written for QCS615 boards with
+ * newer firmware) wires the AudioReach nodes.
+ *
+ * Hardware map taken from the vendor sm6150-audio-overlay.dtsi:
+ *   tx_macro@62ec0000 -> swr2 @ 0x62ed0000, irq SPI 137 (wake 623), rx slave 0x01170223
+ *   rx_macro@62ee0000 -> swr1 @ 0x62ef0000, irq SPI 138,            rx slave 0x01170224
+ *   wsa_macro@62f00000 -> swr0: disabled on violet (no WSA speaker amp)
+ *   wcd9375 reset = LPASS LPI vendor gpio24 (msm_cdc_pinctrl@24, qcom,lpi-gpios);
+ *   SoundWire pins are LPI vendor gpio18-23 - see lpass_tlmm for the numbering
+ * ==========================================================================*/
+
+&glink_edge {
+	apr {
+		compatible = "qcom,apr-v2";
+		qcom,glink-channels = "apr_audio_svc";
+		qcom,domain = <APR_DOMAIN_ADSP>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		service@3 {
+			compatible = "qcom,q6core";
+			reg = <APR_SVC_ADSP_CORE>;
+		};
+
+		q6afe: service@4 {
+			compatible = "qcom,q6afe";
+			reg = <APR_SVC_AFE>;
+			/*
+			 * PDR: APR adds the AFE/ASM/ADM services only once the ADSP
+			 * audio PD reports UP (pd-mapper qcs615 table, instance 74).
+			 * Without it va_macro probed against a not-yet-ready AFE at
+			 * boot and failed its first clock set (DSP error 0x16).
+			 */
+			/*
+			 * PDR: APR adds the AFE/ASM/ADM services only once the ADSP
+			 * audio PD reports UP (pd-mapper qcs615 table, instance 74), so
+			 * va_macro's clock set and the LPI core vote no longer race the
+			 * DSP (error 0x16). Needs pd-mapper built in: as a module it
+			 * could load after the modem booted, and the modem then hit
+			 * "fatal error" every 40 s (upstream: "remoteproc: qcom_common:
+			 * load pd_mapper before booting the DSP").
+			 */
+			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+
+			q6afedai: dais {
+				compatible = "qcom,q6afe-dais";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				#sound-dai-cells = <1>;
+			};
+
+			q6afecc: clock-controller {
+				compatible = "qcom,q6afe-clocks";
+				#clock-cells = <2>;
+			};
+		};
+
+		q6asm: service@7 {
+			compatible = "qcom,q6asm";
+			reg = <APR_SVC_ASM>;
+			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+
+			q6asmdai: dais {
+				compatible = "qcom,q6asm-dais";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				#sound-dai-cells = <1>;
+				/* vendor: &msm_audio_ion { iommus = <&apps_smmu 0x1721 0x0>; qcom,smmu-sid-mask = 0xf } */
+				iommus = <&apps_smmu 0x1721 0x0>;
+
+				/*
+				 * q6asm-dai builds its DAIs from DT children:
+				 * reg = the front-end DAI id, direction selects
+				 * which stream the DAI advertises.
+				 */
+				dai@0 {
+					reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+					direction = <Q6ASM_DAI_TX>;
+				};
+
+				dai@1 {
+					reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+					direction = <Q6ASM_DAI_TX>;
+				};
+
+				dai@2 {
+					reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+					direction = <Q6ASM_DAI_RX>;
+				};
+
+				/* headphone playback: own front-end so each output has a PCM that is always routable */
+				dai@3 {
+					reg = <MSM_FRONTEND_DAI_MULTIMEDIA4>;
+					direction = <Q6ASM_DAI_RX>;
+				};
+			};
+		};
+
+		q6adm: service@8 {
+			compatible = "qcom,q6adm";
+			reg = <APR_SVC_ADM>;
+			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+
+			q6routing: routing {
+				compatible = "qcom,q6adm-routing";
+				#sound-dai-cells = <0>;
+			};
+		};
+	};
+};
+
+&soc {
+	/*
+	 * VA macro @0x62f20000 (vendor va-macro).  Its only job here is to
+	 * provide the "fsgen" clock: lpass-rx-macro/tx-macro call
+	 * devm_clk_get(dev, "fsgen") unconditionally and fail with -ENOENT
+	 * without it.
+	 */
+	vamacro: vamacro@62f20000 {
+		compatible = "qcom,sm8250-lpass-va-macro";
+		reg = <0x0 0x62f20000 0x0 0x2000>;
+
+		/*
+		 * audio test `nomacrovote`: the LPASS_HW_MACRO_VOTE clock is
+		 * gone from here too.  It was the last remaining consumer of
+		 * the ADSP clock-vote command at boot - va_macro probes first
+		 * and the vote times out (-110), which aborted va_macro, which
+		 * in turn kept txmacro/rxmacro/soundwire deferred forever.
+		 * "macro" and "dcodec" are optional in lpass-va-macro.c
+		 * (devm_clk_get_optional), so this costs us nothing on a device
+		 * whose WCD9375 path is parked anyway.  The question this test
+		 * answers: with no vote issued at boot, does the AFE answer
+		 * AFE_PARAM_ID_CLOCK_SET, or is it deaf regardless?
+		 */
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "mclk";
+
+		#clock-cells = <0>;
+		clock-output-names = "fsgen";
+		#sound-dai-cells = <1>;
+	};
+
+	txmacro: txmacro@62ec0000 {
+		compatible = "qcom,sm8250-lpass-tx-macro";
+		reg = <0x0 0x62ec0000 0x0 0x1000>;
+
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		/*
+		 * The stock sm6150 ADSP firmware rejects the LPASS clock-VOTE
+		 * command mainline's q6afe-clocks sends for the "macro" and
+		 * "dcodec" clocks (cmd 0x100f4 -> "Unknown cmd", "AFE failed
+		 * to vote"), which aborted macro probe with -110.  Both are
+		 * optional in the driver, so they are deliberately left out.
+		 */
+		clock-names = "mclk", "npl", "fsgen";
+
+		#sound-dai-cells = <1>;
+		#clock-cells = <0>;
+		clock-output-names = "lpass-tx-mclk";
+	};
+
+	/*
+	 * LPASS LPI TLMM, AP-owned half. Vendor pads 0-17 (0x62b40000 +
+	 * 0x12000) belong to the SSC and stall the AP if touched, so the node
+	 * starts at vendor pad 18: gpio0..13 here = vendor gpio18..31 (as the
+	 * sm7150-mainline port does). Reachable only while the ADSP holds the
+	 * LPASS core (MACRO, block 3) vote - DCODEC is refused by this firmware.
+	 */
+	lpass_tlmm: pinctrl@62b52000 {
+		compatible = "qcom,sm6150-lpass-lpi-pinctrl";
+		reg = <0x0 0x62b52000 0x0 0xe000>;
+		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "core";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&lpass_tlmm 0 0 14>;
+
+		tx_swr_active: tx-swr-active-state {
+			clk-pins {
+				pins = "gpio0";
+				function = "swr_tx_clk";
+				drive-strength = <8>;
+				bias-bus-hold;
+			};
+
+			data1-pins {
+				pins = "gpio1";
+				function = "swr_tx_data";
+				drive-strength = <8>;
+				bias-bus-hold;
+			};
+
+			data2-pins {
+				pins = "gpio2";
+				function = "swr_tx_data";
+				drive-strength = <8>;
+				bias-bus-hold;
+			};
+		};
+
+		/*
+		 * RX bus pads exactly as the Xiaomi sm6150/atoll LPI config (rx_swr_clk_active /
+		 * rx_swr_data_active): drive 2, slew 1, clock bias-disable, data bus-hold.  The
+		 * TX bus below is left as it was (it works).
+		 */
+		rx_swr_active: rx-swr-active-state {
+			clk-pins {
+				pins = "gpio3";
+				function = "swr_rx_clk";
+				drive-strength = <2>;
+				slew-rate = <1>;
+				bias-disable;
+			};
+
+			data-pins {
+				pins = "gpio4", "gpio5";
+				function = "swr_rx_data";
+				drive-strength = <2>;
+				slew-rate = <1>;
+				bias-bus-hold;
+			};
+		};
+
+		/* vendor msm_cdc_pinctrl@24 = LPI gpio24 = gpio6 here */
+		wcd937x_reset_active: wcd937x-reset-active-state {
+			pins = "gpio6";
+			function = "gpio";
+			drive-strength = <16>;
+			bias-disable;
+			output-high;
+		};
+	};
+
+	swr2: soundwire@62ed0000 {
+		compatible = "qcom,soundwire-v1.5.1";
+		reg = <0x0 0x62ed0000 0x0 0x2000>;
+		/*
+		 * The wake interrupt (vendor "swr_wake_irq", SPI 623,
+		 * qcom,swr-wakeup-required) is what lets the codec bring the
+		 * bus out of clock stop.  The headset-detect (MBHC) interrupts
+		 * of the WCD9375 are SoundWire in-band interrupts on this TX
+		 * slave, so without it a plug event while the bus is idle is
+		 * never delivered.
+		 */
+		interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 623 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "core", "wakeup";
+		clocks = <&txmacro>;
+		clock-names = "iface";
+		label = "TX";
+		pinctrl-0 = <&tx_swr_active>;
+		pinctrl-names = "default";
+
+		#address-cells = <2>;
+		#size-cells = <0>;
+		#sound-dai-cells = <1>;
+
+		/*
+		 * The controller reports version 0x01050000 (SWRM v1.5.0), not
+		 * v1.3.0. Ports and timing as the sm7150-mainline port (same
+		 * LPASS), from the downstream sm6150 tables: 5 TX ports.
+		 */
+		qcom,din-ports = <5>;
+		qcom,dout-ports = <0>;
+		qcom,ports-sinterval-low =	/bits/ 8 <0x01 0x03 0x03 0x03 0x03>;
+		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
+		qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
+		qcom,ports-lane-control =	/bits/ 8 <0x01 0x01 0x01 0x01 0x01>;
+
+		wcd937x_tx: codec@0,3 {
+			compatible = "sdw20217010a00";
+			reg = <0 3>;
+			#sound-dai-cells = <0>;
+			/* vendor qcom,swr-port-mapping: WCD TX ports 1-4 on master ports 2-5 */
+			qcom,tx-port-mapping = <2 3 4 5>;
+			/* slave ports: adc1, adc2, adc3, mic0, dmic1, mbhc,
+			 * dmic2, dmic3, dmic4, dmic5, dmic6, dmic7
+			 */
+			qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3 4>;
+		};
+	};
+
+	rxmacro: rxmacro@62ee0000 {
+		compatible = "qcom,sm8250-lpass-rx-macro";
+		reg = <0x0 0x62ee0000 0x0 0x1000>;
+
+		clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		/*
+		 * The stock sm6150 ADSP firmware rejects the LPASS clock-VOTE
+		 * command mainline's q6afe-clocks sends for the "macro" and
+		 * "dcodec" clocks (cmd 0x100f4 -> "Unknown cmd", "AFE failed
+		 * to vote"), which aborted macro probe with -110.  Both are
+		 * optional in the driver, so they are deliberately left out.
+		 */
+		clock-names = "mclk", "npl", "fsgen";
+
+		#sound-dai-cells = <1>;
+		#clock-cells = <0>;
+		clock-output-names = "lpass-rx-mclk";
+	};
+
+	swr1: soundwire@62ef0000 {
+		compatible = "qcom,soundwire-v1.5.1";
+		reg = <0x0 0x62ef0000 0x0 0x2000>;
+		interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&rxmacro>;
+		clock-names = "iface";
+		label = "RX";
+		pinctrl-0 = <&rx_swr_active>;
+		pinctrl-names = "default";
+
+		#address-cells = <2>;
+		#size-cells = <0>;
+		#sound-dai-cells = <1>;
+
+		/*
+		 * SWRM v1.5.0; 5 RX ports.  Frame parameters are the vendor's
+		 * rx_frame_params_default (techpack/audio asoc, kona-port-config.h, identical to
+		 * mainline sm8250/sm8450 swr1): the sm7150-mainline copy used before had
+		 * sinterval 0x3f on the CLSH port and different values on the LO/DSD ports.
+		 */
+		qcom,din-ports = <0>;
+		qcom,dout-ports = <5>;
+		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x1f 0x1f 0x07 0x00>;
+		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x00>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
+		qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;
+		qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;
+
+		wcd937x_rx: codec@0,4 {
+			compatible = "sdw20217010a00";
+			reg = <0 4>;
+			#sound-dai-cells = <0>;
+			qcom,rx-port-mapping = <1 2 3 4 5>;
+			/* slave ports: hph_l, hph_r, clsh, comp_l, comp_r,
+			 * lo, dsd_r, dsd_l
+			 */
+			qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
+		};
+	};
+};
+
+&{/} {
+	wcd9370: audio-codec {
+		compatible = "qcom,wcd9370-codec";
+		reset-gpios = <&lpass_tlmm 6 GPIO_ACTIVE_LOW>;
+		/*
+		 * Only a "default" state: ASoC selects a component's "sleep"
+		 * pinctrl state whenever it is inactive (end of card
+		 * instantiation, PCM close), and a sleep state that drives the
+		 * reset line low holds the codec in reset - both SoundWire
+		 * slaves dropped off the bus the instant the card registered.
+		 * Reset is the driver's job, through reset-gpios.
+		 */
+		pinctrl-0 = <&wcd937x_reset_active>;
+		pinctrl-names = "default";
+
+		vdd-buck-supply = <&vreg_l15a_1p8>;
+		vdd-rxtx-supply = <&vreg_l10a_1p8>;
+		vdd-px-supply = <&vreg_l10a_1p8>;
+		/* vendor: cdc-vdd-mic-bias-supply = BOB, cdc-micbias1..3-mv = 2600 */
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <2600000>;
+		qcom,micbias2-microvolt = <2600000>;
+		qcom,micbias3-microvolt = <2600000>;
+		/* vendor qcom,msm-mbhc-hs-mic-max-threshold-mv = <2550>; the driver default
+		 * (1700 mV) classifies a headset whose mic line idles near 1.95 V as an
+		 * extension cable / line out. */
+		qcom,mbhc-headset-vthreshold-microvolt = <2550000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
+							  500000 500000 500000 500000>;
+
+		qcom,rx-device = <&wcd937x_rx>;
+		qcom,tx-device = <&wcd937x_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+};
+
+&soc {
+	sound {
+		compatible = "qcom,sm8250-sndcard";
+		model = "Xiaomi Redmi Note 7 Pro";
+
+		/*
+		 * The MI2S pins were never muxed: talos.dtsi defines mi2s1_pins
+		 * (gpio108-111, function mi2s_1, drive 8, bias-disable) and
+		 * talos-evk puts it on the sound node, but we did not.  Driving
+		 * audio out of pins still in GPIO mode is one of the candidate
+		 * causes of the PMIC hard reset on stream start (audio test
+		 * audio1).  mi2s_mclk is deliberately NOT added: a TAS2563
+		 * clocks from BCLK, and gpio122/mclk2 may not be usable here.
+		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&mi2s1_pins>;
+
+		/* vendor qcom,audio-routing for the analog mics */
+		audio-routing = "IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC1", "MIC BIAS1",
+				"AMIC2", "MIC BIAS2",
+				"AMIC3", "MIC BIAS3",
+				"TX SWR_ADC0", "ADC1_OUTPUT",
+				"TX SWR_ADC2", "ADC2_OUTPUT";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		/*
+		 * MultiMedia3 is the only front-end whose Playback widget this
+		 * q6asm-dai instance actually registers (the debug trace shows
+		 * "adding MultiMedia1/2 Capture widget" but "MultiMedia3
+		 * Playback widget"), so give it a link and see if it yields a
+		 * playback PCM we can push a tone into.
+		 */
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		/* playback front-end for the 3.5 mm jack (speaker is MultiMedia3) */
+		mm4-dai-link {
+			link-name = "MultiMedia4";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA4>;
+			};
+		};
+
+		/*
+		 * The WCD9375 path is parked: its SoundWire slaves go UNATTACHED
+		 * (see PLAN.md) and a codec that fails to probe takes the whole
+		 * card down with it.  Keep this link list working so we can make
+		 * noise through the speaker amp, which is plain I2S off the
+		 * LPASS primary MI2S and needs none of that machinery.
+		 */
+		mic-capture-dai-link {
+			link-name = "WCD937x Capture";
+			cpu {
+				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			codec {
+				sound-dai = <&wcd9370 1>, <&swr2 0>, <&txmacro 0>;
+			};
+		};
+
+		/*
+		 * 3.5 mm headphones: RX codec-DMA 0 -> rx_macro -> SoundWire RX (swr1) ->
+		 * WCD9375 HPHL/HPHR.  Mirror of the working capture link above (DAI 0 of the
+		 * codec is its RX/playback side, DAI 1 the TX side).
+		 */
+		hph-playback-dai-link {
+			link-name = "WCD937x Playback";
+			cpu {
+				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			codec {
+				sound-dai = <&wcd9370 0>, <&swr1 0>, <&rxmacro 0>;
+			};
+		};
+
+		spk-playback-dai-link {
+			link-name = "Speaker Playback";
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			codec {
+				sound-dai = <&tas2563>;
+			};
+		};
+
+		/*
+		 * Diagnostic-only BE: starts a real AFE MI2S port (SECONDARY) with
+		 * no codec at all, so ASoC uses the dummy DAI.  Routing MultiMedia3
+		 * here tells us whether an AFE port start alone can reset the PMIC,
+		 * with the TAS2563 nowhere in the path.
+		 */
+		dbg-playback-dai-link {
+			link-name = "Debug Playback";
+			cpu {
+				sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			/*
+			 * qcom_snd_parse_of() treats a link without a codec as a
+			 * front end, so this BE never existed.  A dummy S/PDIF
+			 * transmitter makes it a real codec-less BE.
+			 */
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+	};
+};
+
+/*
+ * Speaker amplifier (TI TAS2563) on QUPv3 SE4 / i2c3, address 0x4c.
+ *
+ * The vendor node calls pin 22 "reset-gpio"; mainline's tas2562 driver takes an
+ * optional "shutdown" gpio and drives it with GPIOD_OUT_HIGH, i.e. out of
+ * shutdown, which is the state we want.  TAS2563 is register compatible with
+ * TAS2562, which is the compatible the mainline driver matches on.
+ *
+ * It is fed from the LPASS primary MI2S, so it needs no SoundWire and no
+ * WCD9375 - that is why it is the first path we try to make audible.
+ */
+/*
+ * Speaker amplifier (TI TAS2563), address 0x4c on QUPv3 *wrapper 1* / SE0
+ * (i2c@a80000).  The vendor calls this "SE4" and muxes it to gpio20/gpio21
+ * (function "qup10" downstream = "qup1" here); mainline's i2c4 node already
+ * defaults to exactly those pins, which is why the amp never answered when it
+ * was parked on i2c3 (wrapper 0) - that bus produced a clean NAK, and forcing
+ * the wrapper-1 pins onto the wrapper-0 controller produced a timeout.
+ *
+ * The vendor calls pin 22 "reset-gpio"; mainline's tas2562 driver takes an
+ * optional "shutdown" gpio and drives it GPIOD_OUT_HIGH (out of shutdown).
+ * TAS2563 is register compatible with TAS2562, which is what the driver matches.
+ */
+/*
+ * i2c4 lives in QUPv3 wrapper 1, which (and its GPI DMA) talos.dtsi leaves
+ * disabled.  Without these two the bus never probes and the card just sits in
+ * "codec dai not found" forever.
+ */
+/ {
+	/* Diagnostic dummy codec for the Debug Playback BE (AFE-only tests). */
+	dummy_codec: audio-codec-dummy {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0>;
+	};
+};
+
+&qupv3_id_1 {
+	status = "okay";
+};
+
+&gpi_dma1 {
+	status = "okay";
+};
+
+&i2c4 {
+	status = "okay";
+
+	tas2563: speaker-amp@4c {
+		/*
+		 * The TAS2563 is NOT register compatible with the TAS2562 that the
+		 * ti,tas2562 binding drives: different boost, different PLL, and a
+		 * DSP.  Driving it with the TAS2562 sequence corrupts its power-up
+		 * and trips the PMIC into a hard reset (PON: "Triggered from Hard
+		 * Reset") the instant a stream starts.  Mainline has a proper
+		 * driver for it: sound/soc/codecs/tas2781-i2c.c.
+		 */
+		compatible = "ti,tas2563";
+		reg = <0x4c>;
+		#sound-dai-cells = <0>;
+		/* driver calls devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH) */
+		reset-gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		/*
+		 * TEST audio1: keep this node ENABLED.  Disabling it makes the
+		 * card fail to register ("codec dai not found") because the
+		 * speaker DAI link still points at it, and then there is no PCM
+		 * to test with at all.  With no tas2563RCA1.bin present the
+		 * driver never powers the amp (startup returns -EINVAL), so it
+		 * stays inert unless something opens its DAI - which is exactly
+		 * what we want: stream only to the codec-less "Debug Playback"
+		 * BE (SECONDARY_MI2S_RX) and the amp is out of the picture.
+		 */
+		status = "okay";
+	};
+};
+
+/*
+ * The AFE needs to know which serial-data line each MI2S port uses; without
+ * qcom,sd-lines the port config carries a zero mask and the DSP refuses to
+ * start it:
+ *   qcom-q6afe aprsvc:service:4:4: no line is assigned
+ *   q6afe-dai: fail to prepare AFE port 10
+ *   ASoC error (-22): at snd_soc_dai_prepare() on PRI_MI2S
+ * aplay still "succeeds" because the failure is at prepare, not open - which is
+ * exactly why the card looked healthy while producing no sound.
+ */
+&q6afedai {
+	dai@16 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@18 {
+		reg = <SECONDARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@22 {
+		reg = <QUATERNARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@120 {
+		reg = <TX_CODEC_DMA_TX_3>;
+	};
+};
+
+
+/* ============================================================================
+ * MODEM (MSS)
+ * ----------------------------------------------------------------------------
+ * WiFi is not independent of the modem on this design: ath10k_snoc only
+ * registers a wiphy after the WLFW QMI service answers (qmi_add_lookup in
+ * ath10k_qmi_init), and that service comes from the modem subsystem over
+ * QRTR.  Without mpss there is no wlan0, whatever the WLAN rails do.
+ *
+ * The firmware is the device's own, taken from the "modem" partition
+ * (/image/modem.mdt + modem.b00..b27 -> /lib/firmware/qcom/qcs615/).  There
+ * is no mba.mbn: this is TZ-PAS (pas-id 4), authenticated by TrustZone.
+ *
+ * The memory carve-out is the modem@8b000000 region already declared above.
+ * mpss_resource_init has auto_boot = false, so nothing starts until we ask.
+ * ==========================================================================*/
+&soc {
+	smp2p-mpss {
+		compatible = "qcom,smp2p";
+		qcom,smem = <435>, <428>;
+		interrupts = <GIC_SPI 451 IRQ_TYPE_EDGE_RISING 0>;
+		mboxes = <&apss_shared 14>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <1>;
+
+		mpss_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		mpss_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		/*
+		 * The vendor's modem smp2p block also carries an entry named
+		 * "wlan" (smp2p_wlan_1_in) that icnss uses for
+		 * qcom,smp2p-force-fatal-error / early-crash-ind.  It is the
+		 * channel the modem uses to talk about the WLAN subsystem, so
+		 * without it the modem may never bring its WLFW service up.
+		 */
+		mpss_smp2p_wlan_in: wlan {
+			qcom,entry-name = "wlan";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		/*
+		 * IPA <-> modem handshake (vendor qcom,smp2p-ipa-1-out/in).  The
+		 * modem asks "ipa-clock-query" and waits for the AP's answer and
+		 * for the AP's IPA to come up; without it its init can stall and
+		 * assert (fatal error at a fixed 40 s).  The sm7150 mainline
+		 * port, which runs its modem + WiFi, describes the same pair.
+		 */
+		mpss_smp2p_ipa_out: ipa-ap-to-modem {
+			qcom,entry-name = "ipa";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		mpss_smp2p_ipa_in: ipa-modem-to-ap {
+			qcom,entry-name = "ipa";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/*
+	 * IPA v4.2 (hw-ver 0x10 = IPA_HW_v4_2, same as sc7180).  No ipa_fws on
+	 * the phone, so the modem loads the GSI firmware ("modem-init").
+	 */
+	ipa: ipa@1e40000 {
+		compatible = "qcom,sc7180-ipa";
+		reg = <0x0 0x01e40000 0x0 0x7000>,
+		      <0x0 0x01e47000 0x0 0x2000>,
+		      <0x0 0x01e04000 0x0 0x2c000>;
+		reg-names = "ipa-reg", "ipa-shared", "gsi";
+
+		iommus = <&apps_smmu 0x1520 0x0>,
+			 <&apps_smmu 0x1522 0x0>;
+
+		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING 0>,
+				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>,
+				      <&mpss_smp2p_ipa_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&mpss_smp2p_ipa_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa", "gsi", "ipa-clock-query", "ipa-setup-ready";
+
+		clocks = <&rpmhcc RPMH_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&aggre1_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+				<&aggre1_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+				 &system_noc SLAVE_IMEM QCOM_ICC_TAG_ALWAYS>,
+				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+				 &config_noc SLAVE_IPA_CFG QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "memory", "imem", "config";
+
+		qcom,qmp = <&aoss_qmp>;
+
+		qcom,smem-states = <&mpss_smp2p_ipa_out 0>,
+				   <&mpss_smp2p_ipa_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		modem-init;
+	};
+
+	remoteproc_mpss: remoteproc@4080000 {
+		compatible = "qcom,sm8150-mpss-pas";
+		reg = <0x0 0x04080000 0x0 0x4040>;
+
+		interrupts-extended = <&intc GIC_SPI 266 IRQ_TYPE_EDGE_RISING 0>,
+				      <&mpss_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&mpss_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+				      <&mpss_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+				      <&mpss_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
+				      <&mpss_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "wdog",
+				  "fatal",
+				  "ready",
+				  "handover",
+				  "stop-ack",
+				  "shutdown-ack";
+
+		clocks = <&rpmhcc RPMH_CXO_CLK>;
+		clock-names = "xo";
+
+		power-domains = <&rpmhpd RPMHPD_CX>, <&rpmhpd RPMHPD_MSS>;
+		power-domain-names = "cx", "mss";
+
+		memory-region = <&modem_mem>;
+
+		qcom,qmp = <&aoss_qmp>;
+
+		qcom,smem-states = <&mpss_smp2p_out 0>;
+		qcom,smem-state-names = "stop";
+
+		firmware-name = "qcom/qcs615/modem.mdt";
+
+		status = "okay";
+
+		/*
+		 * The modem's glink edge.  Without it the modem's IPCRTR channel
+		 * never appears, so QRTR has no modem node, and ath10k's WLFW
+		 * lookup (qmi_add_lookup in ath10k_qmi_init) never resolves -
+		 * which is why there was no wiphy even with the modem running.
+		 * mbox/IRQ are the vendor's (apcs_glb 12 / GIC_SPI 449).
+		 */
+		glink-edge {
+			interrupts-extended = <&intc GIC_SPI 449 IRQ_TYPE_EDGE_RISING 0>;
+			mboxes = <&apss_shared 12>;
+			label = "mpss";
+			qcom,remote-pid = <1>;
+		};
+	};
+};
+
+/*
+ * Battery sense.  Upstream's pm6150.dtsi only declares the die_temp channel
+ * of the PMIC ADC, so VBAT_SNS is never exposed and userspace has no way to
+ * read pack voltage - which is why Phosh shows the battery as unknown/critical.
+ * The SPMI ADC5 driver has supported this channel all along (ADC5_VBAT_SNS =
+ * 0x84); it just needs to be described.
+ */
+/*
+ * talos declares a video carve-out at 0x93400000..0x93900000 that violet does
+ * not have: violet puts video at 0x92e00000 and its next carve-out after the
+ * WLAN MSA starts at 0x93500000.  Leaving talos' node in place covers the top
+ * half of violet's 2 MB MSA, so the kernel drops the MSA region and hands the
+ * WLAN firmware a truncated map.
+ */
+&{/reserved-memory} {
+	/delete-node/ pil-video@93400000;
+
+	/*
+	 * talos' pil_video_mem label is referenced by video-codec@aa00000,
+	 * so it has to keep existing - it just has to point at violet's own
+	 * video carve-out (0x92e00000) instead of talos' 0x93400000, which
+	 * sits on top of the WLAN MSA's upper half.
+	 */
+	pil_video_mem: video@92e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x92e00000 0x0 0x500000>;
+	};
+};
+
+&pm6150_adc {
+	channel@84 {
+		reg = <ADC5_VBAT_SNS>;
+		label = "vbat_sns";
+	};
+
+	/* battery pack identity (68k ATL / 100k Coslight / 330k Sunwoda) and temperature */
+	channel@4a {
+		reg = <ADC5_BAT_THERM_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "bat_therm";
+	};
+
+	channel@4b {
+		reg = <ADC5_BAT_ID_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "bat_id";
+	};
+};
+
+/* ADSP fastrpc remote heap (audiopd) must be hyp-assigned to the DSP: vendor qcom,adsp-remoteheap-vmid = <22 37> */
+&glink_edge {
+	fastrpc {
+		qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;
+	};
+};
+
+/*
+ * Volume keys.  Volume down is the PMIC RESIN input; volume up is pm6150l GPIO2
+ * (active low, pulled up), exactly as the vendor DTBO wires them.
+ */
+&pm6150_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&pm6150l_gpios {
+	key_vol_up_default: key-vol-up-default-state {
+		pins = "gpio2";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <0>;
+	};
+};
+
+&{/} {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_vol_up_default>;
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm6150l_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+};
+
+/*
+ * Battery estimate: no QG/SMB5 driver upstream, so violet-vbat turns VBAT_SNS
+ * into a capacity with the vendor OCV table and reads the SMB5 charge state.
+ */
+&pm6150_lsid0 {
+	battery {
+		compatible = "xiaomi,violet-vbat";
+		io-channels = <&pm6150_adc ADC5_VBAT_SNS>,
+			      <&pm6150_adc ADC5_BAT_THERM_100K_PU>,
+			      <&pm6150_adc ADC5_BAT_ID_100K_PU>;
+		io-channel-names = "vbat", "batt-therm", "batt-id";
+	};
+};
+
+
+/*
+ * Memory hole the vendor kernel does not see as RAM: 0x93500000..0x93afffff (6 MiB), between
+ * wlan_msa_mem (ends 0x934fffff) and rproc-cdsp (0x93b00000).  r10's /proc/iomem has no
+ * System RAM there (compared 2026-10-27), but without a reservation mainline hands these
+ * pages to the allocator; the first program that touches one gets an instant, silent SoC
+ * reset (XPU/TZ protection).  This is the "hang under memory load" that took Firefox,
+ * video, apk installs and memcpy stress down.
+ */
+&{/reserved-memory} {
+	violet_hole_mem: violet-hole@93500000 {
+		reg = <0x0 0x93500000 0x0 0x600000>;
+		no-map;
+	};
+};
+
+/*
+ * Top of the high DRAM bank.  A page-by-page physical-address walk (2026-10-27) died right
+ * when the allocator reached 0x173000000 with the SoC resetting silently; everything below
+ * that (0x138000000..0x172ff8000) was fine.  Every "crash under memory load" (Firefox, video,
+ * apk, memcpy stress) was the allocator handing out these protected pages.  Reserve the whole
+ * 173 MiB tail until the real boundary of the protected area is known.
+ */
+&{/reserved-memory} {
+	violet_tail_mem: violet-tail@173000000 {
+		reg = <0x1 0x73000000 0x0 0x0ad00000>;
+		no-map;
+	};
+};
+
+/*
+ * PMIC real-time clock.  Disabled in pm6150.dtsi, so violet booted with the time at
+ * 1970-01-01 until chrony got an NTP reply (and had no clock at all when offline).
+ * The RTC counter itself is read-only for Linux here (writes are refused, tested), so
+ * the clock is kept as "counter + offset" and the offset lives in an SDAM cell, the same
+ * way sc8280xp-crd does it.  b600 is the battery-gauge SDAM: the vendor QG driver uses
+ * offsets 0x45..0xb3 (+0xbc), so 0xb4..0xb7 is free (the SDAM driver only exposes offsets up to 0xbf).
+ */
+&pm6150_lsid0 {
+	pm6150_sdam_6: nvram@b600 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0xb600>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0 0xb600 0x100>;
+
+		rtc_offset: rtc-offset@b4 {
+			reg = <0xb4 0x4>;
+		};
+	};
+};
+
+&pm6150_rtc {
+	nvmem-cells = <&rtc_offset>;
+	nvmem-cell-names = "offset";
+	status = "okay";
+};
+
+/*
+ * Vibrator: PM6150's vibrator LDO at SPMI 0x5300.  The mainline pm8xxx-vibrator
+ * driver's pmi632 register set matches this block exactly (EN_CTL 0x46 BIT7,
+ * VSET 0x40/0x41, 1504-3544 mV in 8 mV steps), and pm6150.dtsi keeps the node
+ * disabled by default, so enable it here and let the header's pmi632 data drive
+ * it.  Presents an evdev force-feedback (rumble) device that feedbackd uses for
+ * haptics.
+ */
+&pm6150_vib {
+	status = "okay";
+};
+
+#include "violet-sm6150-camera.dtsi"
