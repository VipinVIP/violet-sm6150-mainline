@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Dongwoon DW9800 VCM (autofocus actuator) driver, 10-bit DAC.
+ *
+ * Register layout is the DW9807 one: 0x02 control (bit0 = power down),
+ * 0x03/0x04 position MSB/LSB.  Chip ID register 0x00 reads 0xf2.
+ * Violet's rear module has it at CCI1 0x0c, supplied by pm6150_l19.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+
+#define DW9800_MAX_FOCUS_POS	1023
+#define DW9800_RAMP_STEP	16
+#define DW9800_RAMP_DELAY_US	1000
+
+#define DW9800_ID_ADDR		0x00
+#define DW9800_ID_VAL		0xf2
+#define DW9800_CTL_ADDR		0x02
+#define DW9800_CTL_PD		0x01
+#define DW9800_MSB_ADDR		0x03
+
+struct dw9800 {
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_subdev sd;
+	struct regulator *vaf;
+	u16 pos;
+};
+
+static inline struct dw9800 *to_dw9800(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct dw9800, sd);
+}
+
+static int dw9800_set_dac(struct i2c_client *client, u16 pos)
+{
+	const u8 buf[3] = { DW9800_MSB_ADDR, (pos >> 8) & 0x03, pos & 0xff };
+	int ret = i2c_master_send(client, buf, sizeof(buf));
+
+	return ret < 0 ? ret : 0;
+}
+
+/* Move in small steps so the lens does not ring or click. */
+static void dw9800_ramp(struct i2c_client *client, int from, int to)
+{
+	int step = to > from ? DW9800_RAMP_STEP : -DW9800_RAMP_STEP;
+	int v;
+
+	for (v = from + step; step > 0 ? v < to : v > to; v += step) {
+		dw9800_set_dac(client, v);
+		usleep_range(DW9800_RAMP_DELAY_US, DW9800_RAMP_DELAY_US + 100);
+	}
+	dw9800_set_dac(client, to);
+}
+
+static int dw9800_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct dw9800 *vcm = container_of(ctrl->handler, struct dw9800, ctrls);
+	struct i2c_client *client = v4l2_get_subdevdata(&vcm->sd);
+	int ret;
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	ret = dw9800_set_dac(client, ctrl->val);
+	if (!ret)
+		vcm->pos = ctrl->val;
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops dw9800_ctrl_ops = {
+	.s_ctrl = dw9800_set_ctrl,
+};
+
+static const struct v4l2_subdev_ops dw9800_ops = { };
+
+static int dw9800_probe(struct i2c_client *client)
+{
+	struct dw9800 *vcm;
+	u8 reg = DW9800_ID_ADDR, id = 0;
+	int ret;
+
+	vcm = devm_kzalloc(&client->dev, sizeof(*vcm), GFP_KERNEL);
+	if (!vcm)
+		return -ENOMEM;
+
+	vcm->vaf = devm_regulator_get_optional(&client->dev, "vaf");
+	if (IS_ERR(vcm->vaf)) {
+		if (PTR_ERR(vcm->vaf) != -ENODEV)
+			return PTR_ERR(vcm->vaf);
+		vcm->vaf = NULL;
+	}
+	if (vcm->vaf) {
+		ret = regulator_enable(vcm->vaf);
+		if (ret)
+			return ret;
+		usleep_range(5000, 6000);
+	}
+
+	if (i2c_master_send(client, &reg, 1) == 1 &&
+	    i2c_master_recv(client, &id, 1) == 1 && id != DW9800_ID_VAL)
+		dev_warn(&client->dev, "unexpected chip id 0x%02x\n", id);
+
+	/* leave power-down; the lens stays where the chip reset it */
+	{
+		const u8 buf[2] = { DW9800_CTL_ADDR, 0x00 };
+
+		ret = i2c_master_send(client, buf, sizeof(buf));
+		if (ret < 0)
+			goto err_reg;
+	}
+
+	v4l2_i2c_subdev_init(&vcm->sd, client, &dw9800_ops);
+	vcm->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+
+	v4l2_ctrl_handler_init(&vcm->ctrls, 1);
+	v4l2_ctrl_new_std(&vcm->ctrls, &dw9800_ctrl_ops, V4L2_CID_FOCUS_ABSOLUTE,
+			  0, DW9800_MAX_FOCUS_POS, 1, 512);
+	vcm->pos = 512;
+	vcm->sd.ctrl_handler = &vcm->ctrls;
+	if (vcm->ctrls.error) {
+		ret = vcm->ctrls.error;
+		goto err_ctrl;
+	}
+
+	vcm->sd.entity.function = MEDIA_ENT_F_LENS;
+	ret = media_entity_pads_init(&vcm->sd.entity, 0, NULL);
+	if (ret < 0)
+		goto err_ctrl;
+
+	ret = v4l2_async_register_subdev(&vcm->sd);
+	if (ret < 0)
+		goto err_entity;
+
+	dev_info(&client->dev, "DW9800 VCM registered\n");
+	return 0;
+
+err_entity:
+	media_entity_cleanup(&vcm->sd.entity);
+err_ctrl:
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+err_reg:
+	if (vcm->vaf)
+		regulator_disable(vcm->vaf);
+	return ret;
+}
+
+static void dw9800_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct dw9800 *vcm = to_dw9800(sd);
+	const u8 pd[2] = { DW9800_CTL_ADDR, DW9800_CTL_PD };
+
+	v4l2_async_unregister_subdev(&vcm->sd);
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+	media_entity_cleanup(&vcm->sd.entity);
+
+	dw9800_ramp(client, vcm->pos, 0);
+	i2c_master_send(client, pd, sizeof(pd));
+	if (vcm->vaf)
+		regulator_disable(vcm->vaf);
+}
+
+static const struct of_device_id dw9800_of_table[] = {
+	{ .compatible = "dongwoon,dw9800" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dw9800_of_table);
+
+static const struct i2c_device_id dw9800_id_table[] = {
+	{ "dw9800" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, dw9800_id_table);
+
+static struct i2c_driver dw9800_i2c_driver = {
+	.driver = {
+		.name = "dw9800",
+		.of_match_table = dw9800_of_table,
+	},
+	.probe = dw9800_probe,
+	.remove = dw9800_remove,
+	.id_table = dw9800_id_table,
+};
+module_i2c_driver(dw9800_i2c_driver);
+
+MODULE_DESCRIPTION("DW9800 VCM driver");
+MODULE_LICENSE("GPL");
