+static const char * const s5k5e8_supply_names[] = { "dovdd", "avdd", "dvdd" };
+
+struct s5k5e8 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct clk *inclk;
