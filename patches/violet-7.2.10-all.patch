+/**
+ * to_imx586() - imx586 V4L2 sub-device to imx586 device.
+ * @subdev: pointer to imx586 V4L2 sub-device
+ *
+ * Return: pointer to imx586 device
+ */
+static inline struct imx586 *to_imx586(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct imx586, sd);
+}
+
+/**
+ * imx586_read_reg() - Read registers.
+ * @imx586: pointer to imx586 device
+ * @reg: register address
+ * @len: length of bytes to read. Max supported bytes is 4
+ * @val: pointer to register value to be filled.
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_read_reg(struct imx586 *imx586, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx586->sd);
+	struct i2c_msg msgs[2] = {0};
+	u8 addr_buf[2] = {0};
+	u8 data_buf[4] = {0};
+	int ret;
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, addr_buf);
+
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = ARRAY_SIZE(addr_buf);
+	msgs[0].buf = addr_buf;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_buf[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = get_unaligned_be32(data_buf);
+
+	return 0;
+}
+
+/**
+ * imx586_write_reg() - Write register
+ * @imx586: pointer to imx586 device
+ * @reg: register address
+ * @len: length of bytes. Max supported bytes is 4
+ * @val: register value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_write_reg(struct imx586 *imx586, u16 reg, u32 len, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx586->sd);
+	u8 buf[6] = {0};
+
+	if (WARN_ON(len > 4))
+		return -EINVAL;
+
+	put_unaligned_be16(reg, buf);
+	put_unaligned_be32(val << (8 * (4 - len)), buf + 2);
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/**
+ * imx586_write_regs() - Write a list of registers
+ * @imx586: pointer to imx586 device
+ * @regs: list of registers to be written
+ * @len: length of registers array
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_write_regs(struct imx586 *imx586,
+			     const struct imx586_reg *regs, u32 len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = imx586_write_reg(imx586, regs[i].address, 1, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * imx586_update_controls() - Update control ranges based on streaming mode
+ * @imx586: pointer to imx586 device
+ * @mode: pointer to imx586_mode sensor mode
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_update_controls(struct imx586 *imx586,
+				  const struct imx586_mode *mode)
+{
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx586->link_freq_ctrl, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx586->hblank_ctrl, mode->hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx586->vblank_ctrl, mode->vblank_min,
+					mode->vblank_max, 1, mode->vblank);
+}
+
+/**
+ * imx586_update_exp_gain() - Set updated exposure and gain
+ * @imx586: pointer to imx586 device
+ * @exposure: updated exposure value
+ * @gain: updated analog gain value
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_update_exp_gain(struct imx586 *imx586, u32 exposure, u32 gain)
+{
+	u32 lpfr;
+	int ret;
+
+	lpfr = imx586->vblank + imx586->cur_mode->height;
+
+	dev_dbg(imx586->dev, "Set exp %u, analog gain %u, lpfr %u\n",
+		exposure, gain, lpfr);
+
+	ret = imx586_write_reg(imx586, IMX586_REG_HOLD, 1, 1);
+	if (ret)
+		return ret;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_LPFR, 2, lpfr);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_EXPOSURE_CIT, 2, exposure);
+	if (ret)
+		goto error_release_group_hold;
+
+	ret = imx586_write_reg(imx586, IMX586_REG_AGAIN, 2, gain);
+
+error_release_group_hold:
+	imx586_write_reg(imx586, IMX586_REG_HOLD, 1, 0);
+
+	return ret;
+}
+
+static int imx586_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx586 *imx586 =
+		container_of(ctrl->handler, struct imx586, ctrl_handler);
+	u32 analog_gain;
+	u32 exposure;
+	int ret;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		imx586->vblank = imx586->vblank_ctrl->val;
+
+		dev_dbg(imx586->dev, "Received vblank %u, new lpfr %u\n",
+			imx586->vblank,
+			imx586->vblank + imx586->cur_mode->height);
+
+		ret = __v4l2_ctrl_modify_range(imx586->exp_ctrl,
+					       IMX586_EXPOSURE_MIN,
+					       imx586->vblank +
+					       imx586->cur_mode->height -
+					       IMX586_EXPOSURE_OFFSET,
+					       1, IMX586_EXPOSURE_DEFAULT);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* Set controls only if sensor is in power on state */
+		if (!pm_runtime_get_if_in_use(imx586->dev))
+			return 0;
+
+		exposure = ctrl->val;
+		analog_gain = imx586->again_ctrl->val;
+
+		dev_dbg(imx586->dev, "Received exp %u, analog gain %u\n",
+			exposure, analog_gain);
+
+		ret = imx586_update_exp_gain(imx586, exposure, analog_gain);
+
+		pm_runtime_put(imx586->dev);
+
+		break;
+	case V4L2_CID_CAMERA_ORIENTATION:
+	case V4L2_CID_CAMERA_SENSOR_ROTATION:
+		ret = 0;
+		break;
+	default:
+		dev_err(imx586->dev, "Invalid control %d\n", ctrl->id);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+/* V4l2 subdevice control ops*/
+static const struct v4l2_ctrl_ops imx586_ctrl_ops = {
+	.s_ctrl = imx586_set_ctrl,
+};
+
+static int imx586_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = supported_mode.code;
+
+	return 0;
+}
+
+static int imx586_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fsize)
+{
+	if (fsize->index > 0)
+		return -EINVAL;
+
+	if (fsize->code != supported_mode.code)
+		return -EINVAL;
+
+	fsize->min_width = supported_mode.width;
+	fsize->max_width = fsize->min_width;
+	fsize->min_height = supported_mode.height;
+	fsize->max_height = fsize->min_height;
+
+	return 0;
+}
+
+/**
+ * imx586_fill_pad_format() - Fill subdevice pad format
+ *                            from selected sensor mode
+ * @imx586: pointer to imx586 device
+ * @mode: pointer to imx586_mode sensor mode
+ * @fmt: V4L2 sub-device format need to be filled
+ */
+static void imx586_fill_pad_format(struct imx586 *imx586,
+				   const struct imx586_mode *mode,
+				   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = mode->code;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx586_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+
+	mutex_lock(&imx586->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		fmt->format = *framefmt;
+	} else {
+		imx586_fill_pad_format(imx586, imx586->cur_mode, fmt);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+}
+
+static int imx586_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	const struct imx586_mode *mode;
+	int ret = 0;
+
+	mutex_lock(&imx586->mutex);
+
+	mode = &supported_mode;
+	imx586_fill_pad_format(imx586, mode, fmt);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *framefmt;
+
+		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+		*framefmt = fmt->format;
+	} else {
+		ret = imx586_update_controls(imx586, mode);
+		if (!ret)
+			imx586->cur_mode = mode;
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+static int imx586_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* the 2x2 binned mode spans the whole 8000x6000 active array */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 8000;
+		sel->r.height = 6000;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx586_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	struct v4l2_subdev_format fmt = { 0 };
+
+	fmt.which = sd_state ? V4L2_SUBDEV_FORMAT_TRY : V4L2_SUBDEV_FORMAT_ACTIVE;
+	imx586_fill_pad_format(imx586, &supported_mode, &fmt);
+
+	return imx586_set_pad_format(sd, sd_state, &fmt);
+}
+
+/**
+ * imx586_start_streaming() - Start sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+/* SMIA-map init: 2x2 binned 4000x3000 RAW10, EXTCLK 24 MHz (PLL dividers doubled vs the 12 MHz power-on set). */
+static int imx586_smia_init(struct imx586 *imx586)
+{
+	int ret;
+
+	/* vendor order: init block, then the 4000x3000 mode block */
+	ret = imx586_write_regs(imx586, imx586_vendor_init, ARRAY_SIZE(imx586_vendor_init));
+	if (!ret)
+		ret = imx586_write_regs(imx586, imx586_vendor_4000x3000,
+					ARRAY_SIZE(imx586_vendor_4000x3000));
+	return ret;
+}
+
+static int imx586_start_streaming(struct imx586 *imx586)
+{
+	const struct imx586_reg_list *reg_list;
+	int ret;
+
+	if (smia) {
+		u32 fc = 0;
+		ret = imx586_smia_init(imx586);
+		if (ret)
+			return ret;
+		ret = __v4l2_ctrl_handler_setup(imx586->sd.ctrl_handler);
+		if (ret)
+			return ret;
+				usleep_range(7400, 8000);
+		ret = imx586_write_reg(imx586, 0x0100, 1, 0x01);
+		msleep(120);
+		imx586_read_reg(imx586, 0x0005, 1, &fc);
+		dev_info(imx586->dev, "smia stream-on ret=%d fcnt=%02x\n", ret, fc & 0xff);
+		return ret;
+	}
+
+	/* Write the common init set first (PLL, lanes, datarate, timing). */
+	ret = imx586_write_regs(imx586, mode_common_regs,
+				ARRAY_SIZE(mode_common_regs));
+	if (ret) {
+		dev_err(imx586->dev, "fail to write common registers\n");
+		return ret;
+	}
+	dev_info(imx586->dev, "wrote %zu common regs\n",
+		 ARRAY_SIZE(mode_common_regs));
+
+	/* Write sensor mode registers */
+	reg_list = &imx586->cur_mode->reg_list;
+	ret = imx586_write_regs(imx586, reg_list->regs,
+				reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx586->dev, "fail to write initial registers\n");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx586->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx586->dev, "fail to setup handler\n");
+		return ret;
+	}
+
+	/* Delay is required before streaming*/
+	usleep_range(7400, 8000);
+
+	/* Start streaming */
+	ret = imx586_write_reg(imx586, IMX586_REG_MODE_SELECT,
+			       1, IMX586_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx586->dev, "fail to start streaming\n");
+		return ret;
+	}
+	{
+		u32 v = 0;
+		int r2 = imx586_read_reg(imx586, IMX586_REG_MODE_SELECT, 1, &v);
+		{
+			u32 a = 0, b = 0, c = 0, d = 0;
+			imx586_read_reg(imx586, 0x3014, 1, &a);
+			imx586_read_reg(imx586, 0x3040, 1, &b);
+			imx586_read_reg(imx586, 0x3028, 2, &c);
+			imx586_read_reg(imx586, 0x302c, 2, &d);
+			dev_info(imx586->dev,
+				 "stream on: %u regs, 0x3000=%02x 0x3014=%02x 0x3040=%02x VMAX=%04x HMAX=%04x\n",
+				 reg_list->num_of_regs, v & 0xff, a & 0xff, b & 0xff,
+				 c & 0xffff, d & 0xffff);
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * imx586_stop_streaming() - Stop sensor stream
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_stop_streaming(struct imx586 *imx586)
+{
+	return imx586_write_reg(imx586, smia ? 0x0100 : IMX586_REG_MODE_SELECT,
+				1, smia ? 0 : IMX586_MODE_STANDBY);
+}
+
+static int imx586_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	mutex_lock(&imx586->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx586->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx586_start_streaming(imx586);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx586_stop_streaming(imx586);
+		pm_runtime_put(imx586->dev);
+	}
+
+	mutex_unlock(&imx586->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx586->dev);
+error_unlock:
+	mutex_unlock(&imx586->mutex);
+
+	return ret;
+}
+
+/**
+ * imx586_detect() - Detect imx586 sensor
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+
+
+static int imx586_detect(struct imx586 *imx586)
+{
+	int ret;
+	u32 val;
+
+	ret = imx586_read_reg(imx586, IMX586_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX586_ID) {
+		dev_err(imx586->dev, "chip id mismatch: %x!=%x\n",
+			IMX586_ID, val);
+		return -ENXIO;
+	}
+
+	dev_info(imx586->dev, "IMX586 detected (id %04x)\n", val);
+	return 0;
+}
+
+/**
+ * imx586_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_parse_hw_config(struct imx586 *imx586)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx586->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* Request optional reset pin */
+	imx586->reset_gpio = devm_gpiod_get_optional(imx586->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	imx586->aux_gpio = devm_gpiod_get_index_optional(imx586->dev,
+							"camtest", 0,
+							GPIOD_OUT_HIGH);
+	if (IS_ERR(imx586->reset_gpio)) {
+		dev_err(imx586->dev, "failed to get reset gpio %pe\n",
+			imx586->reset_gpio);
+		return PTR_ERR(imx586->reset_gpio);
+	}
+
+	/* Get sensor input clock */
+	imx586->inclk = devm_v4l2_sensor_clk_get(imx586->dev, NULL);
+	if (IS_ERR(imx586->inclk))
+		return dev_err_probe(imx586->dev, PTR_ERR(imx586->inclk),
+				     "could not get inclk\n");
+
+	rate = clk_get_rate(imx586->inclk);
+	if (rate != IMX586_INCLK_RATE) {
+		dev_err(imx586->dev, "inclk frequency mismatch\n");
+		return -EINVAL;
+	}
+
+	/* Get optional DT defined regulators */
+	for (i = 0; i < ARRAY_SIZE(imx586_supply_names); i++)
+		imx586->supplies[i].supply = imx586_supply_names[i];
+
+	ret = devm_regulator_bulk_get(imx586->dev,
+				      ARRAY_SIZE(imx586_supply_names),
+				      imx586->supplies);
+	if (ret)
+		return ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 2 && bus_cfg.bus.mipi_csi2.num_data_lanes != 4) {
+		dev_err(imx586->dev,
+			"number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx586->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX586_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx586_video_ops = {
+	.s_stream = imx586_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx586_pad_ops = {
+	.enum_mbus_code = imx586_enum_mbus_code,
+	.enum_frame_size = imx586_enum_frame_size,
+	.get_fmt = imx586_get_pad_format,
+	.set_fmt = imx586_set_pad_format,
+	.get_selection = imx586_get_selection,
+};
+
+static const struct v4l2_subdev_ops imx586_subdev_ops = {
+	.video = &imx586_video_ops,
+	.pad = &imx586_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx586_internal_ops = {
+	.init_state = imx586_init_state,
+};
+
+static int imx586_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+	int ret;
+
+	/*
+	 * violet recipe (measured on the phone): XCLR asserted, rails in the
+	 * order AVDD -> DOVDD -> DVDD with ~1 ms between them, MCLK on, then
+	 * XCLR released and 20 ms of settle before the first I2C access.
+	 * imx412's order (rails, XCLR released, clock) never gets an ACK here.
+	 */
+	gpiod_set_value_cansleep(imx586->reset_gpio, 1);
+	if (!IS_ERR_OR_NULL(imx586->aux_gpio))
+		gpiod_set_value_cansleep(imx586->aux_gpio, 1);
+	msleep(20);
+
+	ret = regulator_enable(imx586->supplies[1].consumer); /* avdd */
+	if (ret)
+		return ret;
+	usleep_range(1000, 2000);
+	ret = regulator_enable(imx586->supplies[0].consumer); /* dovdd */
+	if (ret)
+		goto err_avdd;
+	usleep_range(1000, 2000);
+	ret = regulator_enable(imx586->supplies[2].consumer); /* dvdd */
+	if (ret)
+		goto err_dovdd;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx586->inclk);
+	if (ret) {
+		dev_err(imx586->dev, "fail to enable inclk\n");
+		goto err_dvdd;
+	}
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(imx586->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_dvdd:
+	regulator_disable(imx586->supplies[2].consumer);
+err_dovdd:
+	regulator_disable(imx586->supplies[0].consumer);
+err_avdd:
+	regulator_disable(imx586->supplies[1].consumer);
+	return ret;
+}
+
+static int imx586_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	clk_disable_unprepare(imx586->inclk);
+	gpiod_set_value_cansleep(imx586->reset_gpio, 1);
+	regulator_disable(imx586->supplies[0].consumer);
+	regulator_disable(imx586->supplies[1].consumer);
+	regulator_disable(imx586->supplies[2].consumer);
+
+	return 0;
+}
+
+/**
+ * imx586_init_controls() - Initialize sensor subdevice controls
+ * @imx586: pointer to imx586 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx586_init_controls(struct imx586 *imx586)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx586->ctrl_handler;
+	const struct imx586_mode *mode = imx586->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx586->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx586->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx586_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX586_EXPOSURE_MIN,
+					     lpfr - IMX586_EXPOSURE_OFFSET,
+					     IMX586_EXPOSURE_STEP,
+					     IMX586_EXPOSURE_DEFAULT);
+
+	imx586->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx586_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX586_AGAIN_MIN,
+					       IMX586_AGAIN_MAX,
+					       IMX586_AGAIN_STEP,
+					       IMX586_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx586->exp_ctrl);
+
+	imx586->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx586->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx586_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx586->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx586_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx586->link_freq_ctrl)
+		imx586->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx586->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx586_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX586_REG_MIN,
+						IMX586_REG_MAX,
+						1, mode->hblank);
+	if (imx586->hblank_ctrl)
+		imx586->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = v4l2_fwnode_device_parse(imx586->dev, &props);
+	if (!ret)
+		v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx586_ctrl_ops, &props);
+
+	if (ctrl_hdlr->error) {
+		dev_err(imx586->dev, "control init failed: %d\n",
+			ctrl_hdlr->error);
+		v4l2_ctrl_handler_free(ctrl_hdlr);
+		return ctrl_hdlr->error;
+	}
+
+	imx586->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+}
+
+static int imx586_probe(struct i2c_client *client)
+{
+	struct imx586 *imx586;
+	const char *name;
+	int ret;
+
+	imx586 = devm_kzalloc(&client->dev, sizeof(*imx586), GFP_KERNEL);
+	if (!imx586)
+		return -ENOMEM;
+
+	imx586->dev = &client->dev;
+	name = device_get_match_data(&client->dev);
+	if (!name)
+		return -ENODEV;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx586->sd, client, &imx586_subdev_ops);
+	imx586->sd.internal_ops = &imx586_internal_ops;
+
+	ret = imx586_parse_hw_config(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "HW configuration is not supported\n");
+		return ret;
+	}
+
+	mutex_init(&imx586->mutex);
+
+	ret = imx586_power_on(imx586->dev);
+	if (ret) {
+		dev_err(imx586->dev, "failed to power-on the sensor\n");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx586_detect(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to find sensor: %d\n", ret);
+		goto error_power_off;
+	}
+
+	if (smia_test) {
+		u32 v[8] = {0};
+		int e;
+		imx586_read_reg(imx586, 0x0005, 1, &v[0]);
+		imx586_read_reg(imx586, 0x0114, 1, &v[1]);
+		imx586_read_reg(imx586, 0x0136, 1, &v[2]);
+		imx586_read_reg(imx586, 0x0137, 1, &v[3]);
+		imx586_read_reg(imx586, 0x0100, 1, &v[4]);
+		dev_info(imx586->dev, "SMIA pre: fcnt(0005)=%02x lanes(0114)=%02x extclk(0136/7)=%02x%02x mode(0100)=%02x\n",
+			 v[0] & 0xff, v[1] & 0xff, v[2] & 0xff, v[3] & 0xff, v[4] & 0xff);
+		e = imx586_write_reg(imx586, 0x0100, 1, 0x01);
+		msleep(100);
+		imx586_read_reg(imx586, 0x0005, 1, &v[5]);
+		msleep(100);
+		imx586_read_reg(imx586, 0x0005, 1, &v[6]);
+		imx586_read_reg(imx586, 0x0100, 1, &v[7]);
+		dev_info(imx586->dev, "SMIA stream-on(0100=01) w=%d: fcnt +100ms=%02x +200ms=%02x mode=%02x\n",
+			 e, v[5] & 0xff, v[6] & 0xff, v[7] & 0xff);
+		{
+			static const u16 rr[] = {0x0112,0x0113,0x0114,0x0301,0x0303,0x0305,0x0306,0x0307,0x0309,0x030b,0x030d,0x030e,0x030f,0x0340,0x0341,0x0342,0x0343,0x0344,0x0345,0x0346,0x0347,0x0348,0x0349,0x034a,0x034b,0x034c,0x034d,0x034e,0x034f,0x0900,0x0901};
+			char b[31*8]; int n = 0, i; u32 x;
+			for (i = 0; i < ARRAY_SIZE(rr); i++) {
+				x = 0; imx586_read_reg(imx586, rr[i], 1, &x);
+				n += scnprintf(b + n, sizeof(b) - n, "%04x=%02x ", rr[i], x & 0xff);
+			}
+			dev_info(imx586->dev, "SMIA defaults: %s\n", b);
+		}
+		imx586_write_reg(imx586, 0x0100, 1, 0x00);
+	}
+
+	/* Set default mode to max resolution */
+	/* optional binned mode for bring-up tests */
+	if (use_binned) {
+		supported_mode.width = 1928;
+		supported_mode.height = 1090;
+		supported_mode.reg_list.num_of_regs = ARRAY_SIZE(mode_1080_regs);
+		supported_mode.reg_list.regs = mode_1080_regs;
+		dev_info(imx586->dev, "using 2x2 binned 1928x1090 mode\n");
+	}
+	if (smia) {
+		supported_mode.width = 4000;
+		supported_mode.height = 3000;
+	}
+	imx586->cur_mode = &supported_mode;
+	imx586->vblank = imx586->cur_mode->vblank;
+
+	ret = imx586_init_controls(imx586);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init controls: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx586->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx586->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	v4l2_i2c_subdev_set_name(&imx586->sd, client, name, NULL);
+
+	/* Initialize source pad */
+	imx586->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx586->sd.entity, 1, &imx586->pad);
+	if (ret) {
+		dev_err(imx586->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx586->sd);
+	if (ret < 0) {
+		dev_err(imx586->dev,
+			"failed to register async subdev: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(imx586->dev);
+	pm_runtime_enable(imx586->dev);
+	pm_runtime_idle(imx586->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx586->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx586->sd.ctrl_handler);
+error_power_off:
+	imx586_power_off(imx586->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx586->mutex);
+
+	return ret;
+}
+
+static void imx586_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx586 *imx586 = to_imx586(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx586_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx586->mutex);
+}
+
+static const struct dev_pm_ops imx586_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx586_power_off, imx586_power_on, NULL)
+};
+
+static const struct of_device_id imx586_of_match[] = {
+	{ .compatible = "sony,imx586", .data = "imx586" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx586_of_match);
+
+static struct i2c_driver imx586_driver = {
+	.probe = imx586_probe,
+	.remove = imx586_remove,
+	.driver = {
+		.name = "imx586",
+		.pm = &imx586_pm_ops,
+		.of_match_table = imx586_of_match,
+	},
+};
+
+module_i2c_driver(imx586_driver);
+
+MODULE_DESCRIPTION("Sony imx586 sensor driver");
+MODULE_LICENSE("GPL");
