+#define OV13855_ID_REG		0x300b
+#define OV13855_ID		0xd855
+#define OV13855_INCLK_RATE	24000000
+#define OV13855_LINK_FREQ		360000000
+#define OV13855_LANES		4
+#define OV13855_WIDTH		2112
+#define OV13855_HEIGHT		1568
+/*
+ * Frame length from the vendor mode table (0x380e/0x380f = 0x0c8e = 3214 lines,
+ * i.e. 30 fps). 0x380e is rewritten from the VBLANK control at stream start, so
+ * this default is what actually runs. A shorter frame length (e.g. 82 -> 1650
+ * lines, ~60 fps) clamps the max exposure (VTS - 8) to half a frame and costs a
+ * full stop of light; that is why the front camera looked very dark.
+ */
+#define OV13855_VBLANK_DEFAULT	(0x0c8e - OV13855_HEIGHT)
+/*
+ * Analogue gain in the sensor's 8.8 fixed point format: 0x0100 = 1x. Measured on
+ * violet: 0x07c0 (7.75x) is the real ceiling - writing 0x0f80 (15.5x) changes
+ * nothing in the captured signal, so the range deliberately stops at 1984.
+ */
+#define OV13855_GAIN_DEFAULT	256
+#define OV13855_GAIN_MAX	1984
+
+struct ov13855_reg { u16 address; u8 val; };
