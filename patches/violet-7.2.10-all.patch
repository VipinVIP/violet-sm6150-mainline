+/*
+ * USB (peripheral only).  violet wires the high-speed QUSB2 PHY alone: the vendor
+ * tree sets maximum-speed = "high-speed" and disables usb_qmp_phy.  Supplies are the
+ * vendor's: vdd = pm6150 L4, vdda18 = L11, vdda33 = L17.
+ */
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l4a_0p8>;
+	vdda-pll-supply = <&vreg_l11a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l17a_3p0>;
+
+	status = "okay";
+};
+
+&usb_1 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+/*
+ * Probing aggre1_noc hangs the CPU on its first QoS register write (kexec test, run 9-10:
+ * PROBE-START 1700000.interconnect never returns).  With no clocks the driver skips QoS
+ * programming (qos_requires_clocks), which is what we want: the bootloader/downstream
+ * already configured QoS, and Linux writes to these registers are not safe on this firmware.
+ */
+&aggre1_noc {
+	/delete-property/ clocks;
+};
+
+/* TZ-protected pins found by tlmm-bisect.sh (reads hang the CPU) */
+&tlmm {
+	gpio-reserved-ranges = <0 4>;
+};
+
+
+/*
+ * TrustZone PAS (zap shader) authentication needs a DDR bandwidth vote on behalf of the
+ * crypto engine: the downstream pil-tz does scm_pas_enable_bw() before PAS_INIT_IMAGE, and
+ * without it TZ returns 0xffcfffbb (-3145797) -> -EINVAL.  Mainline models that vote as the
+ * scm node's interconnect path.
+ */
+&{/firmware/scm} {
+	interconnects = <&aggre1_noc MASTER_CRYPTO QCOM_ICC_TAG_ALWAYS
+			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+};
+
+/*
+ * Display: DPU -> DSI0 (4 lanes, video mode) -> Novatek NT36672A "shenchao" panel.
+ *
+ * The panel's AVDD/AVEE come from the PM6150L LCDB (one module enable; the voltages
+ * stay as programmed by the bootloader).  Backlight is the PM6150L WLED.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	/* DSI controller analog rail is PM6150L L3 (vendor "vdda-1p2", 1.232 V); L4A is the PHY's */
+	vdda-supply = <&vreg_l3e_1p2>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "novatek,nt36672a-shenchao";
+		reg = <0>;
+
+		vddi-supply = <&vreg_l13a_1p8>;
+		avdd-supply = <&pm6150l_lcdb>;
+		avee-supply = <&pm6150l_lcdb>;
+
+		reset-gpios = <&tlmm 91 GPIO_ACTIVE_HIGH>;
+		backlight = <&pm6150l_wled>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <1 2 3 0>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l4a_0p8>;
+
+	status = "okay";
+};
+
+&pm6150l_wled {
+	qcom,current-limit-microamp = <25000>;
+	qcom,cabc;
+
+	status = "okay";
+};
+
+&pm6150l_lsid5 {
+	/* LCD bias: the panel's AVDD/AVEE.  r10 switches it off before kexec. */
+	pm6150l_lcdb: regulator@ec00 {
+		compatible = "qcom,pm6150l-lcdb";
+		reg = <0xec00>;
+		regulator-name = "lcdb";
+	};
+};
+
+/*
+ * TEST VARIANT - NOT FOR UPSTREAM.
+ * Keeps only the plain cluster power-collapse state (0x41000044, the param every
+ * sibling SoC uses: sm7150 and sm6115 both declare it) and drops the two Qualcomm
+ * AOSS/CX sleep-set levels inherited from talos.dtsi:
+ *   cluster_sleep_1 = 0x41001344  (CX retention)
+ *   cluster_sleep_2 = 0x4100b344  (AOSS sleep; sm7150 uses 0x4100b244)
+ * Those nibbles encode an RPMh/AOSS sleep-set index that must exist in this board's
+ * firmware.  If it does not, the cluster is voted off and never comes back - which is
+ * the CPU7-disappears / RCU-stall signature.  Precedent: the MSM8917/8937 fixes
+ * shallow the cluster state (0x41000053 -> 0x41000043) for exactly this reason.
+ */
+&cluster_pd { /delete-property/ domain-idle-states; };
+&cluster_pd { domain-idle-states = <&cluster_sleep_0>; };
