+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi Note 7 Pro (violet)
+ *
+ * SM6150 / Snapdragon 675 — internal MSM codename "Talos", which is the name
+ * mainline uses for this SoC (shared with QCS615).  So the SoC description is
+ * arch/arm64/boot/dts/qcom/talos.dtsi and this file only has to describe the
+ * *board*.
+ *
+ * Status (mainline 7.2.10, booted via kexec from the downstream kernel):
+ *   [x] reserved memory (ramoops console, GPU PIL region)
+ *   [x] console on uart0, eMMC, USB peripheral (high-speed only, QUSB2 PHY)
+ *   [x] GPU: Adreno 612 renders (RGMU, zap shader), needs
+ *       msm.separate_gpu_kms=1 (keeps the GPU a separate DRM device)
+ *   [~] PMIC rails: values from the vendor tables, only consumers modelled
+ *   [x] display chain: DSI PHY + NT36672A "shenchao" panel + WLED probe, DSI-1 connected
+ *       1080x2340, fb0 present; actual picture unverified (panel is physically broken)
+ *   [ ] touchscreen, USB type-C, audio, camera, sensors, modem, wifi
+ *
+ * TZ/xPU quirks that shaped this file: the first four TLMM pins and the QoS
+ * registers of aggre1_noc hang the CPU when touched (see the notes at the
+ * bottom), and Linux must not enable the TZ SHM bridge on this SoC.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+#include "talos.dtsi"
+#include "pm6150.dtsi"
+#include "pm6150l.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Note 7 Pro";
+	compatible = "xiaomi,violet", "qcom,sm6150";
+	chassis-type = "handset";
+
+	/*
+	 * The bootloader supplies and fills RAM.  Two measured facts:
+	 *  - the vendor DTB that boots has a node named exactly "memory" (NO unit
+	 *    address) with a zero/placeholder size, and ABL fills it in.
+	 *  - mainline's talos.dtsi names it "memory@80000000" and comments
+	 *    "We expect the bootloader to fill in the size" -- the u-boot convention.
+	 * ABL looks the node up by NAME, so "memory@80000000" is not found and
+	 * neither is no node at all: both make it refuse the image.  Measured:
+	 *  - zero-size memory@80000000  -> refused
+	 *  - no memory node at all      -> refused
+	 * So use the vendor's exact name and let ABL fill it.
+	 */
+	/delete-node/ memory@80000000;
+
+	memory {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0>;
+	};
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &sdhc_1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * talos.dtsi references both of these; the board has to provide them.
+	 * The standard SM6150 pair, exactly as the QCS615 EVK declares them.
+	 */
+	clocks {
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board_clk: xo-board-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+};
+
+/*
+ * violet's OWN reserved-memory map.  The QCS615 EVK puts pil_gpu_mem at
+ * 0x97715000; violet's is at 0x97115000, so the SoC node has to be overridden
+ * (a wrong address here hands the zap/GPU region over to the allocator).
+ * The remaining remoteproc regions follow in later iterations.
+ */
+&{/reserved-memory} {
+	/delete-node/ pil-gpu@97715000;
+
+	ramoops: ramoops@a1600000 {
+		compatible = "ramoops";
+		reg = <0x0 0xa1600000 0x0 0x800000>;
+		console-size = <0x400000>;
+		pmsg-size = <0x400000>;
+	};
+
+	pil_gpu_mem: pil-gpu@97115000 {
+		reg = <0x0 0x97115000 0x0 0x2000>;
+		no-map;
+	};
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * Nodes this device's bootloader patches BY NAME.
+ *
+ * Qualcomm ABL edits the boot image's DTB on every boot: it fills the memory
+ * map, records "removed" memory, writes the Android firmware metadata and the
+ * imem fields.  Violet's vendor DTB -- the one ABL actually boots -- carries all
+ * of these; mainline's soc DTS does not.  Measured: with the arm64 header fully
+ * matched, __symbols__ present and a dtbo that applies cleanly, ABL still
+ * refuses our DTB, which is why the missing vendor nodes are the prime suspect.
+ *
+ * Names, compatible strings and addresses are copied verbatim from violet's own
+ * vendor DTB (read back off the device).  Regions that mainline's talos.dtsi
+ * already declares under a different name are left alone: an extra reservation
+ * costs a little RAM and is harmless, while a missing node ABL expects is fatal.
+ * ---------------------------------------------------------------------------
+ */
+&{/reserved-memory} {
+	hyp_region@85700000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85700000 0x0 0x600000>;
+	};
+
+	xbl_aop_mem@85e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85e00000 0x0 0x140000>;
+	};
+
+	sec_apps_region@85fff000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x85fff000 0x0 0x1000>;
+	};
+
+	/* ABL keeps its "removed memory" record here; 45 MB, the largest gap */
+	removed_region@86200000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x86200000 0x0 0x2d00000>;
+	};
+
+	camera_region@8ab00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8ab00000 0x0 0x500000>;
+	};
+
+	modem_region@8b000000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x8b000000 0x0 0x7e00000>;
+	};
+
+	video_region@92e00000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x92e00000 0x0 0x500000>;
+	};
+
+	wlan_msa_mem@93300000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x93300000 0x0 0x200000>;
+	};
+
+	cdsp_region@93500000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x93500000 0x0 0x1e00000>;
+	};
+
+	adsp_region@95300000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x95300000 0x0 0x1e00000>;
+	};
+
+	ipa_fw_region@97100000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x97100000 0x0 0x10000>;
+	};
+
+	ipa_gsi_region@97110000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x97110000 0x0 0x5000>;
+	};
+
+	qseecom_region@9e400000 {
+		compatible = "shared-dma-pool";
+		no-map;
+		reg = <0x0 0x9e400000 0x0 0x1400000>;
+	};
+
+	cdsp_sec_mem@9f800000 {
+		compatible = "removed-dma-pool";
+		no-map;
+		reg = <0x0 0x9f800000 0x0 0x1e00000>;
+	};
+
+	cont_splash_region@9c000000 {
+		reg = <0x0 0x9c000000 0x0 0xf00000>;
+	};
+
+	dfps_data_region@9d000000 {
+		reg = <0x0 0x9d000000 0x0 0x100000>;
+	};
+
+	disp_rdump_region@9d100000 {
+		reg = <0x0 0x9d100000 0x0 0x1000000>;
+	};
+};
+
+/*
+ * imem: mainline declares sram@14680000; violet's is qcom,msm-imem@146aa000 and
+ * the vendor DTB exposes the sub-blocks ABL and the Android bootloader use
+ * (restart reason, boot stats, KASLR offset, the PIL/dload scratch areas).
+ */
+&soc {
+	qcom_msm_imem: imem@146aa000 {
+		compatible = "qcom,msm-imem";
+		/* mainline's /soc is 2 address + 2 size cells */
+		reg = <0x0 0x146aa000 0x0 0x1000>;
+		ranges = <0x0 0x0 0x146aa000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		imem_mem_dump_table: mem_dump_table@10 {
+			compatible = "qcom,msm-imem-mem_dump_table";
+			reg = <0x10 0x8>;
+		};
+
+		imem_restart_reason: restart_reason@65c {
+			compatible = "qcom,msm-imem-restart_reason";
+			reg = <0x65c 0x4>;
