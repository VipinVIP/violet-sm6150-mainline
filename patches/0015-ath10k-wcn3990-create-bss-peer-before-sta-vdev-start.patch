ath10k: WCN3990: create the BSS peer before the station vdev start

WCN3990 HL3.x firmware answers a station vdev start with status -1 unless the BSS peer already exists (the same ordering rule ath11k applies for QCA6390) and rejects 0/0 beacon interval/DTIM. Create the peer in assign_vif_chanctx(), adopt it in sta_state, drop it when the vdev start fails or the context is unassigned.
2026-11-02: all experiment knobs (violet_* module params, retries, placeholder SSID, hexdump) removed.

--- a/drivers/net/wireless/ath/ath10k/mac.c
+++ b/drivers/net/wireless/ath/ath10k/mac.c
@@ -732,6 +732,36 @@
 	}
 }
 
+static int ath10k_peer_delete(struct ath10k *ar, u32 vdev_id, const u8 *addr);
+
+/* WCN3990 HL3.x refuses a station vdev start (status -1) unless the BSS peer
+ * already exists, so the peer is created before the vdev is started (see
+ * ath10k_mac_op_assign_vif_chanctx()); sta_state adopts it instead of creating a
+ * second one.  Remove it again if the vdev start fails or the context is unassigned.
+ */
+static void ath10k_drop_early_peer(struct ath10k *ar, struct ieee80211_vif *vif)
+{
+	struct ath10k_vif *arvif = (void *)vif->drv_priv;
+	struct ath10k_peer *peer;
+	u8 addr[ETH_ALEN];
+	bool found = false;
+
+	spin_lock_bh(&ar->data_lock);
+	list_for_each_entry(peer, &ar->peers, list) {
+		if (peer->vdev_id == arvif->vdev_id && !peer->sta) {
+			ether_addr_copy(addr, peer->addr);
+			found = true;
+			break;
+		}
+	}
+	spin_unlock_bh(&ar->data_lock);
+
+	if (found) {
+		ath10k_dbg(ar, ATH10K_DBG_MAC, "dropping early peer %pM on vdev %d\n", addr, arvif->vdev_id);
+		ath10k_peer_delete(ar, arvif->vdev_id, addr);
+	}
+}
