+/*
+ * violet: create a self peer (peer type DEFAULT, the vdev's own MAC) for station
+ * vdevs too.  The WCN3990 HL3.x firmware rejects the station vdev start
+ * ("vdev-start-response reports status error: -1") without it; Qualcomm's own
+ * host driver creates one for every vdev.
+ */
+static unsigned int violet_sta_self_peer = 3;
+module_param(violet_sta_self_peer, uint, 0644);
+
+static char *violet_peer_mac;
+module_param(violet_peer_mac, charp, 0644);
+
+static const u8 *violet_peer_addr(struct ieee80211_vif *vif)
+{
+	static u8 a[ETH_ALEN];
+
+	if (violet_peer_mac && mac_pton(violet_peer_mac, a))
+		return a;
+	return vif->addr;
+}
+
+static bool violet_blind_peer(struct ath10k_vif *arvif)
+{
+	return violet_sta_self_peer == 2 && arvif->vdev_type == WMI_VDEV_TYPE_STA &&
+	       arvif->vdev_subtype == WMI_VDEV_SUBTYPE_NONE;
+}
+
+static bool violet_self_peer(struct ath10k_vif *arvif)
+{
+	if (arvif->vdev_type == WMI_VDEV_TYPE_AP ||
+	    arvif->vdev_type == WMI_VDEV_TYPE_IBSS)
+		return true;
+
+	return violet_sta_self_peer == 1 && arvif->vdev_type == WMI_VDEV_TYPE_STA &&
+	       arvif->vdev_subtype == WMI_VDEV_SUBTYPE_NONE;
+}
+
+static bool violet_early_peer_on(struct ieee80211_vif *vif)
+{
+	return violet_sta_self_peer == 3 && vif->type == NL80211_IFTYPE_STATION;
+}
+
+static int ath10k_peer_delete(struct ath10k *ar, u32 vdev_id, const u8 *addr);
+
+/* WCN3990 HL3.x refuses a station vdev start (status -1) unless the BSS peer
+ * already exists, so create it before the vdev is started; the sta_state
+ * handler later adopts it instead of creating a second one.
+ */
+static void violet_drop_early_peer(struct ath10k *ar, struct ieee80211_vif *vif)
+{
+	struct ath10k_vif *arvif = (void *)vif->drv_priv;
+	struct ath10k_peer *peer;
+	u8 addr[ETH_ALEN];
+	bool found = false;
+
+	spin_lock_bh(&ar->data_lock);
+	list_for_each_entry(peer, &ar->peers, list) {
+		if (peer->vdev_id == arvif->vdev_id && !peer->sta) {
+			ether_addr_copy(addr, peer->addr);
+			found = true;
+			break;
+		}
+	}
+	spin_unlock_bh(&ar->data_lock);
+
+	if (found) {
+		ath10k_warn(ar, "violet: dropping early peer %pM on vdev %d\n", addr, arvif->vdev_id);
+		ath10k_peer_delete(ar, arvif->vdev_id, addr);
+	}
+}
