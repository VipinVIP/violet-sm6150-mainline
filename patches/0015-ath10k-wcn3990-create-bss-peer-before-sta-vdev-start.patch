+	/*
+	 * A station does not know the AP's beacon interval / DTIM period
+	 * yet when mac80211 assigns the channel context (before association), so
+	 * ath10k sends 0/0.  The WCN3990 HL3.x firmware answers such a vdev start
+	 * with status -1 ("vdev-start-response reports status error"), so no
+	 * station can ever associate.  The monitor path already uses 1/1.
+	 */
+	arg.dtim_period = arvif->dtim_period ?: 1;
+	arg.bcn_intval = arvif->beacon_interval ?: 100;
 
 	arg.channel.freq = chandef->chan->center_freq;
