// SPDX-License-Identifier: GPL-2.0
/*
 * Redmi Note 7 Pro (violet) fuel gauge on the pm6150 QPNP QG block.
 *
 * Mainline has no QG driver.  Downstream, qpnp-qg.c only feeds FIFO samples to a
 * closed estimator and takes cc_soc/batt_soc/sys_soc back; what it does keep in the
 * kernel is the battery profile, the power-on SoC decision, the cutoff/full scaling
 * and the SoC reporting rules.  This driver keeps those parts (same tables, same
 * formulas, taken from qpnp-qg.c / qg-soc.c / qg-profile-lib.c) and supplies the
 * estimator itself: coulomb counting in profile-percent with open-circuit-voltage
 * correction at rest.
 *
 *  - profile:   one of the three vendor LC_M6300 4000 mAh packs (violet-qg-profiles.h,
 *               generated from the vendor dtsi); discharge uses the v2 SoC-OCV table,
 *               charge the v1 table, capacity from fcc2 at the battery temperature;
 *  - batt_soc:  profile percent, 0..100 (x100 internally), coulomb counted;
 *  - sys_soc:   batt_soc rescaled between the cutoff-voltage SoC and the float-voltage
 *               SoC exactly as qg_determine_pon_soc() does;
 *  - reported:  qg_adjust_sys_soc() hold-at-99 / hold-at-1 rules, then the msoc
 *               catch-up walker (qg-soc.c update_msoc()) so the percentage moves one
 *               point at a time and only in the direction the current implies;
 *  - PON:       S7 power-on OCV from the QG block, or the SoC this driver stored in
 *               the SDAM, with the same preference rules as the downstream driver.
 *
 * Sign convention: ibat > 0 = charging (kernel ABI), measured against SMB5 registers.
 */
#include <linux/delay.h>
#include <linux/iio/consumer.h>
#include <linux/module.h>
#include <linux/of.h>
#include <linux/platform_device.h>
#include <linux/power_supply.h>
#include <linux/regmap.h>
#include <linux/workqueue.h>
#include <linux/ktime.h>

#include "violet-qg-profiles.h"

#define QG_BASE			0x4800
#define QG_SUBTYPE		(QG_BASE + 0x05)
#define QG_DATA_CTL2		(QG_BASE + 0x42)
#define  BURST_AVG_HOLD	BIT(0)
#define QG_S7_PON_OCV_V		(QG_BASE + 0x70)
#define QG_S3_GOOD_OCV_V	(QG_BASE + 0x74)
#define QG_LAST_ADC_V		(QG_BASE + 0xc0)
#define QG_LAST_BURST_AVG_I	(QG_BASE + 0xc6)
#define QG_ADC_IBAT_5A		0x3
#define FIFO_V_RESET_VAL	0x8000

#define SDAM_BASE		0xb600
#define SDAM_VALID		(SDAM_BASE + 0x46)
#define SDAM_SOC		(SDAM_BASE + 0x47)
#define SDAM_MAGIC		0xA5	/* our marker: SDAM_SOC below is ours, sys_soc percent */
#define SDAM_RBAT		(SDAM_BASE + 0x4a)	/* u16 mOhm */

#define SMB5_CHGR_STATUS1	0x1006	/* [2:0] charge state, see enum smb5_chg_state */
#define SMB5_CHGR_STATUS7	0x100d	/* battery temperature flags */
#define  TEMP_COLD_SOFT		BIT(4)
#define  TEMP_HOT_SOFT		BIT(5)
#define  TEMP_TOO_COLD		BIT(2)
#define  TEMP_TOO_HOT		BIT(3)
#define SMB5_APSD_RESULT	0x1308
#define  APSD_SDP		BIT(0)
#define  APSD_OCP		BIT(1)
#define  APSD_CDP		BIT(2)
#define  APSD_DCP		BIT(3)
#define  APSD_FLOAT		BIT(4)
#define SMB5_USBIN_RT_STS	0x1310	/* bit 4 USBIN plugged, bit 3 over-voltage */
#define SMB5_ADAPTER_OVERRIDE	0x1344	/* USBIN_ADAPTER_ALLOW_OVERRIDE */
#define  ALLOW_FORCE_5V		BIT(0)
#define  ALLOW_FORCE_9V		BIT(1)
#define  ALLOW_CONTINUOUS	BIT(3)

enum smb5_chg_state {
	CHG_INHIBIT, CHG_TRICKLE, CHG_PRE, CHG_FAST, CHG_TAPER, CHG_TERM, CHG_PAUSE, CHG_DISABLE,
};

#define POLL_MS			2000
#define REST_UA			80000	/* |I| below this counts as resting */
#define REST_SECS		120
#define VBATT_CUTOFF_UV		3400000	/* qcom,vbatt-cutoff-mv */
#define VBAT_LOW_HYST_UV	5000
#define DELTA_SOC		1	/* qcom,delta-soc default */
#define SOC_STEP_MS		40000	/* qg_delta_soc_interval_ms */
#define SOC_STEP_COLD_MS	25000
#define COLD_DECIC		100	/* cold-temp-threshold 10.0 C */
#define PON_OCV_TRUST_PTS	15	/* ocv vs stored disagreement that overrides the store */
/*
 * Rbatt is a *dynamic* resistance: a 540 mA load step gave dV/dI = 121.9 mOhm,
 * which already contains the fast polarisation term, so OCV = V - I*Rbatt.
 */
#define RBATT_MEASURED_MOHM	122

static bool violet_debug;
module_param_named(debug_state, violet_debug, bool, 0644);
MODULE_PARM_DESC(debug_state, "log gauge internals once a minute");

static char *profile_name = "";
module_param_named(profile, profile_name, charp, 0444);
MODULE_PARM_DESC(profile, "battery profile: atl, coslight or sunwoda (default: from batt-id channel, else atl)");

static int smb5_init = 1;
module_param_named(smb5_init, smb5_init, int, 0644);
MODULE_PARM_DESC(smb5_init, "0 = observe the charger only, 1 = program the input current limit on plug-in");

static char *tcpm_psy_name = "tcpm-source-psy-c440000.spmi:pmic@0:typec@1500";
module_param_named(tcpm_psy, tcpm_psy_name, charp, 0444);
MODULE_PARM_DESC(tcpm_psy, "power supply of the Type-C port (PD contract)");

static int icl_max_ma = 1800;
module_param_named(icl_max_ma, icl_max_ma, int, 0644);
MODULE_PARM_DESC(icl_max_ma, "input current limit for DCP/float chargers (SDP 500, CDP 1500 are fixed)");

struct violet_batt {
	struct device *dev;
	struct regmap *map;
	struct power_supply *psy, *usb_psy, *tcpm;
	struct notifier_block nb;
	int allow_mode, pd_uv;
	struct delayed_work work;
	struct iio_channel *id_chan, *therm_chan;
	const struct qg_profile *prof;
	bool five_amp;
	int rbat_mohm;
	int vbat_uv, ibat_ua;		/* ibat > 0 charging */
	int temp_decic;			/* 0.1 C */
	int fcc_uah;
	int cutoff_x100, full_x100;	/* profile percent x100 at cutoff / float voltage */
	int batt_x100;			/* profile percent x100 (batt_soc) */
	s64 cc_rem;			/* sub-unit coulomb remainder, in uA*ms*10000 */
	int sys_x100;			/* rescaled percent x100 (sys_soc) */
	int catch_up, msoc;		/* vendor catch_up_soc / msoc, percent */
	ktime_t last_step;
	int sdam_soc;
	bool plugged, term;
	int apsd, applied_icl_ma, chg_state, health;
	u8 status7;
	ktime_t last, rest_since;
	bool resting;
};

/* ---- profile tables -------------------------------------------------------- */

static int interp(int x, int x0, int x1, int y0, int y1)
{
	if (x1 == x0)
		return y0;
	return y0 + (int)div_s64((s64)(y1 - y0) * (x - x0), x1 - x0);
}

/* bracket temp (degC) in the column legend; returns lower index, *frac in 0..1024 */
static int temp_bracket(const s16 *col, int n, int temp_c, int *frac)
{
	int i;

	if (temp_c <= col[0]) {
		*frac = 0;
		return 0;
	}
	for (i = 1; i < n; i++) {
		if (temp_c <= col[i]) {
			*frac = (temp_c - col[i - 1]) * 1024 / (col[i] - col[i - 1]);
			return i - 1;
		}
	}
	*frac = 0;
	return n - 1;
}

/* SoC (percent x100) for an open-circuit voltage; charging selects the v1 table */
static int lookup_soc_ocv(const struct qg_profile *p, int ocv_uv, int temp_decic, bool charging)
{
	const s16 *col = charging ? p->t1 : p->t2;
	const u16 *row = charging ? p->pc1 : p->pc2;
	const u16 *tab = charging ? p->ocv1 : p->ocv2;
	int nc = charging ? p->n_t1 : p->n_t2;
	int nr = charging ? p->n_r1 : p->n_r2;
	int frac, c = temp_bracket(col, nc, DIV_ROUND_CLOSEST(temp_decic, 10), &frac);
	int c1 = min(c + 1, nc - 1);
	int v_prev = 0, i;

	for (i = 0; i < nr; i++) {
		int v = (tab[i * nc + c] + (tab[i * nc + c1] - tab[i * nc + c]) * frac / 1024) * 100;

		if (ocv_uv >= v) {
			if (!i)
				return row[0];
			return interp(ocv_uv, v, v_prev, row[i], row[i - 1]);
		}
		v_prev = v;
	}
	return row[nr - 1];
}

static int lookup_fcc_uah(const struct qg_profile *p, int temp_decic)
{
	int frac, c = temp_bracket(p->tf, p->n_tf, DIV_ROUND_CLOSEST(temp_decic, 10), &frac);
	int c1 = min(c + 1, p->n_tf - 1);

	return (p->fcc[c] + (p->fcc[c1] - p->fcc[c]) * frac / 1024) * 1000;
}

static void violet_set_scale(struct violet_batt *b)
{
	const struct qg_profile *p = b->prof;
	int full = lookup_soc_ocv(p, p->vmax_uv, b->temp_decic, true);

	/* qg_determine_pon_soc(): FULL_SOC capped at 99, CUTOFF_SOC from the discharge table */
	b->full_x100 = min(full, 9900);
	b->cutoff_x100 = lookup_soc_ocv(p, VBATT_CUTOFF_UV, b->temp_decic, false);
	b->fcc_uah = lookup_fcc_uah(p, b->temp_decic);
}

/* sys_soc: batt_soc rescaled between cutoff and float-voltage SoC (percent x100) */
static int violet_sys_soc(struct violet_batt *b, int batt_x100)
{
	if (b->full_x100 > b->cutoff_x100 && batt_x100 > b->cutoff_x100)
		return clamp(DIV_ROUND_UP((batt_x100 - b->cutoff_x100) * 10000,
					  b->full_x100 - b->cutoff_x100), 0, 10000);
	return clamp(batt_x100, 0, 10000);
}

/* inverse of the above, for seeding batt_soc from a stored sys_soc */
static int violet_batt_from_sys(struct violet_batt *b, int sys_x100)
{
	return b->cutoff_x100 + (b->full_x100 - b->cutoff_x100) * sys_x100 / 10000;
}

/* ---- sampling -------------------------------------------------------------- */

static void violet_chg_update(struct violet_batt *b);

static int violet_batt_sample(struct violet_batt *b)
{
	u8 buf[2];
	int ret, raw;

	ret = regmap_bulk_read(b->map, QG_LAST_ADC_V, buf, 2);
	if (ret)
		return ret;
	b->vbat_uv = (buf[0] | (buf[1] << 8)) * 194637ULL / 1000;

	regmap_update_bits(b->map, QG_DATA_CTL2, BURST_AVG_HOLD, BURST_AVG_HOLD);
	ret = regmap_bulk_read(b->map, QG_LAST_BURST_AVG_I, buf, 2);
	regmap_update_bits(b->map, QG_DATA_CTL2, BURST_AVG_HOLD, 0);
	if (ret)
		return ret;
	raw = (s16)(buf[0] | (buf[1] << 8));
	/* QG reports discharge as positive; flip to the kernel convention */
	b->ibat_ua = -raw * (b->five_amp ? 152588LL : 305176LL) / 1000;

	if (b->therm_chan) {
		int mdeg;

		if (!iio_read_channel_processed(b->therm_chan, &mdeg))
			b->temp_decic = mdeg / 100;
	}

	violet_chg_update(b);
	return 0;
}

/*
 * Input current limit.  The PMIC comes up from SBL in SDP-current mode and drops its
 * ICL setting whenever the cable is pulled, so the documented input-path sequence (see
 * asidko/pm6150-charger-mainline docs/REGISTER_SEQUENCE.md, from downstream
 * smblib_icl_override) is re-run on every plug-in, with the limit chosen from the APSD
 * result the way downstream smblib_get_charge_current() does:
 * SDP 500 mA, CDP 1.5 A, DCP/float/OCP icl_max_ma.  JEITA, float voltage, safety timer,
 * OTG and watchdog registers are deliberately never written: SBL has already programmed
 * the hardware JEITA window and termination, and the hardware enforces them.
 */
static int violet_icl_for(int apsd)
{
	if (apsd & (APSD_DCP | APSD_FLOAT | APSD_OCP))
		return icl_max_ma;
	if (apsd & APSD_CDP)
		return min(1500, icl_max_ma);
	return min(500, icl_max_ma);
}

static void violet_apply_icl(struct violet_batt *b, int icl_ma)
{
	unsigned int opts = 0, icl = 0, st5 = 0;

	regmap_update_bits(b->map, 0x1680, BIT(0) | BIT(1), 0);	/* cancel AICL */
	regmap_write(b->map, 0x1380, 0x00);			/* AICL off, before the ICL */
	regmap_write(b->map, 0x1370, icl_ma / 50);
	regmap_write(b->map, 0x1061, 2000 / 50);		/* FCC, as validated */
	regmap_update_bits(b->map, 0x1366, BIT(0) | BIT(1), BIT(0));	/* USBIN_MODE_CHG */
	regmap_update_bits(b->map, 0x1342, BIT(0), BIT(0));	/* ICL_OVERRIDE */
	regmap_update_bits(b->map, 0x1365, BIT(4), BIT(4));	/* ..after APSD */
	regmap_update_bits(b->map, 0x1340, BIT(0), 0);		/* unsuspend USBIN */
	regmap_update_bits(b->map, 0x1042, BIT(0), BIT(0));	/* charging enable */

	regmap_read(b->map, 0x1366, &opts);
	regmap_read(b->map, 0x1370, &icl);
	regmap_read(b->map, 0x100B, &st5);
	b->applied_icl_ma = (icl & 0xff) * 50;
	dev_info(b->dev, "charger: apsd=0x%02x -> icl %d mA (read back %d, mode_chg=%d) status5=0x%02x\n",
		 b->apsd, icl_ma, b->applied_icl_ma, !!(opts & BIT(0)), st5);
}

/*
 * PD contract -> USBIN voltage window.  The PMIC treats anything above the 5 V window as
 * over-voltage and pauses charging, so once the Type-C block has negotiated a higher
 * voltage the input path must be told it is allowed, exactly as downstream
 * smblib_set_usb_pd_allowed_voltage() does with USBIN_ADAPTER_ALLOW_OVERRIDE.  Only the
 * 5 V and 9 V windows are ever enabled: the sink PDOs in the DT stop at 9 V, and anything
 * else leaves the override cleared (hardware default) so the PMIC protects itself.
 */
static void violet_pd_allowance(struct violet_batt *b)
{
	union power_supply_propval online = {}, volt = {};
	int mode = 0;

	if (!b->tcpm)
		b->tcpm = power_supply_get_by_name(tcpm_psy_name);
	if (b->tcpm && b->plugged &&
	    !power_supply_get_property(b->tcpm, POWER_SUPPLY_PROP_ONLINE, &online) && online.intval &&
	    !power_supply_get_property(b->tcpm, POWER_SUPPLY_PROP_VOLTAGE_NOW, &volt)) {
		b->pd_uv = volt.intval;
		if (volt.intval >= 8500000 && volt.intval <= 9500000)
			mode = ALLOW_FORCE_9V;
		else if (volt.intval > 0 && volt.intval <= 5500000)
			mode = ALLOW_FORCE_5V;
	} else {
		b->pd_uv = 0;
	}

	if (mode == b->allow_mode)
		return;
	regmap_write(b->map, SMB5_ADAPTER_OVERRIDE, mode);
	dev_info(b->dev, "charger: PD contract %d mV -> USBIN window override 0x%02x\n",
		 b->pd_uv / 1000, mode);
	b->allow_mode = mode;
}

static int violet_psy_event(struct notifier_block *nb, unsigned long ev, void *data)
{
	struct violet_batt *b = container_of(nb, struct violet_batt, nb);
	struct power_supply *psy = data;

	if (ev == PSY_EVENT_PROP_CHANGED && !strcmp(psy->desc->name, tcpm_psy_name))
		mod_delayed_work(system_wq, &b->work, 0);
	return NOTIFY_OK;
}

static void violet_chg_update(struct violet_batt *b)
{
	unsigned int rt = 0, apsd = 0, st1 = 0, st7 = 0;
	bool was = b->plugged;

	regmap_read(b->map, SMB5_USBIN_RT_STS, &rt);
	regmap_read(b->map, SMB5_APSD_RESULT, &apsd);
	regmap_read(b->map, SMB5_CHGR_STATUS1, &st1);
	regmap_read(b->map, SMB5_CHGR_STATUS7, &st7);
	b->plugged = rt & BIT(4);
	b->chg_state = st1 & 7;
	b->term = b->chg_state == CHG_TERM;
	b->status7 = st7;

	if (st7 & TEMP_TOO_HOT)
		b->health = POWER_SUPPLY_HEALTH_OVERHEAT;
	else if (st7 & TEMP_TOO_COLD)
		b->health = POWER_SUPPLY_HEALTH_COLD;
	else if (st7 & TEMP_HOT_SOFT)
		b->health = POWER_SUPPLY_HEALTH_WARM;
	else if (st7 & TEMP_COLD_SOFT)
		b->health = POWER_SUPPLY_HEALTH_COOL;
	else
		b->health = POWER_SUPPLY_HEALTH_GOOD;

	violet_pd_allowance(b);

	if (!b->plugged) {
		b->apsd = 0;
		b->applied_icl_ma = 0;
	} else if (smb5_init && ((apsd & 0x7f) != (unsigned int)b->apsd || !was)) {
		/* new plug-in or APSD re-ran: choose the limit for what is on the cable */
		b->apsd = apsd & 0x7f;
		if (b->apsd)
			violet_apply_icl(b, violet_icl_for(b->apsd));
	}
	if (b->usb_psy && was != b->plugged)
		power_supply_changed(b->usb_psy);
}

/* ---- SoC reporting (qg_adjust_sys_soc + update_msoc) ------------------------- */

static int violet_adjust_sys_soc(struct violet_batt *b)
{
	int soc;

	if (b->sys_x100 >= 10000)
		soc = 100;
	else if (b->sys_x100 >= 9900)
		soc = b->msoc == 100 ? 100 : 99;	/* hold 99 until the charger says full */
	else
		soc = DIV_ROUND_CLOSEST(b->sys_x100, 100);

	/* hold 1% until the pack is really at the cutoff */
	if (!soc && b->vbat_uv >= VBATT_CUTOFF_UV + VBAT_LOW_HYST_UV)
		soc = 1;
	return soc;
}

static bool violet_update_msoc(struct violet_batt *b, ktime_t now)
{
	int step_ms = b->temp_decic < COLD_DECIC ? SOC_STEP_COLD_MS : SOC_STEP_MS;
	int old = b->msoc;

	if (b->catch_up == b->msoc)
		return false;
	/* the first reading after probe is taken as is */
	if (ktime_ms_delta(now, b->last_step) < step_ms)
		return false;

	if (b->catch_up > b->msoc) {
		if (b->plugged)
			b->msoc = min(b->msoc + DELTA_SOC, b->catch_up);
	} else if (b->ibat_ua < 0) {
		b->msoc = max(b->msoc - DELTA_SOC, b->catch_up);
	}
	if (b->msoc != old)
		b->last_step = now;
	return b->msoc != old;
}

/* ---- main loop -------------------------------------------------------------- */

static void violet_batt_poll(struct work_struct *w)
{
	struct violet_batt *b = container_of(w, struct violet_batt, work.work);
	ktime_t now = ktime_get_boottime();
	s64 dt_ms = ktime_ms_delta(now, b->last);
	int ocv_uv, ocv_x100, err;
	bool changed;

	if (violet_batt_sample(b))
		goto out;
	b->last = now;
	violet_set_scale(b);

	/* coulomb counting in profile percent x100; ibat > 0 = charging */
	if (dt_ms > 0 && dt_ms < 60000 && b->fcc_uah) {
		/* one poll moves the percentage by well under one x100 unit: carry the remainder */
		s64 den = 3600000LL * b->fcc_uah;
		s64 num = (s64)b->ibat_ua * dt_ms * 10000 + b->cc_rem;
		s64 delta = div64_s64(num, den);

		b->batt_x100 += delta;
		b->cc_rem = num - delta * den;
	}

	ocv_uv = b->vbat_uv - (s64)b->ibat_ua * b->rbat_mohm / 1000;
	ocv_x100 = lookup_soc_ocv(b->prof, ocv_uv, b->temp_decic, b->ibat_ua > REST_UA);
	err = ocv_x100 - b->batt_x100;

	if (abs(b->ibat_ua) < REST_UA) {
		if (!b->resting) {
			b->resting = true;
			b->rest_since = now;
		}
		/* after a quiet spell trust the OCV and pull the counter to it */
		if (ktime_ms_delta(now, b->rest_since) > REST_SECS * 1000)
			b->batt_x100 += (s64)err * dt_ms / 100000;	/* ~100 s time constant */
	} else {
		b->resting = false;
		/*
		 * Under load OCV = V - I*R is a good level but a bad rate (polarisation
		 * is not a pure resistance), so only rescue a genuinely wrong anchor.
		 */
		if (abs(err) > 2000)
			b->batt_x100 += (s64)err * dt_ms / 100000;
	}

	/* the charger says the pack is full: that is the float-voltage SoC */
	if (b->plugged && b->term && b->vbat_uv > 4300000 && b->ibat_ua < 150000)
		b->batt_x100 = b->full_x100;

	b->batt_x100 = clamp(b->batt_x100, 0, 10000);
	b->sys_x100 = violet_sys_soc(b, b->batt_x100);
	if (b->plugged && b->term && b->vbat_uv > 4300000 && b->ibat_ua < 150000)
		b->sys_x100 = 10000;
	b->catch_up = violet_adjust_sys_soc(b);
	changed = violet_update_msoc(b, now);

	if (b->sys_x100 / 100 != b->sdam_soc) {
		regmap_write(b->map, SDAM_SOC, b->sys_x100 / 100);
		regmap_write(b->map, SDAM_VALID, SDAM_MAGIC);
		b->sdam_soc = b->sys_x100 / 100;
	}
	if (violet_debug) {
		static unsigned int tick;

		if (!(tick++ % 30))
			dev_info(b->dev, "v=%d i=%d t=%d.%d ocv=%d ocv_soc=%d.%02d batt=%d.%02d sys=%d.%02d catch=%d msoc=%d fcc=%d plug=%d term=%d rest=%d\n",
				 b->vbat_uv, b->ibat_ua, b->temp_decic / 10, abs(b->temp_decic % 10),
				 ocv_uv, ocv_x100 / 100, ocv_x100 % 100, b->batt_x100 / 100,
				 b->batt_x100 % 100, b->sys_x100 / 100, b->sys_x100 % 100,
				 b->catch_up, b->msoc, b->fcc_uah, b->plugged, b->term, b->resting);
	}
	if (changed)
		power_supply_changed(b->psy);
out:
	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
}

static int violet_batt_get(struct power_supply *psy, enum power_supply_property p,
			   union power_supply_propval *val)
{
	struct violet_batt *b = power_supply_get_drvdata(psy);

	switch (p) {
	case POWER_SUPPLY_PROP_PRESENT:
		val->intval = 1;
		return 0;
	case POWER_SUPPLY_PROP_TECHNOLOGY:
		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
		return 0;
	case POWER_SUPPLY_PROP_MODEL_NAME:
		val->strval = b->prof->type;
		return 0;
	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
		val->intval = b->prof->vmax_uv;
		return 0;
	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
		val->intval = VBATT_CUTOFF_UV;
		return 0;
	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
	case POWER_SUPPLY_PROP_CHARGE_FULL:
		val->intval = b->fcc_uah;
		return 0;
	case POWER_SUPPLY_PROP_CHARGE_NOW:
		val->intval = div_s64((s64)b->fcc_uah * b->batt_x100, 10000);
		return 0;
	case POWER_SUPPLY_PROP_TEMP:
		val->intval = b->temp_decic;
		return 0;
	case POWER_SUPPLY_PROP_HEALTH:
		val->intval = b->health;
		return 0;
	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
		val->intval = b->vbat_uv;
		return 0;
	case POWER_SUPPLY_PROP_CURRENT_NOW:
		val->intval = b->ibat_ua;	/* kernel ABI: positive = charging */
		return 0;
	case POWER_SUPPLY_PROP_CAPACITY:
		val->intval = b->msoc;
		return 0;
	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
		val->intval = b->msoc >= 100 ? POWER_SUPPLY_CAPACITY_LEVEL_FULL :
			      b->msoc >= 85 ? POWER_SUPPLY_CAPACITY_LEVEL_HIGH :
			      b->msoc >= 20 ? POWER_SUPPLY_CAPACITY_LEVEL_NORMAL :
			      b->msoc >= 5 ? POWER_SUPPLY_CAPACITY_LEVEL_LOW :
					     POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
		return 0;
	case POWER_SUPPLY_PROP_STATUS:
		if (!b->plugged)
			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
		else if (b->term && b->msoc >= 99)
			val->intval = POWER_SUPPLY_STATUS_FULL;
		else if (b->chg_state == CHG_PAUSE || b->chg_state == CHG_DISABLE ||
			 b->chg_state == CHG_INHIBIT)
			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
		else if (b->term)
			val->intval = POWER_SUPPLY_STATUS_FULL;	/* charger done, gauge catching up */
		else
			val->intval = POWER_SUPPLY_STATUS_CHARGING;
		return 0;
	default:
		return -EINVAL;
	}
}

static const enum power_supply_property violet_batt_props[] = {
	POWER_SUPPLY_PROP_STATUS, POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_TECHNOLOGY,
	POWER_SUPPLY_PROP_HEALTH, POWER_SUPPLY_PROP_VOLTAGE_NOW, POWER_SUPPLY_PROP_CURRENT_NOW,
	POWER_SUPPLY_PROP_CAPACITY, POWER_SUPPLY_PROP_CAPACITY_LEVEL, POWER_SUPPLY_PROP_TEMP,
	POWER_SUPPLY_PROP_CHARGE_NOW, POWER_SUPPLY_PROP_CHARGE_FULL,
	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN, POWER_SUPPLY_PROP_MODEL_NAME,
	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN, POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
};

static const struct power_supply_desc violet_batt_desc = {
	.name = "battery",
	.type = POWER_SUPPLY_TYPE_BATTERY,
	.properties = violet_batt_props,
	.num_properties = ARRAY_SIZE(violet_batt_props),
	.get_property = violet_batt_get,
};

static int violet_usb_get(struct power_supply *psy, enum power_supply_property p,
			  union power_supply_propval *val)
{
	struct violet_batt *b = power_supply_get_drvdata(psy);

	switch (p) {
	case POWER_SUPPLY_PROP_ONLINE:
		val->intval = b->plugged;
		return 0;
	case POWER_SUPPLY_PROP_CURRENT_MAX:
		val->intval = b->applied_icl_ma * 1000;
		return 0;
	case POWER_SUPPLY_PROP_USB_TYPE:
		if (b->apsd & APSD_SDP)
			val->intval = POWER_SUPPLY_USB_TYPE_SDP;
		else if (b->apsd & APSD_CDP)
			val->intval = POWER_SUPPLY_USB_TYPE_CDP;
		else if (b->apsd & APSD_DCP)
			val->intval = POWER_SUPPLY_USB_TYPE_DCP;
		else
			val->intval = POWER_SUPPLY_USB_TYPE_UNKNOWN;
		return 0;
	default:
		return -EINVAL;
	}
}

static const enum power_supply_property violet_usb_props[] = {
	POWER_SUPPLY_PROP_ONLINE, POWER_SUPPLY_PROP_CURRENT_MAX, POWER_SUPPLY_PROP_USB_TYPE,
};

static const struct power_supply_desc violet_usb_desc = {
	.name = "usb",
	.type = POWER_SUPPLY_TYPE_USB,
	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) | BIT(POWER_SUPPLY_USB_TYPE_SDP) |
		     BIT(POWER_SUPPLY_USB_TYPE_CDP) | BIT(POWER_SUPPLY_USB_TYPE_DCP),
	.properties = violet_usb_props,
	.num_properties = ARRAY_SIZE(violet_usb_props),
	.get_property = violet_usb_get,
};

/* ---- probe ------------------------------------------------------------------ */

static const struct qg_profile *violet_pick_profile(struct violet_batt *b)
{
	int i, best = 0, bestd = INT_MAX, mv;

	for (i = 0; i < ARRAY_SIZE(qg_profiles); i++)
		if (*profile_name && !strcmp(profile_name, qg_profiles[i].name))
			return &qg_profiles[i];

	/*
	 * batt-id: 100 kOhm pull-up to the 1.875 V ADC reference, as the downstream QG does.
	 * The adc5 "bat_id" channel reads in microvolts (767841 on the ATL pack = 69 kOhm).
	 */
	if (b->id_chan && !iio_read_channel_processed(b->id_chan, &mv) && mv > 0 && mv < 1875000) {
		int kohm = 100 * (mv / 1000) / (1875 - mv / 1000);

		for (i = 0; i < ARRAY_SIZE(qg_profiles); i++) {
			int d = abs((int)qg_profiles[i].id_kohm - kohm);

			if (d < bestd) {
				bestd = d;
				best = i;
			}
		}
		dev_info(b->dev, "batt-id %d uV = %d kOhm -> profile %s\n", mv, kohm, qg_profiles[best].name);
		return &qg_profiles[best];
	}
	dev_warn(b->dev, "no batt-id reading, defaulting to profile %s\n", qg_profiles[0].name);
	return &qg_profiles[0];
}

static int violet_batt_probe(struct platform_device *pdev)
{
	struct power_supply_config cfg = {};
	unsigned int v, soc = 0, valid = 0, rbat[2] = {};
	struct violet_batt *b;
	int pon_x100, ocv_uv, stored_x100 = -1;
	u8 buf[2];

	b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
	if (!b)
		return -ENOMEM;
	b->dev = &pdev->dev;
	b->map = dev_get_regmap(pdev->dev.parent, NULL);
	if (!b->map)
		return -ENODEV;

	b->id_chan = devm_iio_channel_get(&pdev->dev, "batt-id");
	if (IS_ERR(b->id_chan))
		b->id_chan = NULL;
	b->therm_chan = devm_iio_channel_get(&pdev->dev, "batt-therm");
	if (IS_ERR(b->therm_chan))
		b->therm_chan = NULL;

	regmap_read(b->map, QG_SUBTYPE, &v);
	b->five_amp = v == QG_ADC_IBAT_5A;

	b->prof = violet_pick_profile(b);
	b->temp_decic = 250;
	regmap_read(b->map, SDAM_VALID, &valid);
	regmap_read(b->map, SDAM_SOC, &soc);
	regmap_read(b->map, SDAM_RBAT, &rbat[0]);
	regmap_read(b->map, SDAM_RBAT + 1, &rbat[1]);
	b->rbat_mohm = rbat[0] | (rbat[1] << 8);
	if (b->rbat_mohm < 20 || b->rbat_mohm > 400)
		b->rbat_mohm = RBATT_MEASURED_MOHM;

	if (violet_batt_sample(b))
		return dev_err_probe(&pdev->dev, -EIO, "QG not answering\n");
	violet_set_scale(b);

	/*
	 * Power-on SoC (qg_determine_pon_soc): the S7 power-on OCV is measured by the PMIC
	 * before any load is applied.  The SoC stored in the SDAM wins unless it disagrees
	 * with the OCV by a lot (pack swapped, long power-off, stale store), because the
	 * stored value survives a reload under load where the OCV does not.
	 */
	regmap_bulk_read(b->map, QG_S7_PON_OCV_V, buf, 2);
	v = buf[0] | (buf[1] << 8);
	ocv_uv = v == FIFO_V_RESET_VAL ? 0 : v * 194637ULL / 1000;
	if (!ocv_uv || abs(b->ibat_ua) > REST_UA)
		ocv_uv = b->vbat_uv - (s64)b->ibat_ua * b->rbat_mohm / 1000;
	pon_x100 = lookup_soc_ocv(b->prof, ocv_uv, b->temp_decic, false);

	if (valid == SDAM_MAGIC && soc > 0 && soc <= 100)
		stored_x100 = violet_batt_from_sys(b, soc * 100);
	if (stored_x100 >= 0 && abs(stored_x100 - pon_x100) < PON_OCV_TRUST_PTS * 100) {
		b->batt_x100 = stored_x100;
		dev_info(&pdev->dev, "PON: using stored sys_soc %u%% (ocv says batt %d.%02d%%)\n",
			 soc, pon_x100 / 100, pon_x100 % 100);
	} else {
		b->batt_x100 = pon_x100;
		dev_info(&pdev->dev, "PON: using S7/measured OCV %d uV -> batt %d.%02d%% (stored %u valid %u)\n",
			 ocv_uv, pon_x100 / 100, pon_x100 % 100, soc, valid);
	}
	b->sys_x100 = violet_sys_soc(b, b->batt_x100);
	b->catch_up = b->msoc = violet_adjust_sys_soc(b);
	b->sdam_soc = -1;
	b->last = b->last_step = ktime_get_boottime();
	dev_info(&pdev->dev, "QG %s, profile %s fcc %d uAh cutoff_soc %d full_soc %d rbat %d mOhm vbat %d uV ibat %d uA -> start %d%%\n",
		 b->five_amp ? "5A" : "10A", b->prof->name, b->fcc_uah, b->cutoff_x100, b->full_x100,
		 b->rbat_mohm, b->vbat_uv, b->ibat_ua, b->msoc);

	cfg.drv_data = b;
	cfg.fwnode = dev_fwnode(&pdev->dev);
	b->psy = devm_power_supply_register(&pdev->dev, &violet_batt_desc, &cfg);
	if (IS_ERR(b->psy))
		return PTR_ERR(b->psy);
	{
		static char *usb_supplies[] = { "battery" };
		struct power_supply_config ucfg = { .drv_data = b, .supplied_to = usb_supplies,
						    .num_supplicants = 1 };

		b->usb_psy = devm_power_supply_register(&pdev->dev, &violet_usb_desc, &ucfg);
		if (IS_ERR(b->usb_psy))
			return PTR_ERR(b->usb_psy);
	}
	INIT_DELAYED_WORK(&b->work, violet_batt_poll);
	platform_set_drvdata(pdev, b);
	b->nb.notifier_call = violet_psy_event;
	power_supply_reg_notifier(&b->nb);
	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
	return 0;
}

static void violet_batt_remove(struct platform_device *pdev)
{
	struct violet_batt *b = platform_get_drvdata(pdev);

	power_supply_unreg_notifier(&b->nb);
	cancel_delayed_work_sync(&b->work);
	regmap_write(b->map, SMB5_ADAPTER_OVERRIDE, 0);
	if (b->tcpm)
		power_supply_put(b->tcpm);
}

static const struct of_device_id violet_batt_of[] = {
	{ .compatible = "xiaomi,violet-vbat" }, {}
};
MODULE_DEVICE_TABLE(of, violet_batt_of);

static struct platform_driver violet_batt_driver = {
	.probe = violet_batt_probe,
	.remove = violet_batt_remove,
	.driver = { .name = "violet-qg", .of_match_table = violet_batt_of },
};
module_platform_driver(violet_batt_driver);
MODULE_DESCRIPTION("violet QG fuel gauge (vendor profile, PON and SoC reporting rules)");
MODULE_LICENSE("GPL");
