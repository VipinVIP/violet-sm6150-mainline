drm/msm/a6xx: RGMU suspend in downstream order (collapse GX before GBIF halt)

Root cause of G1 ("RGMU GX failed to power up" -> SoC watchdog reset under NewPipe video).
Downstream adreno_stop()/rgmu_stop(): GX retention off, release GPUSTART, wait up to 100 ms
for the RGMU to collapse GX (needs the GBIF running), then halt only the CX side of the GBIF.
We halted the GBIF first (incl. the GX-side RBBM_GBIF_HALT), so the RGMU never collapsed GX
and the CPU forced the GX GDSC off on every suspend - downstream's error path - several times a
second. Verified on #171: 946 swipe-driven resumes, 0 GX failures (old rate ~1/90).

--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -2236,6 +2236,7 @@
 #define RGMU_GENERAL_0			0x1F9C5
 #define RGMU_GENERAL_7			0x1F9CC
 #define RGMU_ITCM_START			0x1B400
+#define RBBM_BLOCK_GX_RETENTION_CNTL	0x00050	/* downstream a6xx_reg.h */
 #define RGMU_PWR_COUNTER_ENABLE		0x1F840
 #define RGMU_PWR_COUNTER_1		0x1F841
 #define RGMU_PWR_COUNTER_2		0x1F842
@@ -2422,7 +2423,7 @@
 	return 0;
 }
 
-/* Called after the buses are halted, before the clocks go away */
+/* Called with the GBIF still running (GX collapse needs it), before the clocks go away */
 static void a6xx_rgmu_stop(struct a6xx_gpu *a6xx_gpu)
 {
 	struct msm_gpu *gpu = &a6xx_gpu->base.base;
@@ -2436,6 +2437,24 @@
 	gpu_write(gpu, RGMU_GPU_SLUMBER_CTRL, 2);
 	gpu_write(gpu, RGMU_GPU_SLUMBER_CTRL, 0);
 
+	/*
+	 * Let the RGMU collapse GX itself, as downstream's rgmu_stop() does via
+	 * wait_for_lowest_idle() (100 ms). With GPUSTART released it powers GX off
+	 * after the 300 us PWR_COL hysteresis. Only if it never does, take the GX
+	 * GDSC over from the CPU and release it - downstream reserves that for its
+	 * GMU_SUSPEND error path ("switch gx gdsc control from RGMU to CPU").
+	 * Doing the takeover on every suspend raced the RGMU's own collapse and
+	 * preceded "RGMU GX failed to power up" on a later resume.
+	 */
+	if (readl_poll_timeout(gmu->mmio + GMU_BYTE_OFFSET(gmu, RGMU_SPTPRAC_PWR_CLK_STATUS),
+			       val, val & RGMU_GX_GDSC_POWER_OFF, 10, 100000)) {
+		DRM_DEV_ERROR(gmu->dev,
+			      "RGMU did not collapse GX (status=%08x pcc_debug=%08x), forcing it off\n",
+			      val, gmu_read(gmu, RGMU_PCC_DEBUG));
+		pm_runtime_resume_and_get(gmu->gxpd);
+		pm_runtime_put_sync(gmu->gxpd);
+	}
+
 	gmu_write(gmu, RGMU_PWR_COUNTER_ENABLE, 0);
 
 	/* BCL off: disable the HW CRC interface and wait for the ack */
@@ -2449,15 +2468,6 @@
 	gmu_write(gmu, RGMU_GMU2HOST_INTR_MASK, 0xffffffff);
 	gmu_write(gmu, RGMU_AO_HOST_INTR_CLR, 0xffffffff);
 	gmu_write(gmu, RGMU_GMU2HOST_INTR_CLR, 0xffffffff);
-
-	/*
-	 * If the RGMU left GX on, take the power domain over and release it, like
-	 * the downstream driver does ("switch gx gdsc control from RGMU to CPU").
-	 */
-	if (!(gmu_read(gmu, RGMU_SPTPRAC_PWR_CLK_STATUS) & RGMU_GX_GDSC_POWER_OFF)) {
-		pm_runtime_resume_and_get(gmu->gxpd);
-		pm_runtime_put_sync(gmu->gxpd);
-	}
 }
 
 
@@ -2582,11 +2592,21 @@
 
 	mutex_lock(&a6xx_gpu->gmu.lock);
 
-	/* Drain the outstanding traffic on memory buses */
-	adreno_gpu->funcs->bus_halt(adreno_gpu, true);
-
-	if (adreno_has_rgmu(adreno_gpu))
+	if (adreno_has_rgmu(adreno_gpu)) {
+		/*
+		 * Downstream adreno_stop() order: GX retention off, release
+		 * GPUSTART and wait for the RGMU to collapse GX - which needs the
+		 * GBIF still running - and only then halt the CX side of the GBIF.
+		 * Halting first (and touching the GX-side RBBM_GBIF_HALT) left the
+		 * RGMU unable to collapse GX on every suspend.
+		 */
+		gpu_write(gpu, RBBM_BLOCK_GX_RETENTION_CNTL, 0);
 		a6xx_rgmu_stop(a6xx_gpu);
+		adreno_gpu->funcs->bus_halt(adreno_gpu, false);
+	} else {
+		/* Drain the outstanding traffic on memory buses */
+		adreno_gpu->funcs->bus_halt(adreno_gpu, true);
+	}
 
 	if (adreno_is_a619_holi(adreno_gpu))
 		a6xx_sptprac_disable(gmu);
