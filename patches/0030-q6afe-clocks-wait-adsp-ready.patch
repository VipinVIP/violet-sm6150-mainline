ASoC: qcom: q6afe-clocks: register only once the AFE itself answers

q6core_is_adsp_ready() is not enough: for a short while after the audio service is announced the AFE
rejects commands (DSP error 0x16 / no reply to the core-HW vote), so va_macro's clock set and the LPI
core vote failed for good and on some boots no sound card was created at all (no mic, no speaker,
silent recordings, and the modem crash-looped as a side effect). Probe the AFE with a harmless clock-off
request and defer until it is accepted (10 s bound). Verified on #182: card + both SoundWire slaves up,
no AFE errors and no modem crash on consecutive boots; Sound Recorder record/save/play through the UI.

--- a/sound/soc/qcom/qdsp6/q6afe-clocks.c
+++ b/sound/soc/qcom/qdsp6/q6afe-clocks.c
@@ -7,9 +7,11 @@
 #include <linux/clk-provider.h>
 #include <linux/module.h>
 #include <linux/device.h>
+#include <linux/delay.h>
 #include <linux/platform_device.h>
 #include "q6dsp-lpass-clocks.h"
 #include "q6afe.h"
+#include "q6core.h"
 
 #define Q6AFE_CLK(id) {					\
 		.clk_id	= id,				\
@@ -99,6 +101,39 @@
 	.lpass_unvote_clk = q6afe_unvote_lpass_core_hw,
 };
 
+/*
+ * Register the clocks only once the AFE itself answers. q6core reporting the ADSP
+ * ready is not enough: for a short while after the audio service is announced the
+ * AFE rejects commands (DSP error 0x16, or no reply to the core-HW vote), and
+ * consumers that probe right then (va_macro's clock set, the LPI core vote) fail
+ * for good - on some boots that left no sound card at all. Probe it with a
+ * harmless "clock off" request and defer until it is accepted.
+ */
+#define AFE_READY_TIMEOUT_MS	10000
+#define AFE_READY_RETRY_MS	100
+
+static int q6afe_clock_dev_probe(struct platform_device *pdev)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(AFE_READY_TIMEOUT_MS);
+	int ret;
+
+	if (!q6core_is_adsp_ready())
+		return -EPROBE_DEFER;
+
+	do {
+		ret = q6afe_set_lpass_clock(&pdev->dev, Q6AFE_LPASS_CLK_ID_TX_CORE_MCLK,
+					    LPASS_CLK_ATTRIBUTE_COUPLE_NO,
+					    Q6AFE_LPASS_CLK_ROOT_DEFAULT, 0);
+		if (!ret)
+			return q6dsp_clock_dev_probe(pdev);
+
+		msleep(AFE_READY_RETRY_MS);
+	} while (time_before(jiffies, deadline));
+
+	dev_warn(&pdev->dev, "AFE did not become ready (%d), deferring\n", ret);
+	return -EPROBE_DEFER;
+}
+
 #ifdef CONFIG_OF
 static const struct of_device_id q6afe_clock_device_id[] = {
 	{ .compatible = "qcom,q6afe-clocks", .data = &q6dsp_clk_q6afe },
@@ -112,7 +147,7 @@
 		.name = "q6afe-clock",
 		.of_match_table = of_match_ptr(q6afe_clock_device_id),
 	},
-	.probe = q6dsp_clock_dev_probe,
+	.probe = q6afe_clock_dev_probe,
 };
 module_platform_driver(q6afe_clock_platform_driver);
 
