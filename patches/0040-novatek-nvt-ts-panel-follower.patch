-	error = regulator_bulk_enable(ARRAY_SIZE(data->regulators), data->regulators);
+	/*
+	 * The vendor kernel never drives this pin (NVT_TOUCH_SUPPORT_HW_RST 0 and
+	 * pin 88 is MUX+GPIO UNCLAIMED there), so take it AS-IS and leave it
+	 * untouched - driving it high holds an active-high RESET.
+	 */
+	data->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	error = PTR_ERR_OR_ZERO(data->reset_gpio);
 	if (error) {
-		dev_err(dev, "failed to enable regulators: %d\n", error);
+		dev_err(dev, "failed to request reset GPIO: %d\n", error);
