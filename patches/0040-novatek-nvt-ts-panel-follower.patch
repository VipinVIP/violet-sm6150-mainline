+	/*
+	 * The controller hangs off the panel bias rail (LCDB) and only answers once the
+	 * panel is powered, so it must not be probed here (that would sit on the deferred
+	 * probe worker and delay the panel itself).  When the touchscreen node has a
+	 * "panel" phandle, follow the panel: initialise when it has been prepared.
+	 */
+	INIT_DELAYED_WORK(&data->init_work, nvt_ts_init_work);
+	error = devm_add_action_or_reset(dev, nvt_ts_cancel_init, data);
+	if (error)
