+	struct drm_panel_follower follower;
+	int init_tries;
 	u8 buf[NVT_TS_TOUCH_SIZE * NVT_TS_MAX_TOUCHES];
 };
 
@@ -192,13 +196,41 @@
 
 static DEFINE_SIMPLE_DEV_PM_OPS(nvt_ts_pm_ops, nvt_ts_suspend, nvt_ts_resume);
 
+static void nvt_ts_init_work(struct work_struct *work);
+
+static void nvt_ts_cancel_init(void *arg)
+{
+	struct nvt_ts_data *data = arg;
+
+	cancel_delayed_work_sync(&data->init_work);
+}
+
+static int nvt_ts_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct nvt_ts_data *data = container_of(follower, struct nvt_ts_data, follower);
+
+	if (!data->input)
+		schedule_delayed_work(&data->init_work, 0);
+
+	return 0;
+}
+
+static int nvt_ts_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs nvt_ts_follower_funcs = {
+	.panel_prepared = nvt_ts_panel_prepared,
+	.panel_unpreparing = nvt_ts_panel_unpreparing,
+};
+
 static int nvt_ts_probe(struct i2c_client *client)
 {
