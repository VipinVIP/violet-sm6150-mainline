#!/bin/sh
# violet-crashwatch - DEBUG ONLY.  Logs power/USB-C/thermal state every second and every new kernel line,
# syncing to flash so the last seconds before a hard reset survive (pstore stays empty on these resets).
# Runs as the OpenRC service violet-crashwatch (ssh-started processes die with the session).
# Output: /var/log/violet-crashwatch.log   Remove when the reset cause is found.
trap "kill 0" TERM INT
LOG=/var/log/violet-crashwatch.log
PS=/sys/class/power_supply
echo "=== start $(date '+%F %T') $(cut -d' ' -f1 /proc/uptime)s" >> "$LOG"
dmesg -w 2>/dev/null | while IFS= read -r l; do echo "K $l" >> "$LOG"; done &
rd() { cat "$1" 2>/dev/null || echo -; }
n=0
while :; do
	t=$(cut -d' ' -f1 /proc/uptime)
	b=$PS/battery
	tz=$(for z in /sys/class/thermal/thermal_zone*/temp; do printf '%s ' "$(rd $z)"; done | tr -s ' ' | awk '{m=0;for(i=1;i<=NF;i++)if($i>m)m=$i;print m}')
	echo "S up=$t cap=$(rd $b/capacity) v=$(rd $b/voltage_now) i=$(rd $b/current_now) tb=$(rd $b/temp) st=$(rd $b/status) usb=$(rd $PS/usb/online) tmax=$tz drole=$(rd /sys/class/typec/port0/data_role) prole=$(rd /sys/class/typec/port0/power_role) partner=$([ -e /sys/class/typec/port0-partner ] && echo y || echo n) udc=$(rd /sys/class/udc/*/state)" >> "$LOG"
	sync -f "$LOG" 2>/dev/null || sync
	# keep flash use bounded: one rotated copy, ~16 MB each
	n=$((n+1))
	if [ $((n % 60)) -eq 0 ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 16000000 ]; then
		mv -f "$LOG" "$LOG.1"
		echo "=== rotated $(date '+%F %T')" >> "$LOG"
	fi
	sleep 1
done
