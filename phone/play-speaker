#!/bin/sh
# play-speaker [file.wav]  -- play 48 kHz stereo S16 wav through the speaker (MultiMedia3 -> PRI_MI2S_RX -> TAS2563)
F=${1:-/home/user/Music/dandelions-10s.wav}
P=/sys/module/snd_soc_sm8250/parameters
echo 0 > $P/clk_mode 2>/dev/null; echo 0 > $P/violet_slave 2>/dev/null
A=$(amixer -c 0 controls | grep "PRI_MI2S_RX Audio Mixer MultiMedia3'" | sed "s/numid=\([0-9]*\).*/\1/")
amixer -c 0 cset numid=$A on >/dev/null
exec aplay -D hw:0,2 "$F"
